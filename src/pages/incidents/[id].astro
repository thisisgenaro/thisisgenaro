---
import BaseLayout from "../../layouts/BaseLayout.astro";
import TopologyScene from "operational-topology/astro/TopologyScene";
import { createViewportFitHexGrid } from "operational-topology";
import { getGridBounds } from "../../../node_modules/operational-topology/src/topology/hex.ts";
import { prepareTopologyRenderFrame } from "../../../node_modules/operational-topology/src/topology/renderPipeline.ts";
import { renderTopologyGridMarkup } from "../../../node_modules/operational-topology/src/topology/TopologyGridRenderer.ts";
import {
  createIncidentPresentationSlides,
  createIncidentScenePreset,
  formatIncidentDateTime,
  getIncidentById,
  getIncidentStatusTone,
  getPublishedIncidents,
} from "../../lib/incidents";

export function getStaticPaths() {
  return getPublishedIncidents().map((incident) => ({
    params: { id: incident.id },
  }));
}

const incidentId = Astro.params.id ?? "";
const incident = getIncidentById(incidentId);

if (!incident) {
  throw new Error(`Incident not found for ${incidentId}`);
}

const slides = createIncidentPresentationSlides(incident).map((slide, index) => {
  const sourceScene = incident.scenes[index];
  const inspector = sourceScene.inspector;

  return {
    id: slide.id,
    label: slide.subtitle ?? slide.title,
    title: slide.title,
    summary: slide.summary,
    status: slide.status,
    topologyLayout: slide.topologyLayout,
    sceneLayout: slide.sceneLayout,
    topology: slide.topology,
    route: slide.route,
    transition: slide.transition,
    inspectorTitle: inspector.title,
    inspectorBody: inspector.body,
    inspectorFacts: inspector.facts,
    actions: sourceScene.actions,
    highlights: sourceScene.highlights,
  };
});

const activeSlide = slides[0];
const activeScenePreset = createIncidentScenePreset(incident.scenes[0]);
const deckRadius = 32;
const initialCells = createViewportFitHexGrid({ radius: deckRadius, width: 1680, height: 1080 });
const sceneBounds = getGridBounds(initialCells, deckRadius);
const miniMapMarkup = renderTopologyGridMarkup({
  frame: prepareTopologyRenderFrame({ cells: initialCells }),
  radius: deckRadius,
  showNodes: false,
  className: "incident-deck__mini-map-grid",
  connectorRouting: activeSlide.topology.connectorRouting ?? activeScenePreset.connectorRouting,
})
  .replace('class="topology-grid incident-deck__mini-map-grid"', 'class="topology-grid incident-deck__mini-map-grid" data-topology-mini-map')
  .replaceAll('data-cell-id="', 'data-topology-mini-cell-id="')
  .replace(
    '</svg>',
    '<rect data-topology-mini-map-frame class="topology-mini-map__frame is-hidden" fill="none" /><g class="topology-mini-map__nodes" aria-hidden="true"></g></svg>',
  );
const serializedSlides = JSON.stringify(slides);
---
<BaseLayout
  title={`${incident.incidentId} | Incident Library | thisisgenaro.com`}
  description={incident.summary}
>
  <main class="incident-deck">
    <section class="incident-deck__scene-shell" data-incident-deck-shell>
      <div
        class="incident-deck__scene-frame"
        data-incident-deck-scene
        data-deck-radius={deckRadius}
        data-scene-bounds={JSON.stringify(sceneBounds)}
        data-active-slide={activeSlide.id}
      >
        <TopologyScene
          class="incident-deck__scene-view"
          nodes={activeSlide.topology.nodes}
          edges={activeSlide.topology.relationships ?? []}
          cells={initialCells}
          {...activeScenePreset}
          radius={deckRadius}
          ambientSignals={true}
          connectorRouting={activeSlide.topology.connectorRouting ?? activeScenePreset.connectorRouting}
          topologyLayout={activeSlide.topologyLayout}
          signalTransitionSpeed={0.95}
        />
      </div>

      <div class="incident-deck__scene-map surface surface-pad" data-incident-deck-map>
        <div class="incident-deck__scene-map-head">
          <div>
            <p class="incident-deck__inspector-label mono">World map</p>
            <strong data-topology-mini-map-readout>Ready</strong>
          </div>
          <span class="incident-deck__scene-map-hint mono">Camera</span>
        </div>
        <div class="incident-deck__scene-map-frame" set:html={miniMapMarkup}></div>
        <div class="incident-deck__scene-map-actions" aria-label="Camera controls">
          <button type="button" class="incident-deck__scene-map-action" data-topology-mini-map-action="zoom-out" aria-label="Zoom out">−</button>
          <button type="button" class="incident-deck__scene-map-action" data-topology-mini-map-action="fit" aria-label="Fit camera">Fit</button>
          <button type="button" class="incident-deck__scene-map-action" data-topology-mini-map-action="center" aria-label="Center on selection">Center</button>
          <button type="button" class="incident-deck__scene-map-action" data-topology-mini-map-action="zoom-in" aria-label="Zoom in">+</button>
        </div>
      </div>

      <div class="incident-deck__scene-controls" aria-label="Incident scene navigation">
        <button
          type="button"
          class="incident-deck__scene-step"
          data-incident-deck-step="previous"
          aria-label="Previous scene"
        >
          <span aria-hidden="true">←</span>
          <span>Previous</span>
        </button>

        <label class="incident-deck__scene-select-wrap">
          <span class="mono">Scene</span>
          <select class="incident-deck__scene-select" data-incident-deck-select aria-label="Select incident scene">
            {slides.map((slide) => (
              <option value={slide.id} selected={slide.id === activeSlide.id}>
                {slide.label}
              </option>
            ))}
          </select>
        </label>

        <button
          type="button"
          class="incident-deck__scene-step"
          data-incident-deck-step="next"
          aria-label="Next scene"
        >
          <span>Next</span>
          <span aria-hidden="true">→</span>
        </button>
      </div>
    </section>

    <aside class="incident-deck__inspector surface surface-pad" data-incident-deck-inspector>
      <div class="incident-deck__inspector-grid">
        <section class="incident-deck__identity">
          <p class="incident-deck__inspector-label mono">Incident identity</p>
          <h1>{incident.incidentId}</h1>
          <p class="incident-deck__identity-title">{incident.title}</p>
          <div class="incident-deck__identity-meta">
            <div>
              <span>Status</span>
              <strong class:list={["incident-status-pill", `is-${getIncidentStatusTone(incident.status)}`]}>{incident.status}</strong>
            </div>
            <div>
              <span>Created</span>
              <strong>{formatIncidentDateTime(incident.created)}</strong>
            </div>
            <div>
              <span>Closed</span>
              <strong>{incident.closed ? formatIncidentDateTime(incident.closed) : "Open"}</strong>
            </div>
            <div>
              <span>Organization</span>
              <strong>{incident.organization}</strong>
            </div>
            <div>
              <span>Requester</span>
              <strong>{incident.requester}</strong>
            </div>
            <div>
              <span>Service</span>
              <strong>{incident.service}</strong>
            </div>
          </div>
        </section>

        <section class="incident-deck__scene-note">
          <div class="incident-deck__inspector-head">
            <div>
              <p class="incident-deck__inspector-label mono" data-incident-deck-current-label>{activeSlide.label}</p>
              <h2 data-incident-inspector-title>{activeSlide.inspectorTitle}</h2>
            </div>
            <div class="incident-deck__inspector-layout mono" data-incident-inspector-layout>
              {activeSlide.sceneLayout} · {activeSlide.topologyLayout}
            </div>
          </div>

          <p class="incident-deck__inspector-body" data-incident-inspector-body>{activeSlide.inspectorBody}</p>

          <div class="incident-deck__facts" data-incident-inspector-facts>
            {activeSlide.inspectorFacts.map((fact) => <p>{fact}</p>)}
          </div>

          <ul class="incident-deck__highlights" data-incident-inspector-highlights hidden={!activeSlide.highlights.length}>
            {activeSlide.highlights.map((highlight) => <li>{highlight}</li>)}
          </ul>

          <div class="incident-deck__actions" data-incident-inspector-actions>
            {activeSlide.actions.map((action) => (
              <a href={`#${action.target}`}>{action.label} →</a>
            ))}
          </div>
        </section>
      </div>
    </aside>

    <script type="application/json" data-incident-deck-slides set:html={serializedSlides}></script>
    <script>
      import { createViewportFitHexGrid } from "operational-topology";
      import { createTopologyDatasetTransition } from "operational-topology/browser";
      import { createSceneNavigationController } from "../../../node_modules/operational-topology/src/topology/sceneNavigationController.ts";

      const shell = document.querySelector("[data-incident-deck-shell]");
      const sceneHost = document.querySelector("[data-incident-deck-scene]");
      const slidesPayload = document.querySelector("[data-incident-deck-slides]");
      const currentLabel = document.querySelector("[data-incident-deck-current-label]");
      const inspectorTitle = document.querySelector("[data-incident-inspector-title]");
      const inspectorBody = document.querySelector("[data-incident-inspector-body]");
      const inspectorLayout = document.querySelector("[data-incident-inspector-layout]");
      const inspectorFacts = document.querySelector("[data-incident-inspector-facts]");
      const inspectorHighlights = document.querySelector("[data-incident-inspector-highlights]");
      const inspectorActions = document.querySelector("[data-incident-inspector-actions]");
      const select = document.querySelector("[data-incident-deck-select]");
      const prevButton = document.querySelector('[data-incident-deck-step="previous"]');
      const nextButton = document.querySelector('[data-incident-deck-step="next"]');
      const sceneSvg = sceneHost?.querySelector(".topology-grid");
      const deckRadius = Number(sceneHost?.getAttribute("data-deck-radius") ?? 36);
      const sceneBounds = JSON.parse(sceneHost?.getAttribute("data-scene-bounds") ?? "{}");
      const slides = slidesPayload ? JSON.parse(slidesPayload.textContent || "[]") : [];

      if (shell && sceneHost && sceneSvg && slides.length) {
        let activeSlide = slides[0];
        let transition = null;
        const activeNodeId = activeSlide.topology.nodes.find((node) => node.selected || node.active)?.id ?? activeSlide.topology.nodes[0]?.id ?? "";
        const navigation = createSceneNavigationController({
          shell,
          scene: sceneHost,
          nodes: activeSlide.topology.nodes,
          worldRadius: deckRadius,
          worldBounds: sceneBounds,
          zoomStep: 0.08,
          transitionDuration: 260,
          selectedId: activeNodeId,
          fitOnInit: true,
          interactiveMiniMap: true,
          enableSceneGestures: true,
          enableSceneWheel: true,
          resizeTargets: [shell, sceneHost],
        });

        const updateInspector = (slide) => {
          if (currentLabel) currentLabel.textContent = slide.label;
          if (inspectorTitle) inspectorTitle.textContent = slide.inspectorTitle;
          if (inspectorBody) inspectorBody.textContent = slide.inspectorBody;
          if (inspectorLayout) inspectorLayout.textContent = `${slide.sceneLayout} · ${slide.topologyLayout}`;

          if (inspectorFacts) {
            inspectorFacts.replaceChildren(
              ...slide.inspectorFacts.map((fact) => {
                const p = document.createElement("p");
                p.textContent = fact;
                return p;
              }),
            );
          }

          if (inspectorHighlights) {
            inspectorHighlights.hidden = !(slide.highlights && slide.highlights.length);
            inspectorHighlights.replaceChildren(
              ...(slide.highlights ?? []).map((highlight) => {
                const li = document.createElement("li");
                li.textContent = highlight;
                return li;
              }),
            );
          }

          if (inspectorActions) {
            inspectorActions.replaceChildren(
              ...slide.actions.map((action) => {
                const link = document.createElement("a");
                link.href = `#${action.target}`;
                link.textContent = `${action.label} →`;
                return link;
              }),
            );
          }

          if (select) {
            select.value = slide.id;
          }
        };

        const updateButtons = () => {
          const index = slides.findIndex((slide) => slide.id === activeSlide.id);
          if (prevButton) prevButton.dataset.target = slides[(index - 1 + slides.length) % slides.length].id;
          if (nextButton) nextButton.dataset.target = slides[(index + 1) % slides.length].id;
        };

        const buildCells = () => {
          const rect = sceneHost.getBoundingClientRect();
          return createViewportFitHexGrid({
            radius: deckRadius,
            width: Math.max(1, Math.round((rect.width || shell.getBoundingClientRect().width || 1280) * 1.6)),
            height: Math.max(1, Math.round((rect.height || 760) * 1.6)),
          });
        };

        const rebuildTransition = () => {
          transition?.destroy?.();
          transition = createTopologyDatasetTransition({
            sceneGrid: sceneSvg,
            cells: buildCells(),
            radius: deckRadius,
            connectorRouting: activeSlide.topology.connectorRouting ?? "obstacle-aware",
          });
        };

        const moveToSlide = async (slideId) => {
          const nextSlide = slides.find((slide) => slide.id === slideId);
          if (!nextSlide || nextSlide.id === activeSlide.id) return;

          activeSlide = nextSlide;
          const nextFocusId = nextSlide.topology.nodes.find((node) => node.selected || node.active)?.id ?? nextSlide.topology.nodes[0]?.id ?? "";
          navigation.setTopology(nextSlide.topology.nodes, sceneBounds);
          if (nextFocusId) {
            navigation.select(nextFocusId);
            navigation.ensureVisible(nextFocusId, true);
          }
          rebuildTransition();
          updateInspector(nextSlide);
          updateButtons();
          await Promise.resolve(transition.transition(nextSlide.topology));
        };

        prevButton?.addEventListener("click", () => {
          const index = slides.findIndex((slide) => slide.id === activeSlide.id);
          moveToSlide(slides[(index - 1 + slides.length) % slides.length].id);
        });

        nextButton?.addEventListener("click", () => {
          const index = slides.findIndex((slide) => slide.id === activeSlide.id);
          moveToSlide(slides[(index + 1) % slides.length].id);
        });

        const handleSelect = (event) => {
          const target = event.currentTarget?.value;
          if (target) moveToSlide(target);
        };

        select?.addEventListener("input", handleSelect);
        select?.addEventListener("change", handleSelect);

        const resizeObserver = new ResizeObserver(() => {
          rebuildTransition();
          Promise.resolve(transition.transition(activeSlide.topology));
        });

        sceneHost.addEventListener("topology-node-selected", (event) => {
          const detail = event.detail;
          const nodeId = detail?.nodeId;
          if (!nodeId) return;
          navigation.select(nodeId);
          navigation.ensureVisible(nodeId, true);
        });

        navigation.setTopology(activeSlide.topology.nodes, sceneBounds);
        if (activeNodeId) {
          navigation.select(activeNodeId);
        }

        rebuildTransition();
        updateInspector(activeSlide);
        updateButtons();
        Promise.resolve(transition.transition(activeSlide.topology));
        resizeObserver.observe(sceneHost);

        window.addEventListener(
          "pagehide",
          () => {
            resizeObserver.disconnect();
            transition?.destroy?.();
            navigation.destroy();
          },
          { once: true },
        );
      }
    </script>
  </main>
</BaseLayout>

<style>
  .incident-deck {
    width: min(100%, 86rem);
    margin: 0 auto;
    padding: clamp(1rem, 3vw, 2.25rem);
    display: grid;
    gap: clamp(1rem, 2.25vw, 1.5rem);
  }

  .incident-deck__scene-shell {
    position: relative;
    min-height: calc(100dvh - 14rem);
    border: 0;
    background: transparent;
  }

  .incident-deck__scene-frame {
    position: relative;
    height: min(90dvh, 64rem);
    min-height: 38rem;
    overflow: hidden;
    background: transparent;
  }

  .incident-deck__scene-view {
    width: 100%;
    height: 100%;
    min-height: 100%;
  }

  .incident-deck__scene-map {
    position: absolute;
    top: 1rem;
    right: 1rem;
    z-index: 3;
    width: min(18.5rem, 24vw);
    display: grid;
    gap: 0.75rem;
    border: 1px solid color-mix(in srgb, var(--line-strong) 72%, transparent);
    background: color-mix(in srgb, var(--surface-raised) 84%, transparent);
    box-shadow: 0 20px 42px rgba(0, 0, 0, 0.26);
  }

  .incident-deck__scene-map-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .incident-deck__scene-map-head strong {
    display: block;
    color: var(--text);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .incident-deck__scene-map-hint {
    align-self: start;
    opacity: 0.7;
  }

  .incident-deck__scene-map-frame {
    overflow: hidden;
    border: 1px solid color-mix(in srgb, var(--line-strong) 56%, transparent);
    background: color-mix(in srgb, var(--surface) 72%, transparent);
  }

  .incident-deck__scene-map-frame :global(.topology-grid) {
    width: 100%;
    height: auto;
  }

  .incident-deck__scene-map-actions {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 0.45rem;
  }

  .incident-deck__scene-map-action {
    min-height: 2.25rem;
    border: 1px solid color-mix(in srgb, var(--line-strong) 72%, transparent);
    background: color-mix(in srgb, var(--surface) 76%, transparent);
    color: var(--text);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .incident-deck__scene-controls {
    position: absolute;
    left: 0;
    bottom: 0;
    z-index: 2;
    display: grid;
    grid-template-columns: auto minmax(10rem, 14rem) auto;
    gap: 0.5rem;
    align-items: end;
    width: fit-content;
    max-width: 100%;
    padding: 0.35rem 0 0 0;
  }

  .incident-deck__scene-step,
  .incident-deck__scene-select {
    min-height: 2.8rem;
    border: 1px solid color-mix(in srgb, var(--line-strong) 72%, transparent);
    background: color-mix(in srgb, var(--surface-raised) 78%, transparent);
    color: var(--text);
  }

  .incident-deck__scene-step {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.45rem;
    padding: 0.65rem 0.95rem;
    cursor: pointer;
  }

  .incident-deck__scene-step span {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .incident-deck__scene-select-wrap {
    min-width: 0;
    display: grid;
    gap: 0.35rem;
  }

  .incident-deck__scene-select-wrap .mono {
    font-family: var(--font-mono);
    color: var(--accent);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .incident-deck__scene-select {
    width: 100%;
    padding: 0.68rem 0.85rem;
  }

  .incident-deck__inspector {
    display: grid;
    gap: 0.95rem;
  }

  .incident-deck__inspector-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    gap: 1rem;
    align-items: start;
  }

  .incident-deck__identity,
  .incident-deck__scene-note {
    display: grid;
    gap: 0.8rem;
  }

  .incident-deck__identity h1 {
    margin: 0;
    font-size: clamp(1.8rem, 3.5vw, 2.8rem);
    line-height: 1;
    letter-spacing: -0.05em;
  }

  .incident-deck__identity-title {
    margin: 0;
    color: var(--muted);
    line-height: 1.65;
  }

  .incident-deck__inspector-label,
  .incident-deck__inspector-layout,
  .incident-deck__identity-meta span,
  .incident-deck__identity-meta strong {
    font-family: var(--font-mono);
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .incident-deck__inspector-label,
  .incident-deck__inspector-layout {
    color: var(--accent);
    font-size: 0.72rem;
    font-weight: 700;
  }

  .incident-status-pill {
    display: inline-flex;
    align-items: center;
    min-height: 2rem;
    padding: 0.2rem 0.65rem;
    border: 1px solid color-mix(in srgb, var(--accent) 42%, transparent);
    color: var(--accent);
    background: color-mix(in srgb, var(--accent-soft) 38%, transparent);
    white-space: nowrap;
  }

  .incident-status-pill.is-resolved,
  .incident-status-pill.is-identified {
    color: var(--text);
    border-color: color-mix(in srgb, var(--line-strong) 72%, transparent);
    background: color-mix(in srgb, var(--surface-raised) 74%, transparent);
  }

  .incident-status-pill.is-watching {
    color: #f4c152;
  }

  .incident-deck__identity-meta {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.8rem 1rem;
  }

  .incident-deck__identity-meta > div,
  .incident-deck__facts,
  .incident-deck__actions {
    display: grid;
    gap: 0.35rem;
  }

  .incident-deck__identity-meta span {
    color: var(--muted-dim);
    font-size: 0.66rem;
  }

  .incident-deck__identity-meta strong {
    color: var(--text);
    font-size: 0.66rem;
    font-weight: 500;
    letter-spacing: 0.02em;
    text-transform: none;
  }

  .incident-deck__inspector-body {
    margin: 0;
    color: var(--text);
    line-height: 1.72;
  }

  .incident-deck__facts p,
  .incident-deck__highlights {
    margin: 0;
  }

  .incident-deck__facts p {
    color: var(--muted);
    line-height: 1.55;
  }

  .incident-deck__highlights {
    display: grid;
    gap: 0.5rem;
    padding: 0;
    list-style: none;
  }

  .incident-deck__highlights li {
    padding: 0.8rem 0.95rem;
    border: 1px solid color-mix(in srgb, var(--line-strong) 72%, transparent);
    background: color-mix(in srgb, var(--surface-raised) 64%, transparent);
  }

  .incident-deck__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .incident-deck__actions a {
    color: var(--accent);
    text-decoration: none;
  }

  @media (max-width: 980px) {
    .incident-deck__scene-shell {
      min-height: auto;
    }

    .incident-deck__scene-frame {
      height: min(72dvh, 46rem);
      min-height: 24rem;
    }

    .incident-deck__scene-map {
      position: static;
      width: 100%;
      max-width: none;
      margin-top: 0.9rem;
    }

    .incident-deck__scene-controls {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      grid-template-areas:
        "select select"
        "previous next";
      width: min(100%, 20rem);
      gap: 0.45rem;
    }

    .incident-deck__scene-select-wrap {
      grid-area: select;
    }

    .incident-deck__scene-step[data-incident-deck-step="previous"] {
      grid-area: previous;
    }

    .incident-deck__scene-step[data-incident-deck-step="next"] {
      grid-area: next;
    }

    .incident-deck__inspector-grid {
      grid-template-columns: 1fr;
      display: grid;
    }
  }

  @media (max-width: 720px) {
    .incident-deck {
      padding: 1rem;
    }

    .incident-deck__identity-meta {
      grid-template-columns: 1fr;
    }

    .incident-deck__scene-step,
    .incident-deck__scene-select {
      width: 100%;
    }

    .incident-deck__scene-step {
      min-height: 2.5rem;
      padding-inline: 0.75rem;
    }

    .incident-deck__scene-select {
