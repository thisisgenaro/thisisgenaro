---
import IncidentDeck from "../../components/IncidentDeck.astro";
import { getIncidentById, getPublishedIncidents } from "../../lib/incidents";

export function getStaticPaths() {
  return getPublishedIncidents().map((incident) => ({
    params: { id: incident.id },
  }));
}

const incidentId = Astro.params.id ?? "";
const incident = getIncidentById(incidentId);

if (!incident) {
  throw new Error(`Incident not found for ${incidentId}`);
}
---
<IncidentDeck incident={incident} locale="en" />
