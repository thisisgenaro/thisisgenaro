---
import { getCollection } from "astro:content";
import JournalEntry from "../../../components/JournalEntry.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { getLocaleFromPath, type Locale, ui } from "../../../lib/i18n";
import { createJournalEntryRecord } from "../../../lib/journal";
import { render } from "astro:content";

export async function getStaticPaths() {
  const entries = await getCollection("entries", ({ data }) => data.language === "en");
  return entries.flatMap((entry) => {
    const slug = entry.id.split("/").slice(1).join("/").replace(/\.mdx?$/, "");
    return ["en", "es"].map((locale) => ({ params: { locale, slug }, props: { slug } }));
  });
}

const locale = getLocaleFromPath(`/${Astro.params.locale}`) as Locale;
const strings = ui[locale];
const slug = Astro.params.slug ?? "";
const entries = await getCollection("entries", ({ data }) => data.language === locale);
const entry = entries.find((candidate) => candidate.id.split("/").slice(1).join("/").replace(/\.mdx?$/, "") === slug);
---
{entry ? <JournalEntry locale={locale} entry={entry} record={createJournalEntryRecord(entry)} Content={(await render(entry)).Content} /> : <BaseLayout locale={locale} title={strings.nav.journal} description={strings.labels.unavailable}><p>{strings.labels.unavailable}</p></BaseLayout>}
