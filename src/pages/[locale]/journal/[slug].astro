---
import { getCollection } from "astro:content";
import { SUPPORTED_LOCALES } from "../../../lib/i18n";
import { getJournalEntriesForLanguage, getJournalEntrySlug, getPublishedJournalEntries } from "../../../lib/journal";

export async function getStaticPaths() {
  const entries = await getCollection("entries");
  return SUPPORTED_LOCALES.flatMap((locale) =>
    getPublishedJournalEntries(getJournalEntriesForLanguage(entries, locale)).map((entry) => ({
      params: { locale, slug: getJournalEntrySlug(entry) },
      props: { destination: "/" + locale + "/journal/entries/" + getJournalEntrySlug(entry) },
    })),
  );
}

const { destination } = Astro.props as { destination: string };
return Astro.redirect(destination, 301);
---
