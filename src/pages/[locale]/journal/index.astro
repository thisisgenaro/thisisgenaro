---
import { getCollection } from "astro:content";
import JournalIndex from "../../../components/JournalIndex.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { getLocaleFromPath, type Locale, ui } from "../../../lib/i18n";
import { createJournalEntryRecords } from "../../../lib/journal";

export function getStaticPaths() { return ["en", "es"].map((locale) => ({ params: { locale } })); }
const locale = getLocaleFromPath(`/${Astro.params.locale}`) as Locale;
const strings = ui[locale];
const entries = await getCollection("entries", ({ data }) => data.language === locale);
const records = createJournalEntryRecords(entries);
---
<JournalIndex locale={locale} entries={entries} />
