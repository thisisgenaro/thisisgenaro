---
import { getCollection } from "astro:content";
import LocalizedPage from "../../../components/LocalizedPage.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { getLocaleFromPath, type Locale, ui } from "../../../lib/i18n";

export async function getStaticPaths() {
  const organizations = await getCollection("organizations", ({ data }) => data.language === "en");
  return organizations.flatMap(({ data }) => ["en", "es"].map((locale) => ({ params: { locale, id: data.id } })));
}

const locale = getLocaleFromPath(`/${Astro.params.locale}`) as Locale;
const strings = ui[locale];
const organizations = await getCollection("organizations", ({ data }) => data.language === locale);
const organization = organizations.find(({ data }) => data.id === Astro.params.id);
---
<BaseLayout locale={locale} title={`${organization?.data.name ?? strings.nav.world} | ${strings.nav.world}`} description={organization?.data.summary ?? strings.labels.unavailable}>
  {organization ? <LocalizedPage locale={locale} kind="world" organizations={[{ id: organization.data.id, acronym: organization.data.acronym, name: organization.data.name, industry: organization.data.industry, summary: organization.data.summary, logo: organization.data.logo }]} /> : <LocalizedPage locale={locale} kind="unavailable" />}
</BaseLayout>
