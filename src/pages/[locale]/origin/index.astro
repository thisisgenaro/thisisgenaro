---
import OriginSubsite from "../../../components/OriginSubsite.astro";
import { getLocaleFromPath, SUPPORTED_LOCALES, type Locale } from "../../../lib/i18n";

export function getStaticPaths() {
  return SUPPORTED_LOCALES.map((locale) => ({ params: { locale } }));
}

const locale = getLocaleFromPath(`/${Astro.params.locale}`) as Locale;
---

<OriginSubsite locale={locale} />
