---
import ContactPage from "../../../components/ContactPage.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { getLocaleFromPath, type Locale, ui } from "../../../lib/i18n";

export function getStaticPaths() { return ["en", "es"].map((locale) => ({ params: { locale } })); }
const locale = getLocaleFromPath(`/${Astro.params.locale}`) as Locale;
const strings = ui[locale];
---

<BaseLayout locale={locale} title={`${strings.nav.contact} | Genaro Hernández`} description={strings.pages.contactDescription}>
  <ContactPage locale={locale} />
</BaseLayout>
