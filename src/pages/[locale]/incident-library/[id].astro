---
import IncidentDeck from "../../../components/IncidentDeck.astro";
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { getLocaleFromPath, type Locale, ui } from "../../../lib/i18n";
import { getLocalizedIncidentById, getPublishedIncidents } from "../../../lib/incidents";

export function getStaticPaths() {
  return ["en", "es"].flatMap((locale) => getPublishedIncidents().map((incident) => ({ params: { locale, id: incident.id } })));
}

const locale = getLocaleFromPath(`/${Astro.params.locale}`) as Locale;
const strings = ui[locale];
const incident = getLocalizedIncidentById(Astro.params.id ?? "", locale);
---
{incident ? <IncidentDeck locale={locale} incident={incident} /> : <BaseLayout locale={locale} title={strings.nav.incidents} description={strings.labels.unavailable}><p>{strings.labels.unavailable}</p></BaseLayout>}
