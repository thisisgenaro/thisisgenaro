---
import BaseLayout from "../layouts/BaseLayout.astro";
import TopologyScene from "operational-topology/astro/TopologyScene";
import { createTopologyScenePreset } from "operational-topology/presets";
import { getGhLogoFrame } from "operational-topology/labs";

const dormantScene = createTopologyScenePreset({
  layout: "viewport-fit",
  topologyLayout: "ring",
  showGridNodes: false,
  gridActivity: true,
  ambientSignals: false,
});

const introLogoNode = [
  {
    id: "intro-logo",
    label: "GH",
    image: "/gh-logo.png",
    imageScale: 0.82,
    imageAlign: "center",
    q: 0,
    r: 0,
    variant: "root",
    size: "root",
    active: true,
    selected: true,
  },
];

const introStorageKey = "thisisgenaro:homepage-intro-seen";
const introBootstrap =
  "(() => {" +
  "const root=document.documentElement;" +
  "const key=" + JSON.stringify(introStorageKey) + ";" +
  "try {" +
  "const seen=localStorage.getItem(key)==='true';" +
  "const reduced=matchMedia('(prefers-reduced-motion: reduce)').matches;" +
  "root.dataset.homeIntroState=seen||reduced?'done':'ready';" +
  "} catch {root.dataset.homeIntroState='ready';}" +
  "})();";

const latestJournal = {
  id: "JRNL-001",
  title: "Keeping the operating model readable",
  date: "2026-08-13",
  excerpt:
    "A practical site works better when structure stays visible without making the page feel like a dashboard demo.",
  href: "/journal",
};

const latestIncident = {
  id: "INC-0027",
  title: "Signal route failure",
  date: "2026-08-11",
  summary:
    "A topology route lost clarity during a transition and needed a bounded camera frame to remain legible.",
  status: "INVESTIGATING",
  href: "/incidents",
};

---

<script is:inline slot="head" set:html={introBootstrap}></script>

<BaseLayout
  title="thisisgenaro.com | Genaro Hernandez"
  description="Genaro Hernandez builds resilient infrastructure, writes about the work, and documents incidents with clarity."
>
  <main class="home">
    <div class="home__world" aria-hidden="true">
      <TopologyScene
        class="home__world-scene"
        nodes={introLogoNode}
        edges={[]}
        {...dormantScene}
        signalTransitionSpeed={0.9}
      />
      <div class="home__world-vignette"></div>
    </div>

    <div class="home__intro" data-home-intro data-home-intro-state="ready">
      <button
        class="home__intro-trigger"
        type="button"
        data-home-intro-trigger
        aria-label="Open the site"
        aria-describedby="home-intro-caption"
      >
        <span class="home__intro-node" aria-hidden="true">
          <span class="home__intro-node-core"></span>
          <span class="home__intro-node-label">GH</span>
        </span>
        <span class="home__intro-caption" id="home-intro-caption">Tap to begin</span>
      </button>
    </div>

    <section class="home__hero">
      <article class="home__lead" aria-labelledby="home-lead-title">
        <div class="home__hero-meta">
          <p class="home__hero-name">Genaro Hernandez</p>
          <p class="home__hero-role">IT Infrastructure &amp; Cloud Specialist</p>
        </div>
        <h1 class="home__headline" id="home-lead-title">
          <span>Design</span>
          <span>Automate</span>
          <span class="home__headline-accent">Keep things running.</span>
        </h1>
        <p class="home__lede">
          I help organizations build resilient infrastructure, gain visibility across their systems and resolve the incidents that matter.
        </p>
        <div class="home__lead-actions button-row">
          <a class="button primary" href="/journal">Journal</a>
          <a class="button" href="/about/cv">CV</a>
        </div>
      </article>
    </section>

    <section class="home__content">
      <aside class="home__inspector surface surface-pad" aria-labelledby="inspector-title">
        <div class="section-label">
          <h2 id="inspector-title">Knowledge System</h2>
        </div>
        <p class="home__inspector-body">
          Organizations, incidents, entries, and lessons stay connected through one persistent world.
        </p>
        <div class="chip-row">
          <span class="chip">Shared world</span>
          <span class="chip">Clear signals</span>
          <span class="chip">Editorial content</span>
          <span class="chip">Reusable scenes</span>
        </div>
      </aside>

      <article class="home__card surface surface-pad home__card--journal">
        <p class="home__card-label">Latest Journal</p>
        <p class="home__card-id mono">{latestJournal.id}</p>
        <h3>{latestJournal.title}</h3>
        <p class="home__card-date">{latestJournal.date}</p>
        <p class="home__card-body">{latestJournal.excerpt}</p>
        <a class="home__card-link" href={latestJournal.href}>Read journal</a>
      </article>

      <article class="home__card surface surface-pad home__card--incident">
        <p class="home__card-label">Latest Incident</p>
        <p class="home__card-id mono">{latestIncident.id}</p>
        <h3>{latestIncident.title}</h3>
        <div class="home__status-row">
          <p class="home__card-date">{latestIncident.date}</p>
          <span class="home__status-pill">{latestIncident.status}</span>
        </div>
        <p class="home__card-body">{latestIncident.summary}</p>
        <a class="home__card-link" href={latestIncident.href}>Open incident</a>
      </article>
    </section>
  </main>
</BaseLayout>

<style>
  .home {
    position: relative;
    display: grid;
    align-content: center;
    gap: clamp(0.75rem, 2vw, 1.15rem);
    min-height: 100svh;
    width: 100%;
    padding: clamp(1rem, 4vh, 2.4rem) 0;
  }

  .home__world {
    position: fixed;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    opacity: 0.18;
    filter: saturate(0.85);
  }

  .home__world::before,
  .home__world::after {
    content: "";
    position: fixed;
    left: 50%;
    top: 50%;
    width: 7rem;
    height: 7rem;
    translate: -50% -50%;
    border-radius: 50%;
    border: 1px solid color-mix(in srgb, var(--accent) 38%, transparent);
    opacity: 0;
    pointer-events: none;
  }

  .home__world::after {
    width: 5.25rem;
    height: 5.25rem;
    border-color: color-mix(in srgb, var(--accent) 20%, transparent);
  }

  html[data-home-intro-state="signal"] .home__world::before {
    animation: home-origin-burst 720ms ease-out forwards;
  }

  html[data-home-intro-state="signal"] .home__world::after {
    animation: home-origin-burst 720ms ease-out 80ms forwards;
  }

  .home__world [data-node-id="intro-logo"] {
    opacity: 1;
    transition: opacity 240ms ease, transform 240ms ease;
  }

  html[data-home-intro-state="signal"] .home__world [data-node-id="intro-logo"],
  html[data-home-intro-state="logo"] .home__world [data-node-id="intro-logo"],
  html[data-home-intro-state="done"] .home__world [data-node-id="intro-logo"] {
    opacity: 0;
  }

  .home__world-scene {
    position: absolute;
    inset: 0;
  }

  .home__world-vignette {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(circle at 50% 20%, rgba(242, 169, 0, 0.06), transparent 22%),
      linear-gradient(180deg, rgba(1, 4, 6, 0.08), rgba(1, 4, 6, 0.55));
  }

  .home__intro {
    position: fixed;
    inset: 0;
    z-index: 5;
    display: grid;
    place-items: center;
    padding: clamp(1rem, 4vw, 2rem);
    background:
      radial-gradient(circle at 50% 42%, rgba(242, 169, 0, 0.04), transparent 24%),
      linear-gradient(180deg, rgba(2, 5, 8, 0.72), rgba(2, 5, 8, 0.56));
    opacity: 1;
    transition: opacity 340ms ease, transform 340ms ease;
    pointer-events: auto;
  }

  .home__intro[data-home-intro-state="signal"] {
    background:
      radial-gradient(circle at 50% 42%, rgba(242, 169, 0, 0.06), transparent 24%),
      linear-gradient(180deg, rgba(2, 5, 8, 0.72), rgba(2, 5, 8, 0.56));
  }

  .home__intro[data-home-intro-state="signal"],
  .home__intro[data-home-intro-state="logo"],
  .home__intro[data-home-intro-state="done"] {
    opacity: 0;
    pointer-events: none;
  }

  .home__intro-trigger {
    position: relative;
    z-index: 1;
    display: grid;
    place-items: center;
    width: min(100%, 28rem);
    min-height: clamp(5rem, 12svh, 7rem);
    padding: 0.5rem 1.25rem;
    border: 0;
    background: transparent;
    color: inherit;
    cursor: pointer;
    touch-action: manipulation;
    isolation: isolate;
  }


  .home__intro-caption {
    position: relative;
    z-index: 1;
    color: var(--text);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-align: center;
    text-transform: uppercase;
  }

  .home__hero,
  .home__content {
    width: min(100%, 78rem);
    margin: 0 auto;
  }

  .home__hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    min-height: clamp(24rem, 58svh, 40rem);
    align-content: center;
    margin-bottom: 0.75rem;
  }

  .home__content {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 1fr) minmax(0, 1fr);
    gap: 0.85rem;
    align-items: start;
  }

  .home__lead {
    padding-inline: 0;
    padding-block: 0.2rem 0;
    border: 0;
    border-radius: 0;
    background: transparent;
    box-shadow: none;
    gap: 1.35rem;
    min-height: 26rem;
    padding-block: 0.9rem 0.35rem;
  }

  .home__hero-meta {
    display: grid;
    gap: 0.3rem;
  }

  .home__hero-name {
    margin: 0;
    color: var(--text);
    font-family: var(--font-title);
    font-size: clamp(1.35rem, 2vw, 1.8rem);
    letter-spacing: -0.03em;
    line-height: 1.02;
  }

  .home__hero-role {
    margin: 0;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .home__headline {
    margin: 0;
    display: grid;
    gap: 0.04em;
    font-size: clamp(3rem, 6.7vw, 6.2rem);
    line-height: 0.9;
    letter-spacing: -0.06em;
  }

  .home__headline-accent {
    color: var(--accent);
  }

  .home__lede {
    max-width: 32rem;
    margin: 0;
    color: var(--text);
    font-size: clamp(1.02rem, 1.55vw, 1.18rem);
    line-height: 1.65;
  }

  .home__lead-actions {
    margin-top: 0.55rem;
  }

  .home__inspector {
    display: grid;
    gap: 0.8rem;
  }

  .home__inspector-kicker {
    margin: 0;
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    display: inline-flex;
    align-items: center;
    min-height: 2.4rem;
    padding: 0.45rem 0.8rem;
    border: 1px solid transparent;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.02);
    transition: border-color 180ms ease, background 180ms ease, transform 180ms ease;
  }

  .home__inspector-body {
    margin: 0;
    color: var(--muted);
    line-height: 1.6;
  }

  .home__card {
    display: grid;
    gap: 0.5rem;
    align-content: start;
  }

  .home__lead:hover,
  .home__lead:focus-within {
    transform: none;
    box-shadow: none;
  }

  html[data-home-intro-state="ready"] .home__hero,
  html[data-home-intro-state="signal"] .home__hero,
  html[data-home-intro-state="logo"] .home__hero,
  html[data-home-intro-state="ready"] .home__content,
  html[data-home-intro-state="signal"] .home__content,
  html[data-home-intro-state="logo"] .home__content {
    opacity: 0;
    pointer-events: none;
    transform: translateY(0.4rem);
  }

  .home__hero,
  .home__content {
    transition: opacity 240ms ease, transform 240ms ease;
  }

  .home__card-label,
  .home__card-id,
  .home__card-date {
    margin: 0;
    color: var(--muted);
  }

  .home__card-label {
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .home__card h3 {
    margin: 0;
    font-size: 1.08rem;
  }

  .home__card-body {
    margin: 0;
    max-width: 28ch;
    color: var(--muted);
    line-height: 1.65;
  }

  .home__card-link {
    margin-top: 0.25rem;
    color: var(--text);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    display: inline-flex;
    align-items: center;
    min-height: 2.4rem;
    padding: 0.45rem 0.8rem;
    border: 1px solid transparent;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.02);
    transition: border-color 180ms ease, background 180ms ease, transform 180ms ease, box-shadow 180ms ease;
  }

  .home__status-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .home__card--journal,
  .home__card--incident {
    min-height: 100%;
    position: relative;
  }

  .home__card--journal::before,
  .home__card--incident::before {
    content: "";
    position: absolute;
    inset: 0 auto auto 0;
    width: 100%;
    height: 2px;
    opacity: 0.9;
  }

  .home__card--journal::before {
    background: linear-gradient(90deg, color-mix(in srgb, var(--accent) 70%, transparent), transparent);
  }

  .home__card--incident::before {
    background: linear-gradient(90deg, color-mix(in srgb, var(--blue) 72%, transparent), transparent);
  }

  .home__status-pill {
    display: inline-flex;
    align-items: center;
    min-height: 1.8rem;
    padding: 0.35rem 0.7rem;
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, var(--accent) 35%, transparent);
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    background: color-mix(in srgb, var(--accent-soft) 60%, transparent);
  }

  @keyframes home-origin-burst {
    0% {
      opacity: 0;
      transform: scale(0.18);
    }
    20% {
      opacity: 0.88;
    }
    100% {
      opacity: 0;
      transform: scale(1.62);
    }
  }

  @media (max-width: 980px) {
    .home__content {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 680px) {
    .home {
      width: 100%;
      min-height: auto;
      padding-top: 0.95rem;
      padding-bottom: 1rem;
    }

    .home__hero,
    .home__content {
      width: 100%;
    }

    .home__hero {
      min-height: 0;
      margin-top: 0.25rem;
      margin-bottom: 0.95rem;
    }

    .home__lead {
      gap: 0.9rem;
      min-height: 18rem;
    }

    .home__hero-meta {
      gap: 0.1rem;
    }

    .home__hero-name {
      font-size: clamp(1.2rem, 7vw, 1.55rem);
    }

    .home__hero-role {
      font-size: 0.7rem;
    }

    .home__content {
      gap: 0.8rem;
    }

    .home__card {
      gap: 0.45rem;
    }

    .home__card-label {
      font-size: 0.66rem;
    }

    .home__card h3 {
      font-size: 1rem;
    }

    .home__card-body {
      max-width: none;
      font-size: 0.96rem;
    }

    .home__status-row {
      align-items: flex-start;
      flex-direction: column;
      gap: 0.55rem;
    }

    .home__headline {
      font-size: clamp(2.55rem, 15vw, 4.1rem);
      line-height: 0.94;
    }

    .home__lead-actions {
      margin-top: 0.5rem;
    }

    .home__lede {
      max-width: none;
      font-size: 1rem;
      line-height: 1.65;
    }

    .home__intro {
      padding: 0.75rem;
    }

    .home__intro-trigger {
      width: min(100%, 18rem);
      min-height: 14rem;
      padding: 0.75rem;
    }

    .home__intro-node {
      width: 8rem;
    }

    .home__intro-trigger::before {
      width: 7rem;
      height: 7rem;
    }

    .home__intro-trigger::after {
      width: 5rem;
      height: 5rem;
    }
  }
</style>

<script>
  import { getGhLogoFrame } from "operational-topology/labs";

  const root = document.documentElement;
  const introRoot = document.querySelector("[data-home-intro]");
  const introTrigger = introRoot?.querySelector("[data-home-intro-trigger]");
  const logoSceneRoot = document.querySelector("[data-home-logo-animation]");
  const introStorageKey = "thisisgenaro:homepage-intro-seen";

  const stateClasses = ["is-origin", "is-propagating", "is-receiving", "is-resolved"];
  const logoCellCache = new Map();

  let introAnimating = false;
  let introSeen = root.dataset.homeIntroState === "done";
  let logoFrameRaf = 0;
  let logoCleanupTimer = 0;

  const syncState = (state) => {
    root.dataset.homeIntroState = state;
    if (introRoot) {
      introRoot.dataset.homeIntroState = state;
    }
  };

  const readSeen = () => {
    try {
      return localStorage.getItem(introStorageKey) === "true";
    } catch {
      return introSeen;
    }
  };

  const storeSeen = () => {
    try {
      localStorage.setItem(introStorageKey, "true");
    } catch {
      // Ignore persistence failures.
    }
  };

  const getLogoCells = () => {
    if (logoCellCache.size > 0) {
      return Array.from(logoCellCache.keys()).map((id) => {
        const element = logoCellCache.get(id)?.[0];
        const q = Number(element?.getAttribute("data-q") ?? "0");
        const r = Number(element?.getAttribute("data-r") ?? "0");
        return { id, q, r, center: { x: 0, y: 0 }, path: "" };
      });
    }

    const elements = Array.from(worldSceneRoot?.querySelectorAll("[data-cell-id]") ?? []);
    for (const element of elements) {
      const id = element.getAttribute("data-cell-id");
      if (!id) continue;
      const cells = logoCellCache.get(id) ?? [];
      cells.push(element);
      logoCellCache.set(id, cells);
    }

    return Array.from(logoCellCache.keys()).map((id) => {
      const element = logoCellCache.get(id)?.[0];
      const q = Number(element?.getAttribute("data-q") ?? "0");
      const r = Number(element?.getAttribute("data-r") ?? "0");
      return { id, q, r, center: { x: 0, y: 0 }, path: "" };
    });
  };

  const applyLogoFrame = (frame) => {
    for (const state of frame.states) {
      const elements = logoCellCache.get(state.id);
      if (!elements) continue;
      for (const element of elements) {
        element.dataset.cellState = state.state;
        element.style.setProperty("--cell-intensity", String(state.intensity));
        for (const className of stateClasses) {
          element.classList.remove(className);
        }
        if (state.state === "origin") element.classList.add("is-origin");
        if (state.state === "propagating") element.classList.add("is-propagating");
        if (state.state === "receiving") element.classList.add("is-receiving");
        if (state.state === "resolved") element.classList.add("is-resolved");
        if (state.state !== "idle") {
          element.classList.add("is-active");
        } else {
          element.classList.remove("is-active");
        }
      }
    }
  };

  const finishIntro = () => {
    if (logoFrameRaf) cancelAnimationFrame(logoFrameRaf);
    if (logoCleanupTimer) window.clearTimeout(logoCleanupTimer);
    introAnimating = false;
    introSeen = true;
    storeSeen();
    syncState("done");
  };

  const playLogoAnimation = () => {
    if (!worldSceneRoot) {
      finishIntro();
      return;
    }

    const cells = getLogoCells();
    if (cells.length === 0) {
      finishIntro();
      return;
    }

    const startedAt = performance.now();
    const duration = 4600;

    const tick = (now) => {
      const elapsed = now - startedAt;
      applyLogoFrame(getGhLogoFrame(cells, elapsed, "center-origin"));
      if (elapsed < duration) {
        logoFrameRaf = requestAnimationFrame(tick);
        return;
      }
      logoCleanupTimer = window.setTimeout(() => {
        finishIntro();
      }, 320);
    };

    logoFrameRaf = requestAnimationFrame(tick);
  };

  const startIntro = () => {
    if (introAnimating || introSeen) return;
    introAnimating = true;
    syncState("signal");
    window.setTimeout(() => {
      syncState("logo");
      playLogoAnimation();
    }, 280);
  };

  if (!readSeen() && root.dataset.homeIntroState !== "done") {
    syncState("ready");
  } else {
    syncState("done");
    introSeen = true;
  }

  introTrigger?.addEventListener("click", startIntro);
</script>
