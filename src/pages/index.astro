---
import BaseLayout from "../layouts/BaseLayout.astro";
import TopologyScene from "operational-topology/astro/TopologyScene";
import { createTopologyScenePreset } from "operational-topology/presets";

const dormantScene = createTopologyScenePreset({
  layout: "viewport-fit",
  topologyLayout: "ring",
  showGridNodes: false,
  gridActivity: true,
  ambientSignals: false,
});


const latestJournal = {
  id: "JRNL-001",
  title: "Keeping the operating model readable",
  date: "2026-08-13",
  excerpt:
    "A practical site works better when structure stays visible without making the page feel like a dashboard demo.",
  href: "/journal",
};

const latestIncident = {
  id: "INC-0027",
  title: "Signal route failure",
  date: "2026-08-11",
  summary:
    "A topology route lost clarity during a transition and needed a bounded camera frame to remain legible.",
  status: "INVESTIGATING",
  href: "/incidents",
};

---

<BaseLayout
  title="thisisgenaro.com | Genaro Hernandez"
  description="Genaro Hernandez builds resilient infrastructure, writes about the work, and documents incidents with clarity."
>
  <main class="home">
    <div class="home__world" aria-hidden="true">
      <TopologyScene
        class="home__world-scene"
        nodes={[]}
        edges={[]}
        {...dormantScene}
        signalTransitionSpeed={0.9}
      />
      <div class="home__world-vignette"></div>
    </div>


    <section class="home__content">
      <div class="home__feature-column">
        <article class="home__lead" aria-labelledby="home-lead-title">
          <p class="eyebrow">IT Infrastructure &amp; Cloud Specialist</p>
          <h1 class="home__headline" id="home-lead-title">
            <span>Design</span>
            <span>Automate</span>
            <span class="home__headline-accent">Keep things running.</span>
          </h1>
          <p class="home__lede">
            I help organizations build resilient infrastructure, gain visibility across their systems and resolve the incidents that matter.
          </p>
          <div class="home__lead-actions button-row">
            <a class="button primary" href="/journal">Journal</a>
            <a class="button" href="/about/cv">CV</a>
          </div>
        </article>

        <aside class="home__inspector surface surface-pad" aria-labelledby="inspector-title">
          <div class="section-label">
            <h2 id="inspector-title">Knowledge System</h2>
          </div>
          <p class="home__inspector-body">
            Organizations, incidents, entries, and lessons stay connected through one persistent world.
          </p>
          <div class="chip-row">
            <span class="chip">Shared world</span>
            <span class="chip">Clear signals</span>
            <span class="chip">Editorial content</span>
            <span class="chip">Reusable scenes</span>
          </div>
        </aside>
      </div>

      <article class="home__card surface surface-pad home__card--journal">
        <p class="home__card-id mono">{latestJournal.id}</p>
        <h3>{latestJournal.title}</h3>
        <p class="home__card-date">{latestJournal.date}</p>
        <p class="home__card-body">{latestJournal.excerpt}</p>
        <a class="home__card-link" href={latestJournal.href}>Read journal</a>
      </article>

      <article class="home__card surface surface-pad home__card--incident">
        <p class="home__card-id mono">{latestIncident.id}</p>
        <h3>{latestIncident.title}</h3>
        <div class="home__status-row">
          <p class="home__card-date">{latestIncident.date}</p>
          <span class="home__status-pill">{latestIncident.status}</span>
        </div>
        <p class="home__card-body">{latestIncident.summary}</p>
        <a class="home__card-link" href={latestIncident.href}>Open incident</a>
      </article>
    </section>

    <footer class="home__footer surface surface-pad">
      <div class="home__footer-copy">
        <p class="home__footer-name">Genaro Hernandez</p>
        <p class="home__footer-body">Design, automate, keep things running. Writing, incidents, and operational notes live here.</p>
      </div>
      <div class="home__footer-links" aria-label="Footer">
        <a href="/about">About</a>
        <a href="/about/cv">CV</a>
        <a href="/journal">Journal</a>
      </div>
    </footer>
  </main>
</BaseLayout>

<style>
  .home {
    position: relative;
    width: 100%;
    padding: 1rem 0 0;
  }

  .home__world {
    position: fixed;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    opacity: 0.18;
    filter: saturate(0.85);
  }

  .home__world-scene {
    position: absolute;
    inset: 0;
  }

  .home__world-vignette {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(circle at 50% 20%, rgba(242, 169, 0, 0.06), transparent 22%),
      linear-gradient(180deg, rgba(1, 4, 6, 0.08), rgba(1, 4, 6, 0.55));
  }

  .home__content {
    display: grid;
    width: min(100%, 78rem);
    margin: 0 auto;
    grid-template-columns: minmax(0, 2fr) minmax(0, 1fr) minmax(0, 1fr);
    gap: 1rem;
    align-items: start;
  }

  .home__feature-column {
    display: grid;
    gap: 1rem;
    min-width: 0;
  }

  .home__lead,
  .home__inspector,
  .home__card,
  .home__footer {
    border-radius: var(--radius-xl);
    padding-inline: 1rem;
    background: linear-gradient(180deg, color-mix(in srgb, var(--surface-2) 80%, transparent), color-mix(in srgb, var(--surface) 68%, transparent));
    border-color: color-mix(in srgb, var(--line-strong) 60%, transparent);
    box-shadow: 0 12px 28px rgba(0, 0, 0, 0.18);
    transition: transform 180ms ease, border-color 180ms ease, box-shadow 180ms ease;
  }

  .home__lead {
    padding-inline: 0;
    border: 0;
    border-radius: 0;
    background: transparent;
    box-shadow: none;
    gap: 0.65rem;
    min-height: 18.5rem;
  }


  .home__headline {
    margin: 0;
    display: grid;
    gap: 0.04em;
    font-size: clamp(3rem, 6.7vw, 6.2rem);
    line-height: 0.9;
    letter-spacing: -0.06em;
  }

  .home__headline-accent {
    color: var(--accent);
  }

  .home__lede {
    max-width: 32rem;
    margin: 0;
    color: var(--text);
    font-size: clamp(1.02rem, 1.55vw, 1.18rem);
    line-height: 1.65;
  }

  .home__lead-actions {
    margin-top: 0.35rem;
  }

  .home__inspector {
    display: grid;
    gap: 0.65rem;
  }

  .home__inspector-kicker {
    margin: 0;
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    display: inline-flex;
    align-items: center;
    min-height: 2.4rem;
    padding: 0.45rem 0.8rem;
    border: 1px solid transparent;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.02);
    transition: border-color 180ms ease, background 180ms ease, transform 180ms ease;
  }

  .home__inspector-body {
    margin: 0;
    color: var(--muted);
    line-height: 1.6;
  }


  .home__footer {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 1rem;
  }

  .home__footer-copy {
    max-width: 30rem;
  }

  .home__footer-name {
    margin: 0;
    color: var(--text);
    font-family: var(--font-title);
    font-size: 1rem;
    letter-spacing: -0.03em;
  }

  .home__footer-body {
    margin: 0.4rem 0 0;
    color: var(--muted);
    line-height: 1.6;
  }

  .home__footer-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.85rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .home__footer-links a {
    color: var(--text);
    border-bottom: 1px solid transparent;
    transition: border-color 180ms ease, color 180ms ease, transform 180ms ease, box-shadow 180ms ease;
  }

  .home__footer-links a:hover,
  .home__footer-links a:focus-visible {
    color: var(--accent);
    border-bottom-color: color-mix(in srgb, var(--accent) 80%, transparent);
    transform: translateY(-1px);
  }

  .home__card {
    display: grid;
    gap: 0.6rem;
  }

  .home__lead:hover,
  .home__inspector:hover,
  .home__card:hover,
  .home__footer:hover,
  .home__card:focus-within,
  .home__footer:focus-within {
    transform: translateY(-1px);
    box-shadow: 0 14px 32px rgba(0, 0, 0, 0.22);
    border-color: color-mix(in srgb, var(--line-strong) 78%, transparent);
  }

  .home__lead:hover,
  .home__lead:focus-within {
    transform: none;
    box-shadow: none;
  }

  .home__card-id,
  .home__card-date {
    margin: 0;
    color: var(--muted);
  }

  .home__card h3 {
    margin: 0;
    font-size: 1.15rem;
  }

  .home__card-body {
    margin: 0;
    color: var(--muted);
    line-height: 1.65;
  }

  .home__card-link {
    margin-top: 0.25rem;
    color: var(--text);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    display: inline-flex;
    align-items: center;
    min-height: 2.4rem;
    padding: 0.45rem 0.8rem;
    border: 1px solid transparent;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.02);
    transition: border-color 180ms ease, background 180ms ease, transform 180ms ease, box-shadow 180ms ease;
  }

  .home__status-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .home__card--journal,
  .home__card--incident {
    min-height: 100%;
  }

  .home__status-pill {
    display: inline-flex;
    align-items: center;
    min-height: 1.8rem;
    padding: 0.35rem 0.7rem;
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, var(--accent) 35%, transparent);
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    background: color-mix(in srgb, var(--accent-soft) 60%, transparent);
  }

  @media (max-width: 980px) {
    .home__content {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 680px) {
    .home {
      width: 100%;
      padding-top: 0.75rem;
    }

    .home__content {
      gap: 0.9rem;
    }

    .home__lead,
    .home__inspector,
    .home__card {
      border-radius: 0.95rem;
    }

    .home__status-row {
      align-items: flex-start;
      flex-direction: column;
      gap: 0.45rem;
    }

    .home__footer {
      flex-direction: column;
      align-items: stretch;
    }

    .home__footer-links {
      justify-content: flex-start;
    }

    .home__headline {
      font-size: clamp(2.6rem, 15vw, 4.2rem);
    }

    .home__lead-actions {
      margin-top: 0.5rem;
    }

    .home__lede {
      font-size: 1rem;
      line-height: 1.62;
    }
  }
</style>

