---
import BaseLayout from "../layouts/BaseLayout.astro";
import TopologyScene from "operational-topology/astro/TopologyScene";
import { createTopologyScenePreset } from "operational-topology/presets";

const dormantScene = createTopologyScenePreset({
  layout: "viewport-fit",
  topologyLayout: "ring",
  showGridNodes: false,
  gridActivity: true,
  ambientSignals: false,
});


const latestJournal = {
  id: "JRNL-001",
  title: "Keeping the operating model readable",
  date: "2026-08-13",
  excerpt:
    "A practical site works better when structure stays visible without making the page feel like a dashboard demo.",
  href: "/journal",
};

const latestIncident = {
  id: "INC-0027",
  title: "Signal route failure",
  date: "2026-08-11",
  summary:
    "A topology route lost clarity during a transition and needed a bounded camera frame to remain legible.",
  status: "INVESTIGATING",
  href: "/incidents",
};

const pathname = Astro.url.pathname;
const navItems = [
  { href: "/", label: "Home" },
  { href: "/journal", label: "Journal" },
  { href: "/incidents", label: "Incidents" },
  { href: "/about", label: "About" },
  { href: "/about/cv", label: "CV" },
];
---

<BaseLayout
  title="thisisgenaro.com | Genaro Hernandez"
  description="Genaro Hernandez builds resilient infrastructure, writes about the work, and documents incidents with clarity."
>
  <main class="home">
    <div class="home__world" aria-hidden="true">
      <TopologyScene
        class="home__world-scene"
        nodes={[]}
        edges={[]}
        {...dormantScene}
        signalTransitionSpeed={0.9}
      />
      <div class="home__world-vignette"></div>
    </div>

    <header class="home__nav surface surface-pad">
      <div class="home__brand-row">
        <a class="home__brand" href="/" aria-label="Home"><img class="home__brand-image" src="/gh-logo.png" alt="" /></a>
        <div class="home__brand-copy">
          <p class="home__brand-name">Genaro Hernandez</p>
          <p class="home__brand-tag">Design, automate, keep things running.</p>
        </div>
      </div>

      <button class="home__menu-toggle" type="button" aria-expanded="false" aria-controls="home-primary-nav">
        <span class="home__menu-icon" aria-hidden="true">
          <span></span>
          <span></span>
          <span></span>
        </span>
        <span class="home__menu-label">Menu</span>
      </button>

      <nav class="home__links" id="home-primary-nav" aria-label="Primary">
        {navItems.map((item) => {
          const active = pathname === item.href;
          return (
            <a href={item.href} aria-current={active ? "page" : undefined} class:list={{ "is-active": active }}>
              {item.label}
            </a>
          );
        })}
      </nav>
    </header>

    <section class="home__hero">
      <article class="home__lead surface surface-pad">
        <p class="eyebrow">IT Infrastructure &amp; Cloud Specialist</p>
        <h1 class="home__headline">
          <span>Design</span>
          <span>Automate</span>
          <span class="home__headline-accent">Keep things running.</span>
        </h1>
        <p class="home__lede">
          I help organizations build resilient infrastructure, gain visibility across their systems and resolve the incidents that matter.
        </p>
        <div class="home__lead-actions button-row">
          <a class="button primary" href="/journal">Journal</a>
          <a class="button" href="/about/cv">CV</a>
        </div>
      </article>

      <aside class="home__inspector surface surface-pad" aria-labelledby="inspector-title">
        <div class="section-label">
          <h2 id="inspector-title">Knowledge System</h2>
        </div>
        <p class="home__inspector-body">
          Organizations, incidents, entries, and lessons stay connected through one persistent world.
        </p>
        <div class="chip-row">
          <span class="chip">Shared world</span>
          <span class="chip">Clear signals</span>
          <span class="chip">Editorial content</span>
          <span class="chip">Reusable scenes</span>
        </div>
      </aside>
    </section>

    <section class="home__latest-grid">
      <article class="home__card surface surface-pad">
        <p class="home__card-id mono">{latestJournal.id}</p>
        <h3>{latestJournal.title}</h3>
        <p class="home__card-date">{latestJournal.date}</p>
        <p class="home__card-body">{latestJournal.excerpt}</p>
        <a class="home__card-link" href={latestJournal.href}>Read journal</a>
      </article>

      <article class="home__card surface surface-pad">
        <p class="home__card-id mono">{latestIncident.id}</p>
        <h3>{latestIncident.title}</h3>
        <div class="home__status-row">
          <p class="home__card-date">{latestIncident.date}</p>
          <span class="home__status-pill">{latestIncident.status}</span>
        </div>
        <p class="home__card-body">{latestIncident.summary}</p>
        <a class="home__card-link" href={latestIncident.href}>Open incident</a>
      </article>
    </section>

    <footer class="home__footer surface surface-pad">
      <div class="home__footer-copy">
        <p class="home__footer-name">Genaro Hernandez</p>
        <p class="home__footer-body">Design, automate, keep things running. Writing, incidents, and operational notes live here.</p>
      </div>
      <div class="home__footer-links" aria-label="Footer">
        <a href="/about">About</a>
        <a href="/about/cv">CV</a>
        <a href="/journal">Journal</a>
      </div>
    </footer>
  </main>
</BaseLayout>

<style>
  .home {
    position: relative;
    width: min(calc(100% - 2rem), var(--content-width));
    margin: 0 auto;
    padding: 1rem 0 2rem;
  }

  .home__world {
    position: fixed;
    inset: 0;
    z-index: -1;
    pointer-events: none;
    opacity: 0.18;
    filter: saturate(0.85);
  }

  .home__world-scene {
    position: absolute;
    inset: 0;
  }

  .home__world-vignette {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(circle at 50% 20%, rgba(242, 169, 0, 0.06), transparent 22%),
      linear-gradient(180deg, rgba(1, 4, 6, 0.08), rgba(1, 4, 6, 0.55));
  }

  .home__nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    border-radius: var(--radius-xl);
    padding-inline: 1rem;
    background: linear-gradient(180deg, color-mix(in srgb, var(--surface-2) 80%, transparent), color-mix(in srgb, var(--surface) 68%, transparent));
    border-color: color-mix(in srgb, var(--line-strong) 60%, transparent);
    box-shadow: 0 12px 28px rgba(0, 0, 0, 0.18);
    margin-bottom: 1rem;
  }

  .home__brand-row {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    min-width: 0;
  }

  .home__brand {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: none;
    width: 3.6rem;
    aspect-ratio: 1;
    padding: 0;
    border: 0;
    border-radius: 0;
    background: transparent;
    box-shadow: none;
  }

  .home__brand-image {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .home__brand-copy {
    min-width: 0;
  }

  .home__brand-name {
    margin: 0;
    color: var(--text);
    font-family: var(--font-title);
    font-size: 0.98rem;
    letter-spacing: -0.03em;
    line-height: 1.1;
  }

  .home__brand-tag {
    margin: 0.15rem 0 0;
    color: var(--muted);
    font-size: 0.78rem;
    line-height: 1.3;
  }

  .home__menu-toggle {
    display: none;
    align-items: center;
    gap: 0.55rem;
    min-height: 2.3rem;
    padding: 0.38rem 0.7rem;
    border: 1px solid color-mix(in srgb, var(--line-strong) 55%, transparent);
    border-radius: 0.55rem;
    background: transparent;
    color: var(--text);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    transition: border-color 180ms ease, background 180ms ease, transform 180ms ease, box-shadow 180ms ease;
  }

  .home__menu-icon {
    display: grid;
    gap: 0.22rem;
    width: 1rem;
  }

  .home__menu-icon span {
    display: block;
    width: 100%;
    height: 1px;
    background: currentColor;
  }

  .home__links {
    align-items: center;
    justify-content: flex-end;
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
    font-family: var(--font-mono);
    font-size: 0.74rem;
    letter-spacing: 0.14em;
  }

  .home__links a {
    display: inline-flex;
    align-items: center;
    min-height: 2.1rem;
    padding: 0.2rem 0.05rem;
    color: var(--text);
    border-bottom: 1px solid transparent;
    border-radius: 0;
    background: transparent;
    font-family: var(--font-mono);
    font-size: 0.74rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    transition: border-color 180ms ease, color 180ms ease, transform 180ms ease, box-shadow 180ms ease;
  }

  .home__links a:hover,
  .home__links a:focus-visible {
    transform: translateY(-1px);
    border-bottom-color: color-mix(in srgb, var(--accent) 70%, transparent);
    color: var(--accent);
  }

  .home__brand:focus-visible,
  .home__menu-toggle:focus-visible,
  .home__links a:focus-visible,
  .home__card-link:focus-visible,
  .home__footer-links a:focus-visible {
    outline: 2px solid color-mix(in srgb, var(--accent) 70%, white);
    outline-offset: 3px;
  }

  .home__links a.is-active,
  .home__links a[aria-current="page"] {
    color: var(--accent);
    border-bottom-color: color-mix(in srgb, var(--accent) 85%, transparent);
  }

  .home__hero {
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(280px, 0.65fr);
    gap: 0.9rem;
    align-items: start;
  }

  .home__lead,
  .home__inspector,
  .home__card,
  .home__footer {
    border-radius: var(--radius-xl);
    padding-inline: 1rem;
    background: linear-gradient(180deg, color-mix(in srgb, var(--surface-2) 80%, transparent), color-mix(in srgb, var(--surface) 68%, transparent));
    border-color: color-mix(in srgb, var(--line-strong) 60%, transparent);
    box-shadow: 0 12px 28px rgba(0, 0, 0, 0.18);
    transition: transform 180ms ease, border-color 180ms ease, box-shadow 180ms ease;
  }

  .home__lead {
    display: grid;
    gap: 0.65rem;
    min-height: 18.5rem;
  }

  .home__headline {
    margin: 0;
    display: grid;
    gap: 0.04em;
    font-size: clamp(3rem, 6.7vw, 6.2rem);
    line-height: 0.9;
    letter-spacing: -0.06em;
  }

  .home__headline-accent {
    color: var(--accent);
  }

  .home__lede {
    max-width: 32rem;
    margin: 0;
    color: var(--text);
    font-size: clamp(1.02rem, 1.55vw, 1.18rem);
    line-height: 1.65;
  }

  .home__lead-actions {
    margin-top: 0.35rem;
  }

  .home__inspector {
    display: grid;
    gap: 0.65rem;
  }

  .home__inspector-kicker {
    margin: 0;
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    display: inline-flex;
    align-items: center;
    min-height: 2.4rem;
    padding: 0.45rem 0.8rem;
    border: 1px solid transparent;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.02);
    transition: border-color 180ms ease, background 180ms ease, transform 180ms ease;
  }

  .home__inspector-body {
    margin: 0;
    color: var(--muted);
    line-height: 1.6;
  }

  .home__latest-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    margin-top: 1rem;
  }

  .home__footer {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 1rem;
  }

  .home__footer-copy {
    max-width: 30rem;
  }

  .home__footer-name {
    margin: 0;
    color: var(--text);
    font-family: var(--font-title);
    font-size: 1rem;
    letter-spacing: -0.03em;
  }

  .home__footer-body {
    margin: 0.4rem 0 0;
    color: var(--muted);
    line-height: 1.6;
  }

  .home__footer-links {
    display: flex;
    flex-wrap: wrap;
    justify-content: flex-end;
    gap: 0.85rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .home__footer-links a {
    color: var(--text);
    border-bottom: 1px solid transparent;
    transition: border-color 180ms ease, color 180ms ease, transform 180ms ease, box-shadow 180ms ease;
  }

  .home__footer-links a:hover,
  .home__footer-links a:focus-visible {
    color: var(--accent);
    border-bottom-color: color-mix(in srgb, var(--accent) 80%, transparent);
    transform: translateY(-1px);
  }

  .home__card {
    display: grid;
    gap: 0.6rem;
  }

  .home__lead:hover,
  .home__inspector:hover,
  .home__card:hover,
  .home__footer:hover,
  .home__card:focus-within,
  .home__footer:focus-within {
    transform: translateY(-1px);
    box-shadow: 0 14px 32px rgba(0, 0, 0, 0.22);
    border-color: color-mix(in srgb, var(--line-strong) 78%, transparent);
  }

  .home__card-id,
  .home__card-date {
    margin: 0;
    color: var(--muted);
  }

  .home__card h3 {
    margin: 0;
    font-size: 1.15rem;
  }

  .home__card-body {
    margin: 0;
    color: var(--muted);
    line-height: 1.65;
  }

  .home__card-link {
    margin-top: 0.25rem;
    color: var(--text);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    display: inline-flex;
    align-items: center;
    min-height: 2.4rem;
    padding: 0.45rem 0.8rem;
    border: 1px solid transparent;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.02);
    transition: border-color 180ms ease, background 180ms ease, transform 180ms ease, box-shadow 180ms ease;
  }

  .home__status-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .home__status-pill {
    display: inline-flex;
    align-items: center;
    min-height: 1.8rem;
    padding: 0.35rem 0.7rem;
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, var(--accent) 35%, transparent);
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    background: color-mix(in srgb, var(--accent-soft) 60%, transparent);
  }

  @media (max-width: 980px) {
    .home__hero,
    .home__latest-grid {
      grid-template-columns: 1fr;
    }

    .home__nav {
      align-items: center;
      flex-direction: row;
      flex-wrap: wrap;
      gap: 0.75rem;
      padding-inline: 0.9rem;
    }

    .home__brand-row {
      width: auto;
      align-items: center;
      flex: 1 1 auto;
    }

    .home__menu-toggle {
      margin-left: auto;
    }
  }

  @media (max-width: 680px) {
    .home {
      width: min(calc(100% - 1rem), var(--content-width));
      padding-top: 0.5rem;
    }

    .home__brand-row {
      align-items: center;
    }

    .home__brand-name {
      font-size: 0.92rem;
    }

    .home__brand-tag {
      font-size: 0.74rem;
    }

    .home__menu-toggle {
      display: inline-flex;
      margin-left: auto;
      align-self: center;
    }

    .home__links {
      display: none;
      width: 100%;
      flex-direction: column;
      gap: 0.15rem;
      padding-top: 0.1rem;
    }

    .home__links a {
      width: 100%;
      padding: 0.65rem 0;
      border-bottom-color: color-mix(in srgb, var(--line) 88%, transparent);
    }

    .home__nav.is-open .home__links {
      display: flex;
    }

    .home__nav,
    .home__lead,
    .home__inspector,
    .home__card {
      border-radius: 0.95rem;
    }

    .home__status-row {
      align-items: flex-start;
      flex-direction: column;
      gap: 0.45rem;
    }

    .home__footer {
      flex-direction: column;
      align-items: stretch;
    }

    .home__footer-links {
      justify-content: flex-start;
    }

    .home__headline {
      font-size: clamp(2.6rem, 15vw, 4.2rem);
    }

    .home__lead-actions {
      margin-top: 0.5rem;
    }

    .home__lede {
      font-size: 1rem;
      line-height: 1.62;
    }
  }
</style>

<script>
  const nav = document.querySelector<HTMLElement>(".home__nav");
  const toggle = document.querySelector<HTMLButtonElement>(".home__menu-toggle");

  toggle?.addEventListener("click", () => {
    const nextOpen = !nav?.classList.contains("is-open");
    nav?.classList.toggle("is-open", nextOpen);
    toggle.setAttribute("aria-expanded", String(nextOpen));
  });

  document.addEventListener("click", (event) => {
    if (!nav || !toggle || nav.contains(event.target as Node) || toggle.contains(event.target as Node)) return;
    nav.classList.remove("is-open");
    toggle.setAttribute("aria-expanded", "false");
  });

  document.addEventListener("keydown", (event) => {
    if (event.key !== "Escape" || !nav || !toggle) return;
    nav.classList.remove("is-open");
    toggle.setAttribute("aria-expanded", "false");
  });
</script>
