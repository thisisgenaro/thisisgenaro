---
import BaseLayout from "../layouts/BaseLayout.astro";
import TopologyScene from "operational-topology/astro/TopologyScene";
import { createTopologyScenePreset } from "operational-topology/presets";
import { GH_LOGO_ROLE_BY_CELL, getGhLogoFrame } from "operational-topology/labs";

const dormantScene = createTopologyScenePreset({
  layout: "viewport-fit",
  topologyLayout: "ring",
  radius: 34,
  showGridNodes: false,
  gridActivity: true,
  ambientSignals: false,
});

const introLogoNode = [
  {
    id: "intro-logo",
    label: "",
    image: "/gh-logo.png",
    imageScale: 0.82,
    imageOffsetY: 0.06,
    imageAlign: "center",
    q: 0,
    r: 0,
    variant: "root",
    size: "root",
    active: true,
    selected: true,
  },
];

const introBootstrap =
  "(() => {" +
  "document.documentElement.dataset.homeIntroState='ready';" +
  "})();";

const latestJournal = {
  id: "JRNL-001",
  title: "Keeping the operating model readable",
  date: "2026-08-13",
  excerpt:
    "A clear operating model keeps the thinking readable while leaving room for the human story behind it.",
  href: "/journal",
};

const latestIncident = {
  id: "INC-0027",
  title: "Signal route failure",
  date: "2026-08-11",
  summary:
    "A transition briefly obscured the route, so the scene was bounded until the incident could be read clearly again.",
  status: "INVESTIGATING",
  href: "/incidents",
};

---

<script is:inline slot="head" set:html={introBootstrap}></script>

<BaseLayout
  title="thisisgenaro.com | Genaro Hernandez"
  description="Genaro Hernandez builds resilient infrastructure, writes about the work, and documents incidents with clarity."
>
  <main class="home">
    <div class="home__world" aria-hidden="true">
      <TopologyScene
        class="home__world-scene"
        nodes={introLogoNode}
        edges={[]}
        {...dormantScene}
        showGridNodes={true}
        signalTransitionSpeed={0.9}
      />
    </div>


    <section class="home__hero">
      <div class="home__hero-grid">
        <article class="home__lead" aria-labelledby="home-lead-title">
          <div class="home__hero-meta">
            <p class="home__hero-role">Sharing infrastructure patterns and incident lessons</p>
            <p class="home__hero-principle">
              <span>Design</span>
              <span>Automate</span>
              <span class="home__hero-principle-emphasis">Keep things running.</span>
            </p>
          </div>
          <h1 class="home__headline" id="home-lead-title">
            <span>Genaro Hernández</span>
          </h1>
          <p class="home__lede">
            Learn to see infrastructure beyond servers and dashboards — as systems, dependencies, signals, and decisions.
          </p>
          <div class="home__lead-actions">
            <a class="button primary home__cta" href="/journal">
              <span>Read the Journal</span>
              <span class="home__cta-arrow" aria-hidden="true">→</span>
            </a>
          </div>
        </article>

        <aside class="home__inspector surface surface-pad" aria-label="Knowledge System">
          <p class="home__inspector-kicker">Knowledge System</p>
          <h2 class="home__inspector-title">Patterns and evidence</h2>
          <p class="home__inspector-body">
            The Journal follows the patterns that emerge from the work. The Incident Library preserves the evidence left behind by events. Together, they make experience easier to examine, understand, and carry forward.
          </p>
          <div class="home__system-panels">
            <section class="home__system-panel home__system-panel--journal">
              <p class="home__system-label">Journal</p>
              <p class="home__system-copy">
                Where observations become ideas. Editorial and reflective, it keeps the reasoning visible and explores the patterns, questions, and lessons behind the work.
              </p>
            </section>
            <section class="home__system-panel home__system-panel--incident">
              <p class="home__system-label">Incident Library</p>
              <p class="home__system-copy">
                Where events become records. Structured and operational, it captures what happened, what mattered, and what was learned with enough precision to remain useful later.
              </p>
            </section>
          </div>
        </aside>
      </div>
    </section>

    <section class="home__content">
      <article class="home__card surface surface-pad home__card--journal">
        <p class="home__card-label">Latest Journal</p>
        <p class="home__card-id mono">{latestJournal.id}</p>
        <h3>{latestJournal.title}</h3>
        <p class="home__card-date">{latestJournal.date}</p>
        <p class="home__card-body">{latestJournal.excerpt}</p>
        <a class="home__card-link" href={latestJournal.href}>Read entry</a>
      </article>

      <article class="home__card surface surface-pad home__card--incident">
        <p class="home__card-label">Latest Incident</p>
        <p class="home__card-id mono">{latestIncident.id}</p>
        <h3>{latestIncident.title}</h3>
        <div class="home__status-row">
          <p class="home__card-date">{latestIncident.date}</p>
          <span class="home__status-pill">{latestIncident.status}</span>
        </div>
        <p class="home__card-body">{latestIncident.summary}</p>
        <a class="home__card-link" href={latestIncident.href}>Open record</a>
      </article>
    </section>
  </main>
</BaseLayout>

<style>
  .home {
    position: relative;
    display: grid;
    align-content: center;
    gap: clamp(0.75rem, 2vw, 1.15rem);
    min-height: 100svh;
    width: 100%;
    padding: clamp(1rem, 4vh, 2.4rem) clamp(1rem, 3.5vw, 2.4rem);
  }

  .home__world {
    position: fixed;
    inset: 0;
    z-index: 0;
    pointer-events: auto;
    opacity: 0.15;
    filter: saturate(0.85);
    transition: opacity 280ms ease, filter 280ms ease;
  }

  html[data-home-intro-state="ready"] .home__world {
    opacity: 0.58;
    filter: saturate(1.08) brightness(1.12);
  }

  html[data-home-intro-state="signal"] .home__world,
  html[data-home-intro-state="logo"] .home__world,
  html[data-home-intro-state="handoff"] .home__world {
    opacity: 1;
    filter: saturate(1.08) brightness(1.12);
  }

  html[data-home-intro-state="done"] .home__world {
    opacity: 0.18;
    filter: saturate(0.85);
  }

  .home__world::before,
  .home__world::after {
    content: "";
    position: fixed;
    left: 50%;
    top: 50%;
    width: 7rem;
    height: 7rem;
    translate: -50% -50%;
    border-radius: 50%;
    border: 1px solid color-mix(in srgb, var(--accent) 38%, transparent);
    opacity: 0;
    pointer-events: none;
  }

  .home__world::after {
    width: 5.25rem;
    height: 5.25rem;
    border-color: color-mix(in srgb, var(--accent) 20%, transparent);
  }

  html[data-home-intro-state="signal"] .home__world::before {
    animation: home-origin-burst 2200ms ease-out forwards;
  }

  html[data-home-intro-state="signal"] .home__world::after {
    animation: home-origin-burst 2200ms ease-out 120ms forwards;
  }

  .home__world .scene-grid {
    opacity: 0.52;
    transition: opacity 420ms ease, transform 280ms ease;
  }

  html[data-home-intro-state="ready"] .home__world .scene-grid {
    opacity: 1;
  }

  html[data-home-intro-state="signal"] .home__world .scene-grid,
  html[data-home-intro-state="logo"] .home__world .scene-grid,
  html[data-home-intro-state="handoff"] .home__world .scene-grid {
    opacity: 1;
  }

  html[data-home-intro-state="done"] .home__world .scene-grid {
    opacity: 0.52;
  }

  .home__world [data-node-id="intro-logo"] {
    opacity: 1;
    transition: opacity 500ms ease, transform 240ms ease;
    cursor: pointer;
    touch-action: manipulation;
  }

  .home__world [data-node-id="intro-logo"] .grid-occupant-image {
    transition: opacity 500ms ease, transform 500ms ease;
    opacity: 1;
  }

  html[data-home-intro-state="logo"] .home__world [data-node-id="intro-logo"] .grid-occupant-image {
    opacity: 0 !important;
  }

  html[data-home-intro-state="logo"] .home__world [data-node-id="intro-logo"] {
    opacity: 0 !important;
    pointer-events: none;
  }

  html[data-home-intro-state="done"] .home__world [data-node-id="intro-logo"] {
    opacity: 0;
    cursor: default;
  }

  html[data-home-intro-state="done"] .home__world [data-node-id="intro-logo"],
  html[data-home-intro-state="done"] .home__world [data-node-id="intro-logo"] * {
    pointer-events: none;
  }

  .home__world [data-node-id="intro-logo"] .grid-hex.is-logo-border,
  .home__world [data-node-id="intro-logo"] .grid-node.is-logo-border {
    stroke: var(--theme-accent) !important;
    fill: color-mix(in srgb, var(--theme-accent) 18%, transparent) !important;
    color: var(--theme-accent) !important;
    filter: drop-shadow(0 0 10px color-mix(in srgb, var(--theme-accent) 42%, transparent)) !important;
  }

  .home__world [data-node-id="intro-logo"] .grid-hex.is-logo-g,
  .home__world [data-node-id="intro-logo"] .grid-node.is-logo-g,
  .home__world [data-node-id="intro-logo"] .grid-hex.is-logo-h,
  .home__world [data-node-id="intro-logo"] .grid-node.is-logo-h {
    stroke: #ffffff !important;
    fill: color-mix(in srgb, #ffffff 18%, transparent) !important;
    color: #ffffff !important;
    filter: drop-shadow(0 0 8px color-mix(in srgb, #ffffff 26%, transparent)) !important;
  }

  .home__world-scene {
    position: absolute;
    inset: 0;
    z-index: 0;
  }


  .home__hero,
  .home__content {
    position: relative;
    z-index: 1;
    width: min(100%, 84rem);
    margin: 0 auto;
  }

  .home__hero {
    margin-bottom: 1rem;
  }

  .home__hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(18rem, 0.75fr);
    gap: clamp(0.9rem, 1.8vw, 1.25rem);
    align-items: start;
  }

  .home__content {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
    align-items: start;
    max-width: 84rem;
  }

  .home__lead {
    display: grid;
    gap: 1.1rem;
    padding: 0;
    border: 0;
    border-radius: 0;
    background: transparent;
    box-shadow: none;
    min-height: 24rem;
  }

  .home__hero-meta {
    display: grid;
    gap: 0.6rem;
  }

  .home__hero-role {
    margin: 0;
    color: var(--muted);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .home__hero-principle {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin: 0;
    color: var(--text);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .home__hero-principle span {
    display: inline-flex;
    align-items: center;
    min-height: 2rem;
    padding: 0.2rem 0.65rem;
    border: 1px solid color-mix(in srgb, var(--line-strong) 72%, transparent);
    border-radius: 999px;
    background: color-mix(in srgb, var(--surface) 72%, transparent);
  }

  .home__hero-principle-emphasis {
    color: var(--accent);
    border-color: color-mix(in srgb, var(--accent) 28%, transparent) !important;
    background: color-mix(in srgb, var(--accent-soft) 52%, transparent) !important;
  }

  .home__headline {
    margin: 0;
    display: grid;
    gap: 0.04em;
    font-size: clamp(3.5rem, 7vw, 6.9rem);
    line-height: 0.9;
    letter-spacing: -0.06em;
  }

  .home__lede {
    max-width: 41rem;
    margin: 0;
    color: var(--text);
    font-size: clamp(1.02rem, 1.55vw, 1.18rem);
    line-height: 1.65;
  }

  .home__lead-actions {
    display: grid;
    gap: 0.55rem;
    margin-top: 0.1rem;
    justify-items: start;
  }

  .home__cta {
    min-width: min(18rem, 100%);
    justify-content: space-between;
    gap: 0.8rem;
    padding: 0.95rem 1.1rem;
    border-radius: 999px;
    border-color: color-mix(in srgb, var(--accent) 55%, var(--line-strong));
    background: linear-gradient(180deg, color-mix(in srgb, var(--accent) 24%, transparent), color-mix(in srgb, var(--accent) 10%, transparent));
    box-shadow: 0 14px 30px color-mix(in srgb, var(--accent) 12%, transparent);
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .home__cta-arrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 1.2rem;
    height: 1.2rem;
    color: var(--accent);
    font-size: 1rem;
    line-height: 1;
    transition: transform 180ms ease;
  }

  .home__cta:hover .home__cta-arrow,
  .home__cta:focus-visible .home__cta-arrow {
    transform: translateX(0.18rem);
  }

  .home__cta-copy {
    margin: 0;
    max-width: 26rem;
    color: var(--muted);
    font-size: 0.9rem;
    line-height: 1.45;
  }

  .home__inspector {
    align-self: stretch;
    display: grid;
    gap: 0.8rem;
    min-height: 100%;
    padding: clamp(0.95rem, 1.8vw, 1.25rem);
    border: 1px solid color-mix(in srgb, var(--line-strong) 82%, transparent);
    background: color-mix(in srgb, var(--surface) 78%, transparent);
    backdrop-filter: blur(10px);
  }

  .home__inspector-kicker {
    margin: 0;
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .home__inspector-title {
    margin: 0;
    font-size: 1.02rem;
    line-height: 1.15;
  }

  .home__inspector-body {
    margin: 0;
    max-width: 42ch;
    color: var(--muted);
    line-height: 1.54;
  }

  .home__system-panels {
    display: grid;
    gap: 0.72rem;
    margin-top: 0.1rem;
  }

  .home__system-panel {
    display: grid;
    gap: 0.28rem;
    padding: 0.75rem 0.82rem;
    border: 1px solid color-mix(in srgb, var(--line-strong) 72%, transparent);
    border-radius: 0.8rem;
    background: color-mix(in srgb, var(--surface-high) 55%, transparent);
  }

  .home__system-panel--journal {
    border-color: color-mix(in srgb, var(--accent) 24%, transparent);
  }

  .home__system-panel--incident {
    border-color: color-mix(in srgb, var(--blue) 24%, transparent);
  }

  .home__system-label {
    margin: 0;
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 0.66rem;
    font-weight: 700;
    letter-spacing: 0.13em;
    text-transform: uppercase;
  }

  .home__system-panel--incident .home__system-label {
    color: var(--blue);
  }

  .home__system-copy {
    margin: 0;
    max-width: 34ch;
    color: var(--text);
    line-height: 1.5;
  }

  .home__card {
    display: grid;
    gap: 0.5rem;
    align-content: start;
  }

  .home__lead:hover,
  .home__lead:focus-within {
    transform: none;
    box-shadow: none;
  }

  html:not([data-home-intro-state="done"]) .home__hero,
  html:not([data-home-intro-state="done"]) .home__content {
    opacity: 0;
    pointer-events: none;
    transform: translateY(0.4rem);
  }

  html:not([data-home-intro-state="done"]) .home__world {
    z-index: 0;
  }

  html[data-home-intro-state="done"] .home__world {
    z-index: -1;
  }


  .home__hero,
  .home__content {
    transition: opacity 520ms ease, transform 520ms ease;
  }

  .home__card-label,
  .home__card-id,
  .home__card-date {
    margin: 0;
    color: var(--muted);
  }

  .home__card-label {
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  .home__card h3 {
    margin: 0;
    font-size: 1.08rem;
  }

  .home__card-body {
    margin: 0;
    max-width: 28ch;
    color: var(--muted);
    line-height: 1.65;
  }

  .home__card-link {
    margin-top: 0.25rem;
    color: var(--text);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    display: inline-flex;
    align-items: center;
    min-height: 2.4rem;
    padding: 0.45rem 0.8rem;
    border: 1px solid transparent;
    border-radius: 999px;
    background: rgba(255, 255, 255, 0.02);
    transition: border-color 180ms ease, background 180ms ease, transform 180ms ease, box-shadow 180ms ease;
  }

  .home__status-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .home__card--journal,
  .home__card--incident {
    min-height: 100%;
    position: relative;
  }

  .home__card--journal::before,
  .home__card--incident::before {
    content: "";
    position: absolute;
    inset: 0 auto auto 0;
    width: 100%;
    height: 2px;
    opacity: 0.9;
  }

  .home__card--journal::before {
    background: linear-gradient(90deg, color-mix(in srgb, var(--accent) 70%, transparent), transparent);
  }

  .home__card--incident::before {
    background: linear-gradient(90deg, color-mix(in srgb, var(--blue) 72%, transparent), transparent);
  }

  .home__status-pill {
    display: inline-flex;
    align-items: center;
    min-height: 1.8rem;
    padding: 0.35rem 0.7rem;
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, var(--accent) 35%, transparent);
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    background: color-mix(in srgb, var(--accent-soft) 60%, transparent);
  }

  @keyframes home-origin-burst {
    0% {
      opacity: 0;
      transform: scale(0.18);
    }
    20% {
      opacity: 0.88;
    }
    100% {
      opacity: 0;
      transform: scale(1.62);
    }
  }

  @media (max-width: 980px) {
    .home__content {
      grid-template-columns: 1fr;
      max-width: none;
    }
  }

  @media (max-width: 680px) {
    .home {
      width: 100%;
      min-height: auto;
      padding-top: 0.95rem;
      padding-bottom: 1rem;
    }

    .home__hero,
    .home__content {
      width: 100%;
    }

    .home__hero {
      min-height: 0;
      margin-top: 0.25rem;
      margin-bottom: 0.95rem;
    }

    .home__hero-grid {
      grid-template-columns: 1fr;
      gap: 0.8rem;
    }

    .home__lead {
      gap: 0.95rem;
      min-height: 0;
    }

    .home__hero-meta {
      gap: 0.3rem;
    }

    .home__hero-role {
      font-size: 0.68rem;
    }

    .home__hero-principle {
      gap: 0.35rem;
      font-size: 0.64rem;
    }

    .home__hero-principle span {
      min-height: 1.7rem;
      padding-inline: 0.55rem;
    }

    .home__content {
      gap: 0.8rem;
    }

    .home__inspector {
      padding: 0.9rem;
      gap: 0.68rem;
    }

    .home__inspector-title {
      font-size: 0.96rem;
    }

    .home__inspector-body {
      font-size: 0.92rem;
      line-height: 1.5;
    }

    .home__system-panels {
      gap: 0.62rem;
    }

    .home__system-panel {
      padding: 0.72rem 0.78rem;
    }

    .home__system-copy {
      font-size: 0.91rem;
      line-height: 1.48;
    }

    .home__card {
      gap: 0.45rem;
    }

    .home__card-label {
      font-size: 0.66rem;
    }

    .home__card h3 {
      font-size: 1rem;
    }

    .home__card-body,
    .home__card-date,
    .home__card-id {
      display: none;
    }

    .home__status-row {
      align-items: flex-start;
      flex-direction: column;
      gap: 0.55rem;
    }

    .home__headline {
      font-size: clamp(2.4rem, 13vw, 3.8rem);
      line-height: 0.98;
    }

    .home__lead-actions {
      margin-top: 0.5rem;
    }

    .home__cta {
      min-width: 100%;
      padding: 0.9rem 1rem;
    }

    .home__cta-copy {
      max-width: none;
      font-size: 0.85rem;
    }

    .home__lede {
      max-width: none;
      font-size: 1rem;
      line-height: 1.65;
    }

  }
</style>

<script>
  import { GH_LOGO_ROLE_BY_CELL, getGhLogoFrame } from "operational-topology/labs";

  const root = document.documentElement;
  const worldSceneRoot = document.querySelector(".home__world-scene");
  const worldCellsPayload = worldSceneRoot?.querySelector(".topology-scene__cells");
  const introLogoNode = worldSceneRoot?.querySelector("[data-node-id='intro-logo']");

  const stateClasses = ["is-origin", "is-propagating", "is-receiving", "is-resolved"];
  const logoCellCache = new Map();

  const originHoldMs = 2200;
  const handoffFadeMs = 500;
  const logoStartDelayMs = 500;
  const logoAnimationOffsetMs = 1700;
  const desktopLogoDurationMs = 4600;

  let introAnimating = false;
  let logoFrameRaf = 0;
  let logoCleanupTimer = 0;

  const syncState = (state) => {
    root.dataset.homeIntroState = state;
  };


  const getLogoCells = () => worldCellsPayload ? JSON.parse(worldCellsPayload.textContent || "[]") : [];

  const applyLogoRoles = (cells) => {
    for (const cell of cells) {
      const role = GH_LOGO_ROLE_BY_CELL[cell.id];
      if (!role) continue;
      const elements = logoCellCache.get(cell.id);
      if (!elements) continue;
      const roleClass = role === "border" ? "is-logo-border" : role === "g" ? "is-logo-g" : "is-logo-h";
      for (const element of elements) {
        element.classList.add(roleClass);
        element.dataset.logoRole = role;
      }
    }
  };

  const collectLogoElements = (cells) => {
    if (logoCellCache.size > 0) {
      return logoCellCache;
    }

    for (const cell of cells) {
      const elements = Array.from(worldSceneRoot?.querySelectorAll(`[data-cell-id="${cell.id}"]`) ?? []);
      if (!elements.length) continue;
      logoCellCache.set(cell.id, elements);
    }

    applyLogoRoles(cells);

    return logoCellCache;
  };
  const applyLogoFrame = (frame) => {
    for (const state of frame.states) {
      const elements = logoCellCache.get(state.id);
      if (!elements) continue;
      for (const element of elements) {
        element.dataset.cellState = state.state;
        element.style.setProperty("--cell-intensity", String(state.intensity));
        for (const className of stateClasses) {
          element.classList.remove(className);
        }
        if (state.state === "origin") element.classList.add("is-origin");
        if (state.state === "propagating") element.classList.add("is-propagating");
        if (state.state === "receiving") element.classList.add("is-receiving");
        if (state.state === "resolved") element.classList.add("is-resolved");
        if (state.state !== "idle") {
          element.classList.add("is-active");
        } else {
          element.classList.remove("is-active");
        }
      }
    }
  };

  const clearLogoActivity = (cells) => {
    for (const cell of cells) {
      const elements = logoCellCache.get(cell.id);
      if (!elements) continue;
      for (const element of elements) {
        element.dataset.cellState = "idle";
        element.dataset.logoRole = "";
        element.classList.remove("is-active", "is-origin", "is-propagating", "is-receiving", "is-resolved", "is-logo-border", "is-logo-g", "is-logo-h");
        element.style.removeProperty("--cell-intensity");
        element.style.removeProperty("opacity");
        element.style.removeProperty("transform");
      }
    }
  };

  const fadeOutLogoActivity = (cells) => {
    for (const cell of cells) {
      const elements = logoCellCache.get(cell.id);
      if (!elements) continue;
      for (const element of elements) {
        element.style.opacity = "0";
        element.style.transform = "scale(0.985)";
      }
    }
  };

  const fadeIntroLogoNode = (hidden) => {
    if (!introLogoNode) return;
    introLogoNode.style.opacity = hidden ? "0" : "";
    introLogoNode.style.pointerEvents = hidden ? "none" : "";
  };

  const finishIntro = () => {
    if (logoFrameRaf) cancelAnimationFrame(logoFrameRaf);
    if (logoCleanupTimer) window.clearTimeout(logoCleanupTimer);
    clearLogoActivity(getLogoCells());
    introAnimating = false;
    syncState("done");
  };

  const playLogoAnimation = () => {
    if (!worldSceneRoot) {
      finishIntro();
      return;
    }

    const cells = getLogoCells();
    if (cells.length === 0) {
      finishIntro();
      return;
    }

    collectLogoElements(cells);

    const startedAt = performance.now();
    const duration = desktopLogoDurationMs;

    const tick = (now) => {
      const elapsed = now - startedAt + logoAnimationOffsetMs;
      applyLogoFrame(getGhLogoFrame(cells, elapsed, "border-reveal"));
      if (elapsed < duration) {
        logoFrameRaf = requestAnimationFrame(tick);
        return;
      }
      syncState("handoff");
      logoCleanupTimer = window.setTimeout(() => {
        finishIntro();
      }, handoffFadeMs);
    };
    logoFrameRaf = requestAnimationFrame(tick);
  };

  const startIntro = () => {
    if (introAnimating) return;
    introAnimating = true;
    syncState("signal");
    window.setTimeout(() => {
      syncState("logo");
      fadeIntroLogoNode(true);
      window.setTimeout(() => {
        playLogoAnimation();
      }, logoStartDelayMs);
    }, originHoldMs);
  };

  syncState("ready");

  worldSceneRoot?.addEventListener("click", (event) => {
    const target = event.target instanceof Element ? event.target.closest("[data-node-id='intro-logo']") : null;
    if (!target) return;
    startIntro();
  }, { passive: true });

  worldSceneRoot?.addEventListener("pointerdown", (event) => {
    const target = event.target instanceof Element ? event.target.closest("[data-node-id='intro-logo']") : null;
    if (!target) return;
    event.preventDefault();
    startIntro();
  });
</script>
