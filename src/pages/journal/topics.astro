---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import JournalTopology from "../../components/journal/JournalTopology.astro";
import {
  getJournalArchiveSummary,
  getJournalTopicSummaries,
} from "../../lib/journal";

const entries = await getCollection("entries", ({ data }) => data.language === "en");
const topicSummaries = getJournalTopicSummaries(entries);
const archiveSummary = getJournalArchiveSummary(entries);
---
<BaseLayout
  title="Journal Topics | thisisgenaro.com"
  description="The systems, practices, and operational questions that recur throughout the Journal."
>
  <JournalTopology class="journal-topology--topics" />
  <main class="journal-topics">
    <header class="journal-topics__header">
      <p class="journal-topics__eyebrow">JOURNAL</p>
      <h1 class="journal-topics__title">Topics</h1>
      <p class="journal-topics__description">
        The systems, practices, and operational questions that recur throughout the Journal.
      </p>
    </header>

    <div class="journal-topics__layout">
      <section class="journal-topics__main" aria-label="Topic index">
        {topicSummaries.map((topic) => (
          <article class="journal-topic-index-row">
            <div class="journal-topic-index-row__primary">
              <p class="journal-topic-index-row__label mono">{topic.name}</p>
              <h2 class="journal-topic-index-row__title">{topic.count} {topic.count === 1 ? "entry" : "entries"}</h2>
              <p class="journal-topic-index-row__description">
                {topic.description || "A recurring idea in the Journal."}
              </p>
            </div>
            <div class="journal-topic-index-row__secondary">
              <p class="journal-topic-index-row__latest mono">
                {topic.latestEntry ? `Latest: ${topic.latestEntry.data.title}` : "No entries yet"}
              </p>
              <a class="journal-topic-index-row__action mono" href={`/journal/topics/${topic.slug}`}>EXPLORE TOPIC →</a>
            </div>
          </article>
        ))}
      </section>

      <aside class="journal-topics__rail" aria-label="Topics sidebar">
        <section class="journal-rail-card surface surface-pad">
          <p class="journal-rail-card__label">ABOUT THE JOURNAL</p>
          <p class="journal-rail-card__body">
            Observations from infrastructure work—what failed, what held, and what the systems taught us.
          </p>
          <p class="journal-rail-card__body journal-rail-card__body--secondary">
            Thoughts come first. Context lives inside each entry.
          </p>
        </section>

        <section class="journal-rail-card surface surface-pad">
          <p class="journal-rail-card__label">ARCHIVE SUMMARY</p>
          <p class="journal-rail-card__total mono">{archiveSummary.totalLabel}</p>
          <p class="journal-rail-card__body">
            {archiveSummary.fromLabel} {archiveSummary.toLabel}
          </p>
          <a class="journal-rail-card__link mono" href="/journal/entries">VIEW ALL ENTRIES →</a>
        </section>
      </aside>
    </div>
  </main>
</BaseLayout>

<style>
  .journal-topics {
    position: relative;
    z-index: 1;
    width: min(100%, 84rem);
    margin: 0 auto;
    padding: clamp(1rem, 3.5vw, 2.5rem);
  }

  .journal-topics__header {
    display: grid;
    gap: 0.55rem;
    max-width: 42rem;
    margin-bottom: clamp(1.3rem, 3vw, 2rem);
    padding-bottom: 1rem;
    border-bottom: 1px solid color-mix(in srgb, var(--line-strong) 52%, transparent);
  }

  .journal-topics__eyebrow,
  .journal-topic-index-row__label,
  .journal-topic-index-row__latest,
  .journal-topic-index-row__action,
  .journal-rail-card__label,
  .journal-rail-card__link,
  .journal-rail-card__total {
    font-family: var(--font-mono);
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .journal-topics__eyebrow {
    margin: 0;
    color: var(--accent);
    font-size: 0.72rem;
    font-weight: 700;
  }

  .journal-topics__title {
    margin: 0;
    font-size: clamp(2.9rem, 7vw, 5.2rem);
    line-height: 0.94;
    letter-spacing: -0.07em;
  }

  .journal-topics__description {
    max-width: 44rem;
    margin: 0;
    color: var(--muted);
    font-size: clamp(1rem, 1.4vw, 1.15rem);
    line-height: 1.72;
  }

  .journal-topics__layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(18rem, 20rem);
    gap: clamp(1rem, 2.4vw, 1.8rem);
    align-items: start;
  }

  .journal-topics__main {
    min-width: 0;
  }

  .journal-topic-index-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(16rem, 18rem);
    gap: 1.2rem;
    padding: 1rem 0;
    border-top: 1px solid color-mix(in srgb, var(--line-strong) 52%, transparent);
  }

  .journal-topic-index-row:last-child {
    border-bottom: 1px solid color-mix(in srgb, var(--line-strong) 52%, transparent);
  }

  .journal-topic-index-row__primary {
    display: grid;
    gap: 0.35rem;
  }

  .journal-topic-index-row__label {
    margin: 0;
    color: var(--accent);
    font-size: 0.7rem;
    font-weight: 700;
  }

  .journal-topic-index-row__title {
    margin: 0;
    font-size: 1.15rem;
    line-height: 1.26;
  }

  .journal-topic-index-row__description {
    max-width: 36rem;
    margin: 0;
    color: var(--muted);
    line-height: 1.62;
  }

  .journal-topic-index-row__secondary {
    display: grid;
    align-content: start;
    gap: 0.55rem;
    justify-items: start;
  }

  .journal-topic-index-row__latest {
    margin: 0;
    color: var(--text);
    font-size: 0.68rem;
    font-weight: 700;
    line-height: 1.6;
  }

  .journal-topic-index-row__action {
    color: var(--accent);
    font-size: 0.68rem;
    font-weight: 700;
    text-decoration: none;
  }

  .journal-topics__rail {
    display: grid;
    gap: 1rem;
  }

  .journal-rail-card {
    display: grid;
    gap: 0.8rem;
    border: 1px solid color-mix(in srgb, var(--line-strong) 72%, transparent);
    background: color-mix(in srgb, var(--surface) 84%, transparent);
  }

  .journal-rail-card__label {
    margin: 0;
    color: var(--accent);
    font-size: 0.7rem;
    font-weight: 700;
  }

  .journal-rail-card__body {
    margin: 0;
    color: var(--text);
    line-height: 1.65;
  }

  .journal-rail-card__body--secondary {
    color: var(--muted);
  }

  .journal-rail-card__total {
    margin: 0;
    color: var(--accent);
    font-size: 0.82rem;
    font-weight: 700;
  }

  .journal-rail-card__link {
    width: fit-content;
    color: var(--accent);
    font-size: 0.68rem;
    font-weight: 700;
    text-decoration: none;
  }

  @media (max-width: 1024px) {
    .journal-topics__layout {
      grid-template-columns: 1fr;
    }

    .journal-topics__rail {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 720px) {
    .journal-topics {
      width: 100%;
      padding: 0.95rem;
    }

    .journal-topics__title {
      font-size: clamp(2.4rem, 11vw, 3.8rem);
    }

    .journal-topic-index-row,
    .journal-topics__rail {
      grid-template-columns: 1fr;
    }

    .journal-topic-index-row__secondary {
      gap: 0.45rem;
    }
  }
</style>
