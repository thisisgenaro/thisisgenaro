---
import { getCollection } from "astro:content";
import JournalTopicPage from "../../../components/JournalTopicPage.astro";
import {
  getJournalEntriesForLanguage,
  getJournalTopicSummaries,
  normalizeJournalTopicSlug,
} from "../../../lib/journal";

export async function getStaticPaths() {
  const entries = getJournalEntriesForLanguage(await getCollection("entries"), "en");
  return getJournalTopicSummaries(entries).map((topic) => ({
    params: { topic: topic.slug },
  }));
}

const topicSlug = normalizeJournalTopicSlug(Astro.params.topic ?? "");
const entries = getJournalEntriesForLanguage(await getCollection("entries"), "en");
---

<JournalTopicPage locale="en" entries={entries} topicSlug={topicSlug} />
