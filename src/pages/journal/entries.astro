---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";
import JournalTopology from "../../components/journal/JournalTopology.astro";
import {
  buildPageNumbers,
  createJournalEntryRecords,
  getJournalArchiveSummary,
  getJournalTopicSummaries,
  sortJournalEntries,
} from "../../lib/journal";

const entries = await getCollection("entries", ({ data }) => data.language === "en");
const records = createJournalEntryRecords(entries);
const topicSummaries = getJournalTopicSummaries(entries);
const archiveSummary = getJournalArchiveSummary(entries);
const initialRecords = sortJournalEntries(records, "newest");
const pageSize = 10;
const initialPageNumbers = buildPageNumbers(1, Math.max(1, Math.ceil(initialRecords.length / pageSize)));
---
<BaseLayout
  title="All Entries | Journal | thisisgenaro.com"
  description="Notes, observations, and lessons collected from the work—across systems, incidents, and the decisions in between."
>
  <JournalTopology class="journal-topology--archive" />
  <main class="journal-archive" data-journal-archive>
    <header class="journal-archive__header">
      <p class="journal-archive__eyebrow">JOURNAL</p>
      <h1 class="journal-archive__title">All Entries</h1>
      <p class="journal-archive__description">
        Notes, observations, and lessons collected from the work—across systems, incidents, and the decisions in between.
      </p>
    </header>

    <div class="journal-archive__layout">
      <section class="journal-archive__main" aria-label="Journal archive controls and entries">
        <section class="journal-archive__controls surface surface-pad">
          <label class="journal-archive__search">
            <span class="journal-archive__label mono">SEARCH</span>
            <input type="search" placeholder="Search entries..." autocomplete="off" spellcheck="false" data-journal-search />
          </label>

          <div class="journal-archive__filters" role="toolbar" aria-label="Topic filters">
            <span class="journal-archive__label mono">TOPICS</span>
            <div class="journal-archive__filter-list">
              <button class="journal-archive__filter is-selected" type="button" data-journal-topic-filter="all" aria-pressed="true">All Topics</button>
              {topicSummaries.map((topic) => (
                <button
                  class:list={[
                    "journal-archive__filter",
                    topic.count === 0 && "is-muted",
                  ]}
                  type="button"
                  data-journal-topic-filter={topic.slug}
                  aria-pressed="false"
                >
                  {topic.name}
                </button>
              ))}
            </div>
          </div>

          <label class="journal-archive__sort">
            <span class="journal-archive__label mono">SORT</span>
            <select data-journal-sort>
              <option value="newest">Newest</option>
              <option value="oldest">Oldest</option>
            </select>
          </label>
        </section>

        <div class="journal-archive__results-head">
          <p class="journal-archive__results-count mono" data-journal-results-count>{archiveSummary.totalLabel}</p>
        </div>

        <section class="journal-archive__list" data-journal-results aria-label="Journal entries">
          {initialRecords.length ? initialRecords.map((record) => (
            <a
              class="journal-archive__row"
              href={record.href}
              data-journal-item
              data-date={record.publishedAt.getTime()}
              data-topics={record.topicSlugs.join(" ")}
              data-search={record.searchText}
              data-title={record.title}
              data-summary={record.excerpt}
            >
              <span class="journal-archive__row-date mono">{record.publishedLabel.toUpperCase()}</span>
              <span class="journal-archive__row-body">
                <span class="journal-archive__row-title">{record.title}</span>
                <span class="journal-archive__row-excerpt">{record.excerpt}</span>
                {record.topicDefinitions.length ? (
                  <span class="journal-archive__row-topics">
                    {record.topicDefinitions.map((topic) => <span class="journal-archive__chip">{topic.name}</span>)}
                  </span>
                ) : null}
              </span>
              <span class="journal-archive__row-meta mono">
                {record.readTime ? <span>{record.readTime} MIN READ</span> : <span></span>}
                <span aria-hidden="true">→</span>
              </span>
            </a>
          )) : (
            <article class="journal-archive__empty surface surface-pad" data-journal-empty>
              <p class="journal-archive__empty-title">No entries have been published yet.</p>
            </article>
          )}
        </section>

        <nav class="journal-archive__pager" aria-label="Pagination" data-journal-pager>
          {initialPageNumbers.length > 1 ? (
            <>
              <button class="journal-archive__pager-button" type="button" data-page-nav="prev">Previous</button>
              {initialPageNumbers.map((page) => (
                <button class="journal-archive__pager-button is-page" type="button" data-page-nav={String(page)}>{page}</button>
              ))}
              <button class="journal-archive__pager-button" type="button" data-page-nav="next">Next</button>
            </>
          ) : null}
        </nav>
      </section>

      <aside class="journal-archive__rail" aria-label="Archive sidebar">
        <section class="journal-rail-card surface surface-pad">
          <p class="journal-rail-card__label">ABOUT THE JOURNAL</p>
          <p class="journal-rail-card__body">
            Observations from infrastructure work—what failed, what held, and what the systems taught us.
          </p>
          <p class="journal-rail-card__body journal-rail-card__body--secondary">
            Thoughts come first. Context lives inside each entry.
          </p>
        </section>

        <section class="journal-rail-card surface surface-pad">
          <div class="journal-rail-card__head">
            <p class="journal-rail-card__label">EXPLORE TOPICS</p>
            <a class="journal-rail-card__link mono" href="/journal/topics">VIEW ALL TOPICS →</a>
          </div>
          <div class="journal-topics">
            {topicSummaries.map((topic) => (
              <a class:list={[
                "journal-topic-row",
                topic.count === 0 && "is-muted",
              ]} href={`/journal/topics/${topic.slug}`} aria-label={`${topic.name} topic, ${topic.count} entries`}>
                <span class="journal-topic-row__name">{topic.name}</span>
                <span class="journal-topic-row__count mono">{topic.count}</span>
              </a>
            ))}
          </div>
        </section>

        <section class="journal-rail-card journal-rail-card--summary surface surface-pad">
          <p class="journal-rail-card__label">ARCHIVE SUMMARY</p>
          <p class="journal-rail-card__total mono">{archiveSummary.totalLabel}</p>
          <p class="journal-rail-card__body">
            {archiveSummary.fromLabel} {archiveSummary.toLabel}
          </p>
        </section>
      </aside>
    </div>
  </main>
</BaseLayout>

<script>
  const root = document.querySelector("[data-journal-archive]");

  if (root) {
    const list = root.querySelector("[data-journal-results]");
    const resultsCount = root.querySelector("[data-journal-results-count]");
    const emptyState = root.querySelector("[data-journal-empty]");
    const searchInput = root.querySelector("[data-journal-search]");
    const sortSelect = root.querySelector("[data-journal-sort]");
    const topicButtons = Array.from(root.querySelectorAll("[data-journal-topic-filter]"));
    const pager = root.querySelector("[data-journal-pager]");
    const pageSize = 10;

    const items = Array.from(list?.querySelectorAll("[data-journal-item]") ?? []).map((element) => ({
      element,
      date: Number(element.dataset.date ?? 0),
      topics: (element.dataset.topics ?? "").split(/\s+/).filter(Boolean),
      search: (element.dataset.search ?? "").toLowerCase(),
    }));

    const state = {
      q: "",
      topic: "all",
      sort: "newest",
      page: 1,
    };

    const pageSequence = (current, total) => {
      if (total <= 1) return [1];
      const pages = new Set([1, total, current, current - 1, current + 1]);
      return Array.from(pages).filter((page) => page >= 1 && page <= total).sort((a, b) => a - b);
    };

    const readStateFromUrl = () => {
      const url = new URL(window.location.href);
      return {
        q: url.searchParams.get("q") ?? "",
        topic: url.searchParams.get("topic") ?? "all",
        sort: url.searchParams.get("sort") === "oldest" ? "oldest" : "newest",
        page: Math.max(1, Number(url.searchParams.get("page") ?? "1") || 1),
      };
    };

    const writeStateToUrl = (mode = "push") => {
      const url = new URL(window.location.href);
      if (state.q) url.searchParams.set("q", state.q);
      else url.searchParams.delete("q");
      if (state.topic && state.topic !== "all") url.searchParams.set("topic", state.topic);
      else url.searchParams.delete("topic");
      if (state.sort && state.sort !== "newest") url.searchParams.set("sort", state.sort);
      else url.searchParams.delete("sort");
      if (state.page > 1) url.searchParams.set("page", String(state.page));
      else url.searchParams.delete("page");

      const historyState = { ...state };
      if (mode === "replace") {
        window.history.replaceState(historyState, "", url);
      } else {
        window.history.pushState(historyState, "", url);
      }
    };

    const syncControls = () => {
      if (searchInput instanceof HTMLInputElement) searchInput.value = state.q;
      if (sortSelect instanceof HTMLSelectElement) sortSelect.value = state.sort;
      topicButtons.forEach((button) => {
        const topic = button.dataset.journalTopicFilter ?? "all";
        const selected = topic === state.topic || (!state.topic && topic === "all");
        button.classList.toggle("is-selected", selected);
        button.setAttribute("aria-pressed", String(selected));
      });
    };

    const renderPager = (totalPages) => {
      if (!(pager instanceof HTMLElement)) return;
      pager.innerHTML = "";
      if (totalPages <= 1) {
        pager.hidden = true;
        return;
      }

      pager.hidden = false;
      const fragment = document.createDocumentFragment();
      const addButton = (label, page, disabled = false, current = false) => {
        const button = document.createElement("button");
        button.type = "button";
        button.className = "journal-archive__pager-button" + (current ? " is-page is-current" : "");
        button.textContent = label;
        button.disabled = disabled;
        if (!disabled) {
          button.dataset.pageNav = String(page);
        }
        if (current) {
          button.setAttribute("aria-current", "page");
        }
        fragment.appendChild(button);
      };

      const addEllipsis = () => {
        const span = document.createElement("span");
        span.className = "journal-archive__pager-ellipsis mono";
        span.textContent = "…";
        fragment.appendChild(span);
      };

      addButton("Previous", Math.max(1, state.page - 1), state.page === 1);
      const sequence = pageSequence(state.page, totalPages);
      let last = 0;
      sequence.forEach((page) => {
        if (page - last > 1) {
          addEllipsis();
        }
        addButton(String(page), page, false, page === state.page);
        last = page;
      });
      addButton("Next", Math.min(totalPages, state.page + 1), state.page === totalPages);
      pager.appendChild(fragment);
    };

    const render = (mode = "replace") => {
      const normalizedQuery = state.q.trim().toLowerCase();
      const normalizedTopic = state.topic === "all" ? "" : state.topic;
      const filtered = items.filter((item) => {
        const topicMatch = !normalizedTopic || item.topics.includes(normalizedTopic);
        const searchMatch = !normalizedQuery || item.search.includes(normalizedQuery);
        return topicMatch && searchMatch;
      });

      const sorted = [...items].sort((left, right) => {
        return state.sort === "oldest" ? left.date - right.date : right.date - left.date;
      });

      list?.append(...sorted.map((item) => item.element));

      const totalPages = Math.max(1, Math.ceil(filtered.length / pageSize));
      if (state.page > totalPages) {
        state.page = totalPages;
      }

      const visibleStart = (state.page - 1) * pageSize;
      const visibleEnd = visibleStart + pageSize;
      const visible = new Set(filtered.slice(visibleStart, visibleEnd).map((item) => item.element));

      items.forEach((item) => {
        item.element.hidden = !visible.has(item.element) || filtered.indexOf(item) === -1;
      });

      if (resultsCount instanceof HTMLElement) {
        const total = filtered.length;
        const label = `${total} ${total === 1 ? "result" : "results"}`;
        resultsCount.textContent = total === items.length ? `${items.length} ${items.length === 1 ? "entry" : "entries"}` : label;
      }

      if (emptyState instanceof HTMLElement) {
        emptyState.hidden = filtered.length > 0;
      }

      syncControls();
      renderPager(totalPages);
      writeStateToUrl(mode);
    };

    const setState = (next, mode = "push") => {
      Object.assign(state, next);
      render(mode);
    };

    Object.assign(state, readStateFromUrl());
    render("replace");

    searchInput?.addEventListener("input", (event) => {
      const value = event.target instanceof HTMLInputElement ? event.target.value : "";
      state.q = value;
      state.page = 1;
      render("replace");
    });

    sortSelect?.addEventListener("change", (event) => {
      const value = event.target instanceof HTMLSelectElement ? event.target.value : "newest";
      state.sort = value === "oldest" ? "oldest" : "newest";
      state.page = 1;
      render();
    });

    topicButtons.forEach((button) => {
      button.addEventListener("click", () => {
        state.topic = button.dataset.journalTopicFilter ?? "all";
        state.page = 1;
        render();
      });
    });

    pager?.addEventListener("click", (event) => {
      const target = event.target instanceof HTMLElement ? event.target.closest("[data-page-nav]") : null;
      if (!target) return;
      const pageValue = target.getAttribute("data-page-nav");
      if (!pageValue) return;
      if (pageValue === "prev") {
        state.page = Math.max(1, state.page - 1);
      } else if (pageValue === "next") {
        const totalPages = Math.max(1, Math.ceil(items.filter((item) => {
          const normalizedQuery = state.q.trim().toLowerCase();
          const normalizedTopic = state.topic === "all" ? "" : state.topic;
          const topicMatch = !normalizedTopic || item.topics.includes(normalizedTopic);
          const searchMatch = !normalizedQuery || item.search.includes(normalizedQuery);
          return topicMatch && searchMatch;
        }).length / pageSize));
        state.page = Math.min(totalPages, state.page + 1);
      } else {
        state.page = Number(pageValue) || 1;
      }
      render();
    });

    window.addEventListener("popstate", () => {
      Object.assign(state, readStateFromUrl());
      render("replace");
    });
  }
</script>

<style>
  .journal-archive {
    position: relative;
    z-index: 1;
    width: min(100%, 84rem);
    margin: 0 auto;
    padding: clamp(1rem, 3.5vw, 2.5rem);
  }

  .journal-archive__header {
    display: grid;
    gap: 0.55rem;
    max-width: 46rem;
    margin-bottom: clamp(1.3rem, 3vw, 2rem);
    padding-bottom: 1rem;
    border-bottom: 1px solid color-mix(in srgb, var(--line-strong) 52%, transparent);
  }

  .journal-archive__eyebrow,
  .journal-archive__label,
  .journal-archive__results-count,
  .journal-archive__pager-button,
  .journal-rail-card__label,
  .journal-rail-card__link,
  .journal-rail-card__total,
  .journal-topic-row__count {
    font-family: var(--font-mono);
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .journal-archive__eyebrow {
    margin: 0;
    color: var(--accent);
    font-size: 0.72rem;
    font-weight: 700;
  }

  .journal-archive__title {
    margin: 0;
    font-size: clamp(2.9rem, 7vw, 5.2rem);
    line-height: 0.94;
    letter-spacing: -0.07em;
  }

  .journal-archive__description {
    max-width: 46rem;
    margin: 0;
    color: var(--muted);
    font-size: clamp(1rem, 1.4vw, 1.15rem);
    line-height: 1.72;
  }

  .journal-archive__layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(18rem, 20rem);
    gap: clamp(1rem, 2.4vw, 1.8rem);
    align-items: start;
  }

  .journal-archive__main {
    min-width: 0;
    display: grid;
    gap: 1rem;
  }

  .journal-archive__controls {
    display: grid;
    grid-template-columns: minmax(0, 1.6fr) minmax(16rem, 1fr) minmax(8rem, 12rem);
    gap: 1rem;
    border: 1px solid color-mix(in srgb, var(--line-strong) 72%, transparent);
    background: color-mix(in srgb, var(--surface) 84%, transparent);
  }

  .journal-archive__search,
  .journal-archive__sort {
    display: grid;
    gap: 0.45rem;
  }

  .journal-archive__search input,
  .journal-archive__sort select {
    width: 100%;
    min-height: 2.75rem;
    padding: 0.65rem 0.85rem;
    border: 1px solid color-mix(in srgb, var(--line-strong) 72%, transparent);
    background: color-mix(in srgb, var(--surface-high) 52%, transparent);
    color: var(--text);
    font: inherit;
  }

  .journal-archive__search input::placeholder {
    color: var(--muted-dim);
  }

  .journal-archive__filters {
    display: grid;
    gap: 0.45rem;
  }

  .journal-archive__filter-list {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
  }

  .journal-archive__filter {
    display: inline-flex;
    align-items: center;
    min-height: 2.1rem;
    padding: 0.25rem 0.7rem;
    border: 1px solid color-mix(in srgb, var(--line-strong) 72%, transparent);
    background: color-mix(in srgb, var(--surface-high) 44%, transparent);
    color: var(--text);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    cursor: pointer;
  }

  .journal-archive__filter.is-selected {
    border-color: color-mix(in srgb, var(--accent) 44%, transparent);
    color: var(--accent);
    background: color-mix(in srgb, var(--accent-soft) 42%, transparent);
  }

  .journal-archive__filter.is-muted {
    opacity: 0.56;
  }

  .journal-archive__results-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .journal-archive__results-count {
    margin: 0;
    color: var(--accent);
    font-size: 0.68rem;
    font-weight: 700;
  }

  .journal-archive__list {
    display: grid;
    border-top: 1px solid color-mix(in srgb, var(--line-strong) 52%, transparent);
  }

  .journal-archive__row {
    display: grid;
    grid-template-columns: 9rem minmax(0, 1fr) auto;
    gap: 1rem;
    align-items: start;
    padding: 0.95rem 0;
    border-bottom: 1px solid color-mix(in srgb, var(--line-strong) 52%, transparent);
    color: var(--text);
    text-decoration: none;
  }

  .journal-archive__row-date,
  .journal-archive__row-meta {
    color: var(--accent);
    font-size: 0.68rem;
    font-weight: 700;
  }

  .journal-archive__row-body {
    min-width: 0;
    display: grid;
    gap: 0.3rem;
  }

  .journal-archive__row-title {
    font-size: 1.05rem;
    line-height: 1.32;
    letter-spacing: -0.03em;
  }

  .journal-archive__row-excerpt {
    margin: 0;
    color: var(--muted);
    line-height: 1.6;
  }

  .journal-archive__row-topics {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-top: 0.2rem;
  }

  .journal-archive__chip {
    display: inline-flex;
    align-items: center;
    min-height: 1.6rem;
    padding: 0.12rem 0.52rem;
    border: 1px solid color-mix(in srgb, var(--line-strong) 68%, transparent);
    border-radius: 999px;
    color: var(--muted);
    font-size: 0.62rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .journal-archive__row-meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    justify-content: flex-end;
    white-space: nowrap;
  }

  .journal-archive__empty {
    border: 1px solid color-mix(in srgb, var(--line-strong) 72%, transparent);
    background: color-mix(in srgb, var(--surface) 84%, transparent);
  }

  .journal-archive__empty-title {
    margin: 0;
    color: var(--muted);
  }

  .journal-archive__pager {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    align-items: center;
    justify-content: center;
    padding-top: 0.5rem;
  }

  .journal-archive__pager-button,
  .journal-archive__pager-ellipsis {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.1rem;
    padding: 0.25rem 0.7rem;
    border: 1px solid color-mix(in srgb, var(--line-strong) 72%, transparent);
    background: color-mix(in srgb, var(--surface-high) 42%, transparent);
    color: var(--text);
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .journal-archive__pager-button.is-current {
    border-color: color-mix(in srgb, var(--accent) 44%, transparent);
    color: var(--accent);
    background: color-mix(in srgb, var(--accent-soft) 44%, transparent);
  }

  .journal-archive__pager-button:disabled {
    opacity: 0.45;
  }

  .journal-archive__pager-ellipsis {
    border-color: transparent;
    background: transparent;
    color: var(--muted);
  }

  .journal-archive__rail {
    display: grid;
    gap: 1rem;
    align-content: start;
  }

  .journal-rail-card {
    display: grid;
    gap: 0.8rem;
    border: 1px solid color-mix(in srgb, var(--line-strong) 72%, transparent);
    background: color-mix(in srgb, var(--surface) 84%, transparent);
  }

  .journal-rail-card__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .journal-rail-card__label {
    margin: 0;
    color: var(--accent);
    font-size: 0.7rem;
    font-weight: 700;
  }

  .journal-rail-card__body {
    margin: 0;
    color: var(--text);
    line-height: 1.65;
  }

  .journal-rail-card__body--secondary {
    color: var(--muted);
  }

  .journal-rail-card__total {
    margin: 0;
    color: var(--accent);
    font-size: 0.82rem;
    font-weight: 700;
  }

  .journal-rail-card__link {
    width: fit-content;
    color: var(--accent);
    font-size: 0.68rem;
    font-weight: 700;
    text-decoration: none;
  }

  .journal-topics {
    display: grid;
  }

  .journal-topic-row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 1rem;
    align-items: center;
    padding: 0.55rem 0;
    border-top: 1px solid color-mix(in srgb, var(--line-strong) 46%, transparent);
    color: var(--text);
    text-decoration: none;
  }

  .journal-topic-row:last-child {
    border-bottom: 1px solid color-mix(in srgb, var(--line-strong) 46%, transparent);
  }

  .journal-topic-row.is-muted {
    opacity: 0.48;
  }

  .journal-topic-row__name {
    min-width: 0;
    font-size: 0.96rem;
  }

  .journal-topic-row__count {
    color: var(--accent);
    font-size: 0.68rem;
    font-weight: 700;
  }

  @media (max-width: 1024px) {
    .journal-archive__layout {
      grid-template-columns: 1fr;
    }

    .journal-archive__rail {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .journal-rail-card--summary {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 720px) {
    .journal-archive {
      width: 100%;
      padding: 0.95rem;
    }

    .journal-archive__title {
      font-size: clamp(2.4rem, 11vw, 3.8rem);
    }

    .journal-archive__controls {
      grid-template-columns: 1fr;
    }

    .journal-archive__layout,
    .journal-archive__rail,
    .journal-archive__row {
