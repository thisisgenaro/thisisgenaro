---
import ThemeSwitcher from "operational-topology/astro/ThemeSwitcher";
import {
  colorVisionStorageKey,
  contrastStorageKey,
  defaultTheme as frameworkDefaultTheme,
  glowStorageKey,
  themeNames,
  themeStorageKey,
} from "operational-topology";

import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "thisisgenaro.com",
  description = "Design, automate, and keep things running.",
} = Astro.props;

const pathname = Astro.url.pathname;

const navItems = [
  { href: "/", label: "Home" },
  { href: "/journal", label: "Journal" },
  { href: "/incidents", label: "Incidents" },
  { href: "/about", label: "About" },
  { href: "/about/cv", label: "CV" },
];

const isActive = (href: string) => {
  if (href === "/") return pathname === "/";
  if (href === "/about") return pathname === "/about";
  return pathname === href || pathname.startsWith(`${href}/`);
};

const themeBootstrap =
  "(() => {" +
  "const themes=" + JSON.stringify(themeNames) + ";" +
  "const fallback=" + JSON.stringify(frameworkDefaultTheme) + ";" +
  "try {" +
  "const stored=localStorage.getItem(" + JSON.stringify(themeStorageKey) + ");" +
  "document.documentElement.dataset.theme=themes.includes(stored)?stored:fallback;" +
  "document.documentElement.dataset.glow=localStorage.getItem(" + JSON.stringify(glowStorageKey) + ")==='true'?'reduced':'standard';" +
  "document.documentElement.dataset.contrast=localStorage.getItem(" + JSON.stringify(contrastStorageKey) + ")==='true'?'high':'standard';" +
  "document.documentElement.dataset.colorVision=localStorage.getItem(" + JSON.stringify(colorVisionStorageKey) + ")==='true'?'safe':'standard';" +
  "} catch {document.documentElement.dataset.theme=fallback;document.documentElement.dataset.glow='standard';document.documentElement.dataset.contrast='standard';document.documentElement.dataset.colorVision='standard';}" +
  "})();";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0b0f14" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <script is:inline set:html={themeBootstrap}></script>
    <title>{title}</title>
    <slot name="head" />
  </head>
  <body>
    <div class="shell">
      <header class="shell__header surface surface-pad">
        <div class="shell__primary-row">
          <a class="shell__brand" href="/" aria-label="Home">
            <img class="shell__brand-image" src="/gh-logo.png" alt="" />
          </a>

          <nav class="shell__links" id="site-primary-nav" aria-label="Primary">
            {navItems.map((item) => (
              <a href={item.href} aria-current={isActive(item.href) ? "page" : undefined} class:list={{ "is-active": isActive(item.href) }}>
                {item.label}
              </a>
            ))}
          </nav>
        </div>

        <button class="shell__menu-toggle" type="button" aria-expanded="false" aria-controls="site-primary-nav">
          <span class="shell__menu-icon" aria-hidden="true">
            <span></span>
            <span></span>
            <span></span>
          </span>
          <span class="shell__menu-label">Menu</span>
        </button>
      </header>

      <slot />
    </div>
    <ThemeSwitcher />
    <script>
      if (import.meta.env.DEV) {
        import("operational-topology/browser").then(({ installDeveloperAPI }) => {
          installDeveloperAPI();
        });
      }
    </script>
    <script>
      const nav = document.querySelector<HTMLElement>(".shell__header");
      const toggle = document.querySelector<HTMLButtonElement>(".shell__menu-toggle");

      toggle?.addEventListener("click", () => {
        const nextOpen = !nav?.classList.contains("is-open");
        nav?.classList.toggle("is-open", nextOpen);
        toggle.setAttribute("aria-expanded", String(nextOpen));
      });

      document.addEventListener("click", (event) => {
        if (!nav || !toggle || nav.contains(event.target as Node) || toggle.contains(event.target as Node)) return;
        nav.classList.remove("is-open");
        toggle.setAttribute("aria-expanded", "false");
      });

      document.addEventListener("keydown", (event) => {
        if (event.key !== "Escape" || !nav || !toggle) return;
        nav.classList.remove("is-open");
        toggle.setAttribute("aria-expanded", "false");
      });
    </script>
  </body>
</html>

<style>
  .shell {
    width: min(calc(100% - 2rem), var(--content-wide));
    margin: 0 auto;
    padding: 0 0 2rem;
  }

  .shell__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1rem;
    border-radius: 0;
    padding-inline: 1rem;
    background: linear-gradient(180deg, color-mix(in srgb, var(--surface-2) 80%, transparent), color-mix(in srgb, var(--surface) 68%, transparent));
    border-color: color-mix(in srgb, var(--line-strong) 60%, transparent);
    box-shadow: 0 12px 28px rgba(0, 0, 0, 0.18);
  }

  .shell__primary-row {
    display: flex;
    align-items: center;
    justify-content: flex-start;
    gap: 1rem;
    min-width: 0;
    flex: 1 1 auto;
  }

  .shell__brand {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: none;
    width: 3.6rem;
    aspect-ratio: 1;
    padding: 0;
    border: 0;
    border-radius: 0;
    background: transparent;
    box-shadow: none;
  }

  .shell__brand-image {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }




  .shell__menu-toggle {
    display: none;
    align-items: center;
    gap: 0.55rem;
    min-height: 2.3rem;
    padding: 0.38rem 0.7rem;
    border: 1px solid color-mix(in srgb, var(--line-strong) 55%, transparent);
    border-radius: 0;
    background: transparent;
    color: var(--text);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    transition: border-color 180ms ease, background 180ms ease, transform 180ms ease, box-shadow 180ms ease;
  }

  .shell__menu-icon {
    display: grid;
    gap: 0.22rem;
    width: 1rem;
  }

  .shell__menu-icon span {
    display: block;
    width: 100%;
    height: 1px;
    background: currentColor;
  }

  .shell__links {
    align-items: center;
    justify-content: flex-start;
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
    font-family: var(--font-mono);
    font-size: 0.74rem;
    letter-spacing: 0.14em;
  }

  .shell__links a {
    display: inline-flex;
    align-items: center;
    min-height: 2.1rem;
    padding: 0.2rem 0.05rem;
    color: var(--text);
    border-bottom: 1px solid transparent;
    border-radius: 0;
    background: transparent;
    font-family: var(--font-mono);
    font-size: 0.74rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    transition: border-color 180ms ease, color 180ms ease, transform 180ms ease, box-shadow 180ms ease;
  }

  .shell__links a:hover,
  .shell__links a:focus-visible {
    transform: translateY(-1px);
    border-bottom-color: color-mix(in srgb, var(--accent) 70%, transparent);
    color: var(--accent);
  }

  .shell__brand:focus-visible,
  .shell__menu-toggle:focus-visible,
  .shell__links a:focus-visible {
    outline: 2px solid color-mix(in srgb, var(--accent) 70%, white);
    outline-offset: 3px;
  }

  .shell__links a.is-active,
  .shell__links a[aria-current="page"] {
    color: var(--accent);
    border-bottom-color: color-mix(in srgb, var(--accent) 85%, transparent);
  }

  @media (max-width: 980px) {
    .shell__header {
      align-items: center;
      flex-direction: row;
      flex-wrap: wrap;
      gap: 0.75rem;
      padding-inline: 0.9rem;
    }

    .shell__primary-row {
      width: auto;
      align-items: center;
      flex: 1 1 auto;
    }

    .shell__menu-toggle {
      margin-left: auto;
    }
  }

  @media (max-width: 680px) {
    .shell {
      width: min(calc(100% - 1rem), var(--content-wide));
      padding-top: 0;
    }

    .shell__primary-row {
      align-items: center;
      gap: 0.85rem;
    }

    .shell__menu-toggle {
      display: inline-flex;
      margin-left: auto;
      align-self: center;
    }

    .shell__links {
      display: none;
      width: 100%;
      flex-direction: column;
      gap: 0.15rem;
      padding-top: 0.1rem;
    }

    .shell__links a {
      width: 100%;
      padding: 0.65rem 0;
      border-bottom-color: color-mix(in srgb, var(--line) 88%, transparent);
    }

    .shell__header.is-open .shell__links {
      display: flex;
    }
  }
</style>
