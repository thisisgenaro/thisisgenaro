---
import ThemeSwitcher from "operational-topology/astro/ThemeSwitcher";
import {
  colorVisionStorageKey,
  contrastStorageKey,
  defaultTheme as frameworkDefaultTheme,
  glowStorageKey,
  themeNames,
  themeStorageKey,
} from "operational-topology";

import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "thisisgenaro.com",
  description = "Design, automate, and keep things running.",
} = Astro.props;

const pathname = Astro.url.pathname;
const railStateStorageKey = "thisisgenaro:shell-rail-collapsed";

const navItems = [
  {
    href: "/",
    label: "Home",
    iconPath: "M4.5 11.5 12 5l7.5 6.5M7 10.5V19h10v-8.5",
  },
  {
    href: "/journal",
    label: "Journal",
    iconPath: "M7 4h8l2.5 2.5V20H7a3 3 0 0 1-3-3V7a3 3 0 0 1 3-3zm8 0v3h3M8 10h8M8 14h6M8 18h4",
  },
  {
    href: "/incidents",
    label: "Incidents",
    iconPath: "M12 4l7.5 13H4.5L12 4zm0 5.5v4m0 3h.01",
  },
  {
    href: "/about",
    label: "About",
    iconPath: "M12 13a4 4 0 1 0 0-8 4 4 0 0 0 0 8zM5.5 20c1.8-3 4.3-4.5 6.5-4.5s4.7 1.5 6.5 4.5",
  },
];

const isActive = (href: string) => {
  if (href === "/") return pathname === "/";
  if (href === "/about") return pathname === "/about";
  return pathname === href || pathname.startsWith(`${href}/`);
};

const themeBootstrap =
  "(() => {" +
  "const themes=" + JSON.stringify(themeNames) + ";" +
  "const fallback=" + JSON.stringify(frameworkDefaultTheme) + ";" +
  "try {" +
  "const stored=localStorage.getItem(" + JSON.stringify(themeStorageKey) + ");" +
  "document.documentElement.dataset.theme=themes.includes(stored)?stored:fallback;" +
  "document.documentElement.dataset.glow=localStorage.getItem(" + JSON.stringify(glowStorageKey) + ")==='true'?'reduced':'standard';" +
  "document.documentElement.dataset.contrast=localStorage.getItem(" + JSON.stringify(contrastStorageKey) + ")==='true'?'high':'standard';" +
  "document.documentElement.dataset.colorVision=localStorage.getItem(" + JSON.stringify(colorVisionStorageKey) + ")==='true'?'safe':'standard';" +
  "} catch {document.documentElement.dataset.theme=fallback;document.documentElement.dataset.glow='standard';document.documentElement.dataset.contrast='standard';document.documentElement.dataset.colorVision='standard';}" +
  "})();";

const railBootstrap =
  "(() => {" +
  "try {" +
  "document.documentElement.dataset.shellRail='collapsed';" +
  "} catch {document.documentElement.dataset.shellRail='collapsed';}" +
  "})();";

---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0b0f14" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <script is:inline set:html={themeBootstrap}></script>
    <script is:inline set:html={railBootstrap}></script>
    <title>{title}</title>
    <slot name="head" />
  </head>
  <body>
    <div class="shell">
      <aside class="shell__rail surface-pad" aria-label="Site rail">
        <div class="shell__rail-top">
          <button class="shell__menu-toggle" type="button" aria-expanded="false" aria-controls="site-primary-nav" aria-label="Expand navigation" data-toggle-rail>
            <span class="shell__menu-toggle-burger" aria-hidden="true">
              <span></span>
              <span></span>
              <span></span>
            </span>
            <span class="shell__menu-toggle-close" aria-hidden="true">&times;</span>
            <span class="shell__menu-label" aria-hidden="true">&lt;</span>
          </button>
          <a class="shell__brand" href="/" aria-label="Home">
            <img class="shell__brand-image" src="/gh-logo.png" alt="" />
            <span class="shell__brand-name">GENARO HERN&Aacute;NDEZ</span>
          </a>
        </div>

        <section class="shell__rail-group shell__rail-group--nav" aria-label="Primary navigation">
          <p class="shell__section-label">Navigation</p>
          <nav class="shell__links" id="site-primary-nav" aria-label="Primary navigation">
            {navItems.map((item) => (
              <a href={item.href} aria-label={item.label} aria-current={isActive(item.href) ? "page" : undefined} class:list={{ "is-active": isActive(item.href) }} title={item.label}>
                <span class="shell__nav-icon" aria-hidden="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75">
                    <path d={item.iconPath} />
                  </svg>
                </span>
                <span class="shell__nav-label">{item.label}</span>
              </a>
            ))}
          </nav>
        </section>

        <div class="shell__rail-slot">
          <slot name="rail" />
          <section class="shell__rail-group shell__rail-group--utilities" aria-label="Utilities">
            <p class="shell__section-label">Utilities</p>
            <div class="shell__utility-mount" data-theme-switcher-mount></div>
            <div class="shell__rail-topology" data-shell-rail-topology aria-hidden="true"></div>
          </section>
        </div>
      </aside>

      <div class="shell__stage">
        <slot />
      </div>
    </div>
    <ThemeSwitcher />
    <script>
      if (import.meta.env.DEV) {
        import("operational-topology/browser").then(({ installDeveloperAPI }) => {
          installDeveloperAPI();
        });
      }
    </script>
    <script>
      const rail = document.querySelector<HTMLElement>(".shell__rail");
      const toggle = document.querySelector<HTMLButtonElement>("[data-toggle-rail]");
      const root = document.documentElement;
      const stage = document.querySelector<HTMLElement>(".shell__stage");
      const storageKey = "thisisgenaro:shell-rail-collapsed";
      const mobileQuery = window.matchMedia("(max-width: 860px)");
      const focusableSelector = [
        "a[href]",
        "button:not([disabled])",
        "select:not([disabled])",
        "textarea:not([disabled])",
        "input:not([disabled])",
        "[tabindex]:not([tabindex='-1'])",
      ].join(",");

      let lockedScrollY = 0;
      let restoreToggleFocus = false;

      const setBodyLock = (locked: boolean) => {
        if (locked) {
          lockedScrollY = window.scrollY;
          document.body.style.position = "fixed";
          document.body.style.top = `-${lockedScrollY}px`;
          document.body.style.left = "0";
          document.body.style.right = "0";
          document.body.style.width = "100%";
          return;
        }

        document.body.style.position = "";
        document.body.style.top = "";
        document.body.style.left = "";
        document.body.style.right = "";
        document.body.style.width = "";
        window.scrollTo(0, lockedScrollY);
      };

      const setStageInert = (inert: boolean) => {
        if (!stage) return;
        if (inert) {
          stage.setAttribute("inert", "");
          stage.setAttribute("aria-hidden", "true");
        } else {
          stage.removeAttribute("inert");
          stage.removeAttribute("aria-hidden");
        }
      };

      const getFocusable = () => {
        if (!rail) return [];
        return Array.from(rail.querySelectorAll<HTMLElement>(focusableSelector)).filter((element) => {
          const style = window.getComputedStyle(element);
          return !element.hasAttribute("hidden") && style.display !== "none" && style.visibility !== "hidden";
        });
      };

      const updateToggleLabel = (open: boolean) => {
        if (!toggle) return;
        toggle.setAttribute("aria-expanded", String(open));
        toggle.setAttribute("aria-label", mobileQuery.matches
          ? (open ? "Close navigation" : "Open navigation")
          : (open ? "Collapse navigation" : "Expand navigation"));

        const label = toggle.querySelector<HTMLElement>(".shell__menu-label");
        if (label && !mobileQuery.matches) {
          label.textContent = open ? "<" : ">";
        }
      };

      const setDesktopRailState = (collapsed: boolean) => {
        root.dataset.shellRail = collapsed ? "collapsed" : "expanded";
        updateToggleLabel(!collapsed);
        toggle?.setAttribute("data-collapsed", String(collapsed));
        root.style.setProperty("--shell-rail-current-width", collapsed ? "5.25rem" : "15.5rem");
        rail?.classList.toggle("is-open", !collapsed && mobileQuery.matches);
        try {
          localStorage.setItem(storageKey, collapsed ? "true" : "false");
        } catch {
          // Ignore persistence failures.
        }
      };

      const openMobileMenu = () => {
        if (!rail) return;
        root.dataset.shellRail = "expanded";
        rail.classList.add("is-open");
        updateToggleLabel(true);
        setBodyLock(true);
        setStageInert(true);
        restoreToggleFocus = true;
        const focusTarget = getFocusable().find((element) => element !== toggle) ?? toggle;
        focusTarget?.focus({ preventScroll: true });
      };

      const closeMobileMenu = () => {
        if (!rail) return;
        rail.classList.remove("is-open");
        root.dataset.shellRail = "collapsed";
        updateToggleLabel(false);
        setBodyLock(false);
        setStageInert(false);
        if (restoreToggleFocus) {
          toggle?.focus({ preventScroll: true });
        }
        restoreToggleFocus = false;
        try {
          localStorage.setItem(storageKey, "true");
        } catch {
          // Ignore persistence failures.
        }
      };

      const syncMobileState = () => {
        if (!mobileQuery.matches) {
          setStageInert(false);
          setBodyLock(false);
          rail?.classList.remove("is-open");
          setDesktopRailState(root.dataset.shellRail !== "expanded");
          return;
        }

        if (rail?.classList.contains("is-open")) {
          openMobileMenu();
        } else {
          closeMobileMenu();
        }
      };

      setDesktopRailState(root.dataset.shellRail !== "expanded");

      toggle?.addEventListener("click", () => {
        if (mobileQuery.matches) {
          if (rail?.classList.contains("is-open")) {
            closeMobileMenu();
          } else {
            openMobileMenu();
          }
          return;
        }

        setDesktopRailState(root.dataset.shellRail !== "collapsed");
      });

      document.addEventListener("keydown", (event) => {
        if (!mobileQuery.matches || !rail?.classList.contains("is-open")) return;
        if (event.key === "Escape") {
          event.preventDefault();
          closeMobileMenu();
          return;
        }

        if (event.key !== "Tab") return;

        const focusables = getFocusable();
        if (!focusables.length) return;
        const first = focusables[0];
        const last = focusables[focusables.length - 1];
        if (event.shiftKey && document.activeElement === first) {
          event.preventDefault();
          last.focus({ preventScroll: true });
        } else if (!event.shiftKey && document.activeElement === last) {
          event.preventDefault();
          first.focus({ preventScroll: true });
        }
      });

      document.addEventListener("focusin", (event) => {
        if (!mobileQuery.matches || !rail?.classList.contains("is-open")) return;
        const target = event.target;
        if (!(target instanceof Node) || rail.contains(target)) return;
        const focusables = getFocusable();
        (focusables[0] ?? toggle)?.focus({ preventScroll: true });
      });

      mobileQuery.addEventListener("change", syncMobileState);
      syncMobileState();
    </script>
    <script>
      import {
        createViewportFitHexGrid,
        prepareTopologyRenderFrame,
        renderTopologyGridMarkup,
      } from "operational-topology";
      import { getDiagonalSweepFrame, toGridCellStateMap } from "operational-topology/labs";

      const host = document.querySelector<HTMLElement>("[data-shell-rail-topology]");

      if (host) {
        const root = document.documentElement;
        const desktopQuery = window.matchMedia("(min-width: 861px)");
        const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
        let frameIndex = 0;
        let frame = null;
        let cells = [];
        let bandSpan = 1;
        let intervalId = 0;
        let lastWidth = 0;
        let lastHeight = 0;

        const stop = () => {
          if (intervalId) {
            window.clearInterval(intervalId);
            intervalId = 0;
          }
        };

        const updateHostState = () => {
          const collapsed = root.dataset.shellRail !== "expanded";
          host.style.setProperty("--shell-rail-topology-opacity", collapsed ? "0" : "1");
        };

        const buildFrame = (width, height) => {
          const radius = desktopQuery.matches ? 28 : 24;
          cells = createViewportFitHexGrid({ radius, width, height });
          const bands = cells.map((cell) => cell.q + cell.r);
          bandSpan = Math.max(1, Math.max(...bands) - Math.min(...bands) + 1);
          frame = prepareTopologyRenderFrame({ cells });
        };

        const render = () => {
          if (!frame || !cells.length) return;

          const states = getDiagonalSweepFrame({
            cells,
            frame: frameIndex,
            width: bandSpan,
            trail: 3,
            wrap: true,
          });

          host.innerHTML = renderTopologyGridMarkup({
            frame,
            radius: desktopQuery.matches ? 28 : 24,
            cellStates: toGridCellStateMap(states),
            showNodes: true,
            className: "shell-topology",
            connectorRouting: "straight",
          });
        };

        const start = () => {
          stop();
          updateHostState();
          render();
          if (reducedMotion.matches || !desktopQuery.matches) return;
          intervalId = window.setInterval(() => {
            frameIndex = (frameIndex + 1) % bandSpan;
            render();
          }, 220);
        };

        const rebuild = () => {
          if (!desktopQuery.matches) {
            host.innerHTML = "";
            stop();
            return;
          }

          const rect = host.getBoundingClientRect();
          const width = Math.max(1, Math.round(rect.width));
          const height = Math.max(1, Math.round(rect.height));
          if (width === lastWidth && height === lastHeight) return;
          lastWidth = width;
          lastHeight = height;
          buildFrame(width, height);
          start();
        };

        const resizeObserver = "ResizeObserver" in window ? new ResizeObserver(() => rebuild()) : null;

        const handleVisibilityChange = () => {
          if (document.hidden) {
            stop();
            return;
          }

          start();
        };

        const handleMediaChange = () => {
          updateHostState();
          rebuild();
        };

        const handleRailChange = () => {
          updateHostState();
          if (root.dataset.shellRail !== "expanded") {
            stop();
          } else {
            start();
          }
        };

        reducedMotion.addEventListener("change", handleMediaChange);
        desktopQuery.addEventListener("change", handleMediaChange);
        document.addEventListener("visibilitychange", handleVisibilityChange);
        resizeObserver?.observe(host);
        updateHostState();
        rebuild();

        const railStateObserver = new MutationObserver(handleRailChange);
        railStateObserver.observe(root, { attributes: true, attributeFilter: ["data-shell-rail"] });

        window.addEventListener(
          "pagehide",
          () => {
            stop();
            resizeObserver?.disconnect();
            railStateObserver.disconnect();
          },
          { once: true },
        );
      }
    </script>
  </body>
</html>

<style>
  :root {
    --shell-rail-expanded: 18rem;
    --shell-rail-collapsed: 5.25rem;
    --shell-mobile-nav-bg: color-mix(in srgb, var(--theme-inspector-background) 96%, transparent);
    --shell-mobile-nav-border: color-mix(in srgb, var(--theme-line-strong) 72%, transparent);
    --shell-mobile-nav-accent: var(--theme-selection);
    --shell-mobile-nav-text: var(--theme-text-primary);
    --shell-mobile-nav-muted: var(--theme-text-muted);
    --shell-mobile-nav-topology: color-mix(in srgb, var(--theme-selection) 18%, transparent);
  }

  .shell {
    display: grid;
    grid-template-columns: var(--shell-rail-expanded) minmax(0, 1fr);
    min-height: 100vh;
    width: 100%;
  }

  html[data-shell-rail="collapsed"] .shell {
    grid-template-columns: var(--shell-rail-collapsed) minmax(0, 1fr);
  }

  .shell__rail {
    position: sticky;
    top: 0;
    align-self: start;
    display: flex;
    flex-direction: column;
    gap: 1rem;
    min-height: 100vh;
    height: 100vh;
    padding: 1rem;
    border-radius: 0;
    background: linear-gradient(180deg, color-mix(in srgb, var(--surface-raised) 94%, transparent), color-mix(in srgb, var(--surface) 88%, transparent));
    box-shadow: 12px 0 28px rgba(0, 0, 0, 0.16);
    overflow: hidden auto;
    z-index: 2;
  }

  .shell__rail-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.9rem;
  }

  html[data-shell-rail="collapsed"] .shell__rail-top {
    flex-direction: column;
    align-items: center;
    gap: 0.5rem;
  }

  .shell__brand {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: none;
    width: 3.6rem;
    aspect-ratio: 1;
    align-self: center;
    padding: 0;
    border: 0;
    border-radius: 0;
    background: transparent;
    box-shadow: none;
    filter: drop-shadow(0 0 10px color-mix(in srgb, var(--accent) 10%, transparent));
  }

  .shell__brand-image {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .shell__menu-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 2.2rem;
    min-height: 2.2rem;
    padding: 0.2rem 0.5rem;
    border: 1px solid color-mix(in srgb, var(--accent) 24%, transparent);
    border-radius: 0.8rem;
    background: color-mix(in srgb, var(--surface) 58%, transparent);
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    font-weight: 700;
    line-height: 1;
    letter-spacing: 0;
    text-transform: none;
    transition: border-color 180ms ease, background 180ms ease, transform 180ms ease, box-shadow 180ms ease, color 180ms ease;
  }

  .shell__menu-toggle-burger {
    display: none;
    width: 0.95rem;
    gap: 0.14rem;
    flex-direction: column;
    align-items: center;
    justify-content: center;
  }

  .shell__menu-toggle-burger span {
    display: block;
    width: 100%;
    height: 1.5px;
    border-radius: 999px;
    background: currentColor;
  }

  .shell__menu-label {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 0.8rem;
    transform: translateY(-0.02em);
  }

  .shell__links {
    display: grid;
    gap: 0.25rem;
    padding-top: 0.2rem;
    font-family: var(--font-mono);
    font-size: 0.74rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .shell__links a {
    position: relative;
    display: grid;
    grid-template-columns: 1.55rem minmax(0, 1fr);
    align-items: center;
    gap: 0.55rem;
    min-height: 2.35rem;
    padding: 0.42rem 0.45rem 0.42rem 0.55rem;
    color: var(--text);
    border: 1px solid transparent;
    border-radius: 0.65rem;
    background: color-mix(in srgb, var(--surface) 58%, transparent);
    transition: border-color 180ms ease, color 180ms ease, transform 180ms ease, box-shadow 180ms ease, background 180ms ease;
  }

  .shell__nav-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    justify-self: center;
    width: 1.35rem;
    height: 1.35rem;
    color: color-mix(in srgb, var(--accent) 78%, var(--amber) 22%);
    transition: color 180ms ease, background 180ms ease, border-color 180ms ease, box-shadow 180ms ease;
  }

  .shell__nav-icon svg {
    width: 100%;
    height: 100%;
  }

  .shell__nav-label {
    min-width: 0;
    white-space: nowrap;
    transition: opacity 180ms ease, transform 180ms ease, max-width 180ms ease;
  }

  .shell__links a:hover,
  .shell__links a:focus-visible {
    transform: translateX(2px);
    border-color: color-mix(in srgb, var(--accent) 40%, transparent);
    color: var(--accent);
    background: color-mix(in srgb, var(--accent-soft) 20%, transparent);
  }

  .shell__brand:focus-visible,
  .shell__menu-toggle:focus-visible,
  .shell__links a:focus-visible {
    outline: 2px solid color-mix(in srgb, var(--accent) 70%, white);
    outline-offset: 3px;
  }

  .shell__links a.is-active,
  .shell__links a[aria-current="page"] {
    color: var(--accent);
    border-color: color-mix(in srgb, var(--accent) 55%, transparent);
    background: color-mix(in srgb, var(--accent-soft) 28%, transparent);
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--accent) 26%, transparent);
  }

  .shell__links a.is-active::before,
  .shell__links a[aria-current="page"]::before {
    content: "";
    position: absolute;
    left: 0.1rem;
    top: 0.35rem;
    bottom: 0.35rem;
    width: 0.22rem;
    border-radius: 999px;
    background: var(--accent);
    box-shadow: 0 0 0 1px color-mix(in srgb, var(--amber) 16%, transparent);
  }

  .shell__links a.is-active .shell__nav-icon,
  .shell__links a[aria-current="page"] .shell__nav-icon {
    color: var(--accent);
    background: color-mix(in srgb, var(--accent-soft) 52%, transparent);
    border: 1px solid color-mix(in srgb, var(--accent) 34%, transparent);
    border-radius: 0.32rem;
    box-shadow: 0 0 0 1px color-mix(in srgb, var(--amber) 12%, transparent);
  }

  .shell__rail-slot {
    display: grid;
    gap: 0.75rem;
    margin-top: auto;
    padding-top: 1rem;
    border-top: 1px solid color-mix(in srgb, var(--line-strong) 62%, transparent);
  }

  .shell__stage {
    position: relative;
    z-index: 1;
    min-width: 0;
    padding: 0 0 2rem;
  }

  html[data-home-intro-state="ready"] .shell__rail,
  html[data-home-intro-state="signal"] .shell__rail,
  html[data-home-intro-state="logo"] .shell__rail {
    opacity: 0;
    pointer-events: none;
    transform: translateX(-0.5rem);
  }


  html[data-shell-rail="collapsed"] .shell__rail {
    padding-inline: 0.85rem;
  }

  html[data-shell-rail="collapsed"] .shell__links {
    gap: 0.35rem;
  }

  html[data-shell-rail="collapsed"] .shell__links a {
    grid-template-columns: 1.55rem 0fr;
    gap: 0;
    justify-items: center;
    padding-inline: 0.2rem 0.15rem;
  }

  html[data-shell-rail="collapsed"] .shell__nav-label {
    opacity: 0;
    max-width: 0;
    overflow: hidden;
    transform: translateX(-0.25rem);
  }

  html[data-shell-rail="collapsed"] .shell__links a.is-active,
  html[data-shell-rail="collapsed"] .shell__links a[aria-current="page"] {
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--accent) 40%, transparent);
    background: color-mix(in srgb, var(--accent-soft) 44%, transparent);
  }

  html[data-shell-rail="collapsed"] .shell__links a.is-active .shell__nav-icon,
  html[data-shell-rail="collapsed"] .shell__links a[aria-current="page"] .shell__nav-icon {
    box-shadow: 0 0 0 1px color-mix(in srgb, var(--amber) 35%, transparent);
  }

  html[data-shell-rail="collapsed"] .shell__rail-slot {
    opacity: 0;
    pointer-events: none;
    max-height: 0;
    margin-top: 0;
    padding-top: 0;
    overflow: hidden;
  }

  html[data-shell-rail="collapsed"] .shell__brand {
    width: 3rem;
  }

  html[data-shell-rail="collapsed"] .shell__menu-toggle {
    align-self: center;
  }

  @media (max-width: 860px) {
    .shell {
      grid-template-columns: 1fr;
    }

    html[data-shell-rail="collapsed"] .shell {
