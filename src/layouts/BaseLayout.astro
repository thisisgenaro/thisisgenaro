---
import ThemeSwitcher from "operational-topology/astro/ThemeSwitcher";
import {
  colorVisionStorageKey,
  contrastStorageKey,
  defaultTheme as frameworkDefaultTheme,
  glowStorageKey,
  themeNames,
  themeStorageKey,
} from "operational-topology";

import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "thisisgenaro.com",
  description = "Design, automate, and keep things running.",
} = Astro.props;

const pathname = Astro.url.pathname;
const railStateStorageKey = "thisisgenaro:shell-rail-collapsed";

const navItems = [
  { href: "/", label: "Home" },
  { href: "/journal", label: "Journal" },
  { href: "/incidents", label: "Incidents" },
  { href: "/about", label: "About" },
  { href: "/about/cv", label: "CV" },
];

const isActive = (href: string) => {
  if (href === "/") return pathname === "/";
  if (href === "/about") return pathname === "/about";
  return pathname === href || pathname.startsWith(`${href}/`);
};

const themeBootstrap =
  "(() => {" +
  "const themes=" + JSON.stringify(themeNames) + ";" +
  "const fallback=" + JSON.stringify(frameworkDefaultTheme) + ";" +
  "try {" +
  "const stored=localStorage.getItem(" + JSON.stringify(themeStorageKey) + ");" +
  "document.documentElement.dataset.theme=themes.includes(stored)?stored:fallback;" +
  "document.documentElement.dataset.glow=localStorage.getItem(" + JSON.stringify(glowStorageKey) + ")==='true'?'reduced':'standard';" +
  "document.documentElement.dataset.contrast=localStorage.getItem(" + JSON.stringify(contrastStorageKey) + ")==='true'?'high':'standard';" +
  "document.documentElement.dataset.colorVision=localStorage.getItem(" + JSON.stringify(colorVisionStorageKey) + ")==='true'?'safe':'standard';" +
  "} catch {document.documentElement.dataset.theme=fallback;document.documentElement.dataset.glow='standard';document.documentElement.dataset.contrast='standard';document.documentElement.dataset.colorVision='standard';}" +
  "})();";

const railBootstrap =
  "(() => {" +
  "const key=" + JSON.stringify(railStateStorageKey) + ";" +
  "try {" +
  "const stored=localStorage.getItem(key);" +
  "document.documentElement.dataset.shellRail=stored==='true'?'collapsed':'expanded';" +
  "} catch {document.documentElement.dataset.shellRail='expanded';}" +
  "})();";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0b0f14" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <script is:inline set:html={themeBootstrap}></script>
    <script is:inline set:html={railBootstrap}></script>
    <title>{title}</title>
    <slot name="head" />
  </head>
  <body>
    <div class="shell">
      <aside class="shell__rail surface surface-pad" aria-label="Site rail">
        <div class="shell__rail-top">
          <a class="shell__brand" href="/" aria-label="Home">
            <img class="shell__brand-image" src="/gh-logo.png" alt="" />
          </a>

          <button class="shell__menu-toggle" type="button" aria-expanded="false" aria-controls="site-primary-nav" data-toggle-rail>
            <span class="shell__menu-icon" aria-hidden="true">
              <span></span>
              <span></span>
              <span></span>
            </span>
            <span class="shell__menu-label">Collapse</span>
          </button>
        </div>

        <nav class="shell__links" id="site-primary-nav" aria-label="Primary">
          {navItems.map((item) => (
            <a href={item.href} aria-current={isActive(item.href) ? "page" : undefined} class:list={{ "is-active": isActive(item.href) }}>
              {item.label}
            </a>
          ))}
        </nav>

        <div class="shell__rail-slot">
          <slot name="rail" />
        </div>
      </aside>

      <div class="shell__stage">
        <slot />
      </div>
    </div>
    <ThemeSwitcher />
    <script>
      if (import.meta.env.DEV) {
        import("operational-topology/browser").then(({ installDeveloperAPI }) => {
          installDeveloperAPI();
        });
      }
    </script>
    <script>
      const rail = document.querySelector<HTMLElement>(".shell__rail");
      const toggle = document.querySelector<HTMLButtonElement>("[data-toggle-rail]");
      const root = document.documentElement;
      const storageKey = "thisisgenaro:shell-rail-collapsed";

      const applyState = (collapsed: boolean) => {
        root.dataset.shellRail = collapsed ? "collapsed" : "expanded";
        toggle?.setAttribute("aria-expanded", String(!collapsed));
        if (toggle) {
          const label = toggle.querySelector<HTMLElement>(".shell__menu-label");
          if (label) label.textContent = collapsed ? "Expand" : "Collapse";
        }
        try {
          localStorage.setItem(storageKey, collapsed ? "true" : "false");
        } catch {
          // Ignore persistence failures.
        }
      };

      applyState(root.dataset.shellRail === "collapsed");

      toggle?.addEventListener("click", () => {
        applyState(root.dataset.shellRail !== "collapsed");
        rail?.classList.toggle("is-open", root.dataset.shellRail !== "collapsed");
      });
    </script>
  </body>
</html>

<style>
  :root {
    --shell-rail-expanded: 17rem;
    --shell-rail-collapsed: 5rem;
  }

  .shell {
    display: grid;
    grid-template-columns: var(--shell-rail-expanded) minmax(0, 1fr);
    min-height: 100vh;
    width: 100%;
  }

  html[data-shell-rail="collapsed"] .shell {
    grid-template-columns: var(--shell-rail-collapsed) minmax(0, 1fr);
  }

  .shell__rail {
    position: sticky;
    top: 0;
    align-self: start;
    display: grid;
    gap: 1rem;
    min-height: 100vh;
    height: 100vh;
    padding: 1rem;
    border-right: 1px solid color-mix(in srgb, var(--line-strong) 70%, transparent);
    border-radius: 0;
    background: linear-gradient(180deg, color-mix(in srgb, var(--surface-2) 84%, transparent), color-mix(in srgb, var(--surface) 72%, transparent));
    box-shadow: 12px 0 28px rgba(0, 0, 0, 0.16);
    overflow: hidden auto;
  }

  .shell__rail-top {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
  }

  .shell__brand {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    flex: none;
    width: 3.4rem;
    aspect-ratio: 1;
    padding: 0;
    border: 0;
    border-radius: 0;
    background: transparent;
    box-shadow: none;
  }

  .shell__brand-image {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .shell__menu-toggle {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    min-height: 2.2rem;
    margin-left: auto;
    padding: 0.34rem 0.68rem;
    border: 1px solid color-mix(in srgb, var(--line-strong) 55%, transparent);
    border-radius: 0;
    background: transparent;
    color: var(--text);
    font-family: var(--font-mono);
    font-size: 0.66rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    transition: border-color 180ms ease, background 180ms ease, transform 180ms ease, box-shadow 180ms ease;
  }

  .shell__menu-icon {
    display: grid;
    gap: 0.22rem;
    width: 1rem;
  }

  .shell__menu-icon span {
    display: block;
    width: 100%;
    height: 1px;
    background: currentColor;
  }

  .shell__links {
    display: grid;
    gap: 0.2rem;
    padding-top: 0.15rem;
    font-family: var(--font-mono);
    font-size: 0.74rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .shell__links a {
    display: inline-flex;
    align-items: center;
    min-height: 2.15rem;
    padding: 0.35rem 0;
    color: var(--text);
    border-bottom: 1px solid transparent;
    border-radius: 0;
    background: transparent;
    transition: border-color 180ms ease, color 180ms ease, transform 180ms ease, box-shadow 180ms ease;
  }

  .shell__links a:hover,
  .shell__links a:focus-visible {
    transform: translateX(2px);
    border-bottom-color: color-mix(in srgb, var(--accent) 70%, transparent);
    color: var(--accent);
  }

  .shell__brand:focus-visible,
  .shell__menu-toggle:focus-visible,
  .shell__links a:focus-visible {
    outline: 2px solid color-mix(in srgb, var(--accent) 70%, white);
    outline-offset: 3px;
  }

  .shell__links a.is-active,
  .shell__links a[aria-current="page"] {
    color: var(--accent);
    border-bottom-color: color-mix(in srgb, var(--accent) 85%, transparent);
  }

  .shell__rail-slot {
    display: grid;
    gap: 0.75rem;
    margin-top: auto;
    padding-top: 1rem;
    border-top: 1px solid color-mix(in srgb, var(--line-strong) 62%, transparent);
  }

  .shell__stage {
    min-width: 0;
    padding: 0 0 2rem;
  }

  html[data-shell-rail="collapsed"] .shell__rail {
    padding-inline: 0.85rem;
  }

  html[data-shell-rail="collapsed"] .shell__links,
  html[data-shell-rail="collapsed"] .shell__rail-slot {
    opacity: 0;
    pointer-events: none;
    max-height: 0;
    margin-top: 0;
    padding-top: 0;
    overflow: hidden;
  }

  html[data-shell-rail="collapsed"] .shell__brand {
    width: 3rem;
  }

  @media (max-width: 860px) {
    .shell {
      grid-template-columns: 1fr;
    }

    .shell__rail {
      position: sticky;
      top: 0;
      z-index: 30;
      min-height: auto;
      height: auto;
      padding: 0.85rem;
      border-right: 0;
      border-bottom: 1px solid color-mix(in srgb, var(--line-strong) 70%, transparent);
      box-shadow: 0 10px 28px rgba(0, 0, 0, 0.18);
    }

    html[data-shell-rail="collapsed"] .shell__rail {
      padding-inline: 0.85rem;
    }

    .shell__rail-slot {
      display: none;
    }

    .shell__links {
      display: none;
      width: 100%;
      gap: 0.15rem;
      padding-top: 0.35rem;
    }

    .shell__links a {
      width: 100%;
      padding: 0.7rem 0;
      border-bottom-color: color-mix(in srgb, var(--line) 88%, transparent);
    }

    .shell__rail.is-open .shell__links,
    html[data-shell-rail="expanded"] .shell__links {
      display: grid;
    }

    html[data-shell-rail="collapsed"] .shell__links {
      display: none;
    }

    .shell__stage {
      padding-top: 0.75rem;
    }
  }
</style>
