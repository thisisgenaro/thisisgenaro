---
import JournalTopology from "./journal/JournalTopology.astro";
interface Props { locale?: 'en' | 'es'; }
const { locale = 'en' } = Astro.props;
const isEs = locale === 'es';
const tx = (en: string, es: string) => isEs ? es : en;
const shareItems = isEs ? [
  'Patrones de infraestructura que siguen siendo legibles bajo presión.',
  'Decisiones de automatización que reducen el desvío y mantienen el trabajo repetible.',
  'Lecciones de incidentes que explican causa, contexto y consecuencia.',
  'Notas operativas que ayudan a otros a continuar el trabajo.'
] : [
  'Infrastructure patterns that stay readable under pressure.',
  'Automation choices that reduce drift and keep work repeatable.',
  'Incident lessons that explain cause, context, and consequence.',
  'Operational notes that help others carry the work forward.'
];
const leaveItems = isEs ? [
  'Razonamiento claro en lugar de ruido de plataformas.',
  'Evidencia que pueda revisarse más adelante.',
  'Lecciones que sigan siendo útiles más allá de un solo incidente.',
  'Modelos que ayuden a otros ingenieros a entender los sistemas más rápido.'
] : [
  'Clear reasoning instead of platform noise.',
  'Evidence that can be revisited later.',
  'Lessons that remain useful beyond a single incident.',
  'Models that help other engineers understand systems faster.'
];
---
<JournalTopology class="about-page__topology" />

  <main class="about-page">
    <header class="about-page__hero" aria-labelledby="about-title">
      <p class="about-page__eyebrow">{tx("ABOUT ME", "SOBRE MÍ")}</p>
      <h1 class="about-page__title" id="about-title">Genaro Hernández</h1>
      <div class="about-page__hero-copy">
        <p>{tx("I write about infrastructure, incidents, and the decisions that keep systems understandable under pressure.", "Escribo sobre infraestructura, incidentes y las decisiones que mantienen los sistemas comprensibles bajo presión.")}</p>
        <p>{tx("This site is where I leave useful notes, operational lessons, and working models behind.", "Este sitio es donde dejo notas útiles, lecciones operativas y modelos de trabajo.")}</p>
      </div>
    </header>

    <section class="about-page__intro-grid" aria-label={tx("About Genaro Hernandez", "Sobre Genaro Hernández")}>
      <article class="about-panel about-panel--person">
        <p class="about-panel__label">{tx("THE PERSON", "LA PERSONA")}</p>
        <div class="about-person">
          <div class="about-person__mark" aria-hidden="true">
            <img src="/gh-logo.png" alt="" />
          </div>
          <div class="about-person__copy">
            <h2>{tx("One engineer, shared clearly", "Un ingeniero que comparte con claridad")}</h2>
            <p>
              {tx("I’m an engineer who works on the systems people rely on when things matter.", "Soy un ingeniero que trabaja en los sistemas de los que las personas dependen cuando importa.")}
              {tx("This site reflects my point of view, shaped by production experience, late-night incidents, reviews, and the conversations that make complex systems make sense.", "Este sitio refleja mi perspectiva, formada por experiencia en producción, incidentes nocturnos, revisiones y conversaciones que ayudan a entender los sistemas complejos.")}
            </p>
          </div>
        </div>
      </article>

      <article class="about-panel about-panel--thinking">
        <p class="about-panel__label">{tx("HOW I THINK", "CÓMO PIENSO")}</p>
        <h2>{tx("Systems before components", "Sistemas antes que componentes")}</h2>
        <p class="about-panel__lede">
          {tx("I look at dependencies, signals, failure paths, and operational decisions rather than isolated servers.", "Observo dependencias, señales, rutas de fallo y decisiones operativas, no servidores aislados.")}
          {tx("That keeps the real behavior of a system visible and helps us make better choices under pressure.", "Eso mantiene visible el comportamiento real de un sistema y nos ayuda a tomar mejores decisiones bajo presión.")}
        </p>

        <div class="about-questions" role="list" aria-label={tx("Working questions", "Preguntas de trabajo")}>
          <div class="about-question" role="listitem">
            <span class="about-question__mark" aria-hidden="true">⬡</span>
            <p>{tx("What is the system actually trying to deliver?", "¿Qué intenta entregar realmente el sistema?")}</p>
          </div>
          <div class="about-question" role="listitem">
            <span class="about-question__mark" aria-hidden="true">⬡</span>
            <p>{tx("What evidence tells us whether it is healthy?", "¿Qué evidencia nos dice si está funcionando correctamente?")}</p>
          </div>
          <div class="about-question" role="listitem">
            <span class="about-question__mark" aria-hidden="true">⬡</span>
            <p>{tx("What happens when one dependency stops behaving normally?", "¿Qué ocurre cuando una dependencia deja de comportarse con normalidad?")}</p>
          </div>
        </div>
      </article>
    </section>

    <section class="about-page__dual" aria-label={tx("What Genaro shares and leaves behind", "Lo que Genaro comparte y deja")}>
      <article class="about-list">
        <p class="about-panel__label">{tx("WHAT I SHARE", "LO QUE COMPARTO")}</p>
        <ul>
          {shareItems.map((item) => <li>{item}</li>)}
        </ul>
      </article>

      <article class="about-list about-list--leaving">
        <p class="about-panel__label">{tx("WHAT I TRY TO LEAVE BEHIND", "LO QUE INTENTO DEJAR")}</p>
        <ul>
          {leaveItems.map((item) => <li>{item}</li>)}
        </ul>
      </article>
    </section>

    <section class="about-start" aria-labelledby="where-to-start-title">
      <p class="about-panel__label">{tx("WHERE TO START", "POR DÓNDE EMPEZAR")}</p>
      <h2 id="where-to-start-title" class="about-start__title">{tx("Choose the path that fits what you want to learn.", "Elige el camino que mejor se ajuste a lo que quieres aprender.")}</h2>

      <div class="about-start__grid">
        <article class="about-start__path about-start__path--thinking">
          <div class="about-start__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 3 20 8v8l-8 5-8-5V8Z" />
            </svg>
          </div>
          <div class="about-start__body">
            <p class="about-start__eyebrow">{tx("START WITH THE THINKING", "EMPIEZA POR LAS IDEAS")}</p>
            <a class="about-start__action" href={isEs ? "/es/journal/" : "/journal/"}>{tx("Read the Journal →", "Leer La Bitácora →")}</a>
            <p>{tx("Reflect, learn, and build better mental models.", "Reflexiona, aprende y construye mejores modelos mentales.")}</p>
          </div>
        </article>

        <article class="about-start__path about-start__path--evidence">
          <div class="about-start__icon" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 3 20 8v8l-8 5-8-5V8Z" />
              <path d="M9 12h6" />
            </svg>
          </div>
          <div class="about-start__body">
            <p class="about-start__eyebrow">{tx("START WITH THE EVIDENCE", "EMPIEZA POR LA EVIDENCIA")}</p>
            <a class="about-start__action" href={isEs ? "/es/incidents/" : "/incidents/"}>{tx("Explore the Incident Library →", "Explorar el Registro de Incidentes →")}</a>
            <p>{tx("Browse incidents, patterns, and operational outcomes.", "Explora incidentes, patrones y resultados operativos.")}</p>
          </div>
        </article>
      </div>
    </section>
  </main>

<style>
  .about-page {
    position: relative;
    z-index: 1;
    width: min(100%, 84rem);
    margin: 0 auto;
    padding: clamp(1rem, 3.5vw, 2.4rem);
    display: grid;
    gap: clamp(1.15rem, 2.6vw, 2rem);
  }

  .about-page__topology {
    opacity: 0.12;
  }

  .about-page__hero {
    display: grid;
    gap: 0.65rem;
    max-width: 50rem;
    padding-top: 0.25rem;
  }

  .about-page__eyebrow,
  .about-panel__label,
  .about-start__eyebrow {
    margin: 0;
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .about-page__title {
    margin: 0;
    font-size: clamp(3.2rem, 7.5vw, 6rem);
    line-height: 0.9;
    letter-spacing: -0.075em;
  }

  .about-page__hero-copy {
    display: grid;
    gap: 0.8rem;
    max-width: 48rem;
  }

  .about-page__hero-copy p {
    margin: 0;
    color: var(--muted);
    font-size: clamp(1rem, 1.4vw, 1.12rem);
    line-height: 1.74;
  }

  .about-page__intro-grid {
    display: grid;
    grid-template-columns: minmax(0, 0.95fr) minmax(0, 1.05fr);
    gap: clamp(1rem, 2.8vw, 2rem);
    align-items: start;
    padding-top: 0.5rem;
    border-top: 1px solid color-mix(in srgb, var(--line-strong) 72%, transparent);
  }

  .about-panel {
    min-width: 0;
    display: grid;
    gap: 0.9rem;
  }

  .about-panel--person {
    padding-right: clamp(0.75rem, 1.8vw, 1.35rem);
    border-inline-end: 1px solid color-mix(in srgb, var(--line-strong) 64%, transparent);
  }

  .about-panel--thinking {
    padding-left: clamp(0.75rem, 1.8vw, 1.35rem);
  }

  .about-person {
    display: grid;
    grid-template-columns: minmax(8.5rem, 10rem) minmax(0, 1fr);
    gap: 1rem;
    align-items: center;
  }

  .about-person__mark {
    display: grid;
    place-items: center;
    min-height: 10.25rem;
    border: 1px solid color-mix(in srgb, var(--line-strong) 68%, transparent);
    background:
      linear-gradient(135deg, color-mix(in srgb, var(--surface-2) 76%, transparent), transparent 65%),
      color-mix(in srgb, var(--surface) 72%, transparent);
  }

  .about-person__mark img {
    display: block;
    width: min(100%, 7rem);
    height: auto;
  }

  .about-panel h2 {
    margin: 0;
    font-size: clamp(1.55rem, 2.7vw, 2.4rem);
    line-height: 0.98;
    letter-spacing: -0.06em;
  }

  .about-person__copy,
  .about-panel__lede,
  .about-list li,
  .about-start__body p {
    color: var(--text);
    line-height: 1.72;
  }

  .about-person__copy {
    display: grid;
    gap: 0.75rem;
  }

  .about-panel__lede {
    margin: 0;
    max-width: 38rem;
    color: var(--muted);
  }

  .about-questions {
    display: grid;
    margin-top: 0.2rem;
    border-top: 1px solid color-mix(in srgb, var(--line-strong) 72%, transparent);
  }

  .about-question {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 0.85rem;
    align-items: start;
    padding: 0.95rem 0;
    border-bottom: 1px solid color-mix(in srgb, var(--line-strong) 50%, transparent);
  }

  .about-question:last-child {
    border-bottom: 0;
  }

  .about-question__mark {
    color: var(--accent);
    font-size: 0.9rem;
    line-height: 1;
    transform: translateY(0.1rem);
  }

  .about-question p {
    margin: 0;
    font-size: 1rem;
    line-height: 1.6;
  }

  .about-page__dual {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: clamp(1rem, 2.4vw, 1.8rem);
    padding-top: 0.5rem;
    border-top: 1px solid color-mix(in srgb, var(--line-strong) 72%, transparent);
  }

  .about-list {
    display: grid;
    gap: 0.9rem;
    padding-top: 0.15rem;
  }

  .about-list--leaving {
    padding-left: clamp(0.75rem, 1.8vw, 1.35rem);
    border-inline-start: 1px solid color-mix(in srgb, var(--line-strong) 64%, transparent);
  }

  .about-list ul {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.8rem;
  }

  .about-list li {
    position: relative;
    padding-left: 1.05rem;
  }

  .about-list li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.7em;
    width: 0.35rem;
    height: 0.35rem;
    border-radius: 999px;
    background: var(--accent);
    box-shadow: 0 0 0 1px color-mix(in srgb, var(--accent) 24%, transparent);
  }

  .about-start {
    display: grid;
    gap: 1rem;
    padding: 1rem;
    border: 1px solid color-mix(in srgb, var(--line-strong) 78%, transparent);
    background:
      linear-gradient(180deg, color-mix(in srgb, var(--surface) 74%, transparent), color-mix(in srgb, var(--surface-2) 62%, transparent));
  }

  .about-start__title {
    margin: 0;
    max-width: 40rem;
    font-size: clamp(1.35rem, 2.2vw, 1.95rem);
    line-height: 1.06;
    letter-spacing: -0.05em;
  }

  .about-start__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0;
    align-items: stretch;
  }

  .about-start__path {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    gap: 0.9rem;
    align-items: start;
    padding: 0.9rem 1rem;
  }

  .about-start__path--thinking {
    padding-right: 1.15rem;
    border-inline-end: 1px solid color-mix(in srgb, var(--line-strong) 64%, transparent);
  }

  .about-start__icon {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    color: var(--accent);
    flex: 0 0 auto;
  }

  .about-start__icon svg {
    width: 1.1rem;
    height: 1.1rem;
  }

  .about-start__body {
    display: grid;
    gap: 0.4rem;
    min-width: 0;
  }

  .about-start__action {
    color: var(--text);
    font-family: var(--font-title);
    font-size: clamp(1.1rem, 1.6vw, 1.3rem);
    line-height: 1.1;
    letter-spacing: -0.03em;
    transition: color 180ms ease, transform 180ms ease;
  }

  .about-start__body p:last-child {
    margin: 0;
    max-width: 24rem;
    color: var(--muted);
  }

  .about-start__action:hover,
  .about-start__action:focus-visible {
    color: var(--accent);
    transform: translateX(0.15rem);
  }

  @media (max-width: 980px) {
    .about-page__intro-grid,
    .about-page__dual,
    .about-start__grid {
      grid-template-columns: 1fr;
    }

    .about-panel--person,
    .about-panel--thinking,
    .about-list--leaving,
    .about-start__path--thinking {
      padding-left: 0;
      padding-right: 0;
      border-inline: 0;
      border-top: 1px solid color-mix(in srgb, var(--line-strong) 64%, transparent);
    }

    .about-panel--person {
      border-top: 0;
      padding-top: 0;
    }

    .about-person,
    .about-start__path {
      grid-template-columns: 1fr;
    }

    .about-person__mark {
      min-height: 8.75rem;
      width: min(100%, 14rem);
    }
  }

  @media (max-width: 640px) {
    .about-page {
      padding-top: 0.95rem;
      gap: 1rem;
    }

    .about-page__hero-copy,
    .about-panel__lede,
    .about-start__title {
      max-width: none;
    }

    .about-page__title {
      font-size: clamp(2.6rem, 12vw, 3.8rem);
    }

    .about-start {
      padding: 0.9rem;
    }
  }
</style>
