---
import BaseLayout from "../layouts/BaseLayout.astro";
import type { Locale } from "../lib/i18n";
import TopologyScene from "operational-topology/astro/TopologyScene";
import { createHexGrid } from "operational-topology";
import { getGridBounds } from "../../node_modules/operational-topology/src/topology/hex.ts";
import { fitCameraToEntities } from "../../node_modules/operational-topology/src/topology/cameraMath.ts";
import { prepareTopologyRenderFrame } from "../../node_modules/operational-topology/src/topology/renderPipeline.ts";
import { renderTopologyGridMarkup } from "../../node_modules/operational-topology/src/topology/TopologyGridRenderer.ts";
import {
  createIncidentPresentationSlides,
  createIncidentScenePreset,
  formatIncidentDateTime,
  getIncidentById,
  getIncidentStatusTone,
  getPublishedIncidents,
} from "../lib/incidents";

interface Props { incident: any; locale: Locale; }
const { incident, locale } = Astro.props as Props;
const slides = createIncidentPresentationSlides(incident).map((slide, index) => {
  const sourceScene = incident.scenes[index];
  const inspector = sourceScene.inspector as typeof sourceScene.inspector & { nodeDetails?: Record<string, any>; timeline?: Array<{ time: string; event: string }> };
  const rootNodeId = (sourceScene as typeof sourceScene & { rootNodeId?: string }).rootNodeId ?? slide.topology.nodes.find((node) => node.selected)?.id ?? slide.topology.nodes[0]?.id ?? "";
  const rootDetail = inspector.nodeDetails?.root ?? {
    title: inspector.title,
    body: inspector.body,
    facts: inspector.facts,
    highlights: sourceScene.highlights,
    actions: sourceScene.actions,
  };

  return {
    id: slide.id,
    label: slide.subtitle ?? slide.title,
    title: slide.title,
    summary: slide.summary,
    status: slide.status,
    topologyLayout: slide.topologyLayout,
    sceneLayout: slide.sceneLayout,
    topology: slide.topology,
    route: slide.route,
    transition: slide.transition,
    rootNodeId,
    nodeDetails: { root: rootDetail, ...(inspector.nodeDetails ?? {}) },
    actions: sourceScene.actions,
    highlights: sourceScene.highlights,
    timeline: inspector.timeline ?? [],
  };
});

const activeSlide = slides[0];
const activeScenePreset = createIncidentScenePreset(incident.scenes[0]);
const deckRadius = 30;
const sceneColumns = 38;
const sceneRows = 38;
const sceneOriginQ = Math.floor(-(sceneColumns / 2));
const sceneOriginR = Math.floor(-(sceneRows / 2));
const initialCells = createHexGrid({
  radius: deckRadius,
  columns: sceneColumns,
  rows: sceneRows,
  originQ: sceneOriginQ,
  originR: sceneOriginR,
});
const initialSceneBounds = getGridBounds(initialCells, deckRadius);
const miniMapMarkup = renderTopologyGridMarkup({
  frame: prepareTopologyRenderFrame({
    cells: initialCells,
    occupants: [],
    relationships: activeSlide.topology.relationships ?? [],
  }),
  radius: deckRadius,
  showNodes: false,
  className: "incident-deck__mini-map-grid",
  connectorRouting: activeSlide.topology.connectorRouting ?? activeScenePreset.connectorRouting,
})
  .replace('class="topology-grid incident-deck__mini-map-grid"', 'class="topology-grid incident-deck__mini-map-grid" data-topology-mini-map')
  .replaceAll('data-cell-id="', 'data-topology-mini-cell-id="')
  .replace(
    '</svg>',
    '<rect data-topology-mini-map-frame class="topology-mini-map__frame is-hidden" fill="none" /><g class="topology-mini-map__connectors" aria-hidden="true"></g><g class="topology-mini-map__nodes" aria-hidden="true"></g></svg>',
  );
const serializedSlides = JSON.stringify(slides);
---
<BaseLayout locale={locale}
  title={`${incident.incidentId} | Incident Library | thisisgenaro.com`}
  description={incident.summary}
>
  <main class="incident-deck">
    <div class="incident-deck__mobile-tabs" data-incident-deck-mobile-tabs role="tablist" aria-label="Incident workspace">
      <button type="button" class="incident-deck__mobile-tab is-active" data-incident-deck-mobile-tab="visual" role="tab" aria-selected="true">Visual</button>
      <button type="button" class="incident-deck__mobile-tab" data-incident-deck-mobile-tab="inspector" role="tab" aria-selected="false">Inspector</button>
    </div>
    <section class="incident-deck__scene-shell" data-incident-deck-shell>
      <div
        class="incident-deck__scene-frame"
        data-incident-deck-scene
        data-deck-radius={deckRadius}
        data-scene-columns={sceneColumns}
        data-scene-rows={sceneRows}
        data-scene-bounds={JSON.stringify(initialSceneBounds)}
        data-active-slide={activeSlide.id}
      >
        <TopologyScene
          class="incident-deck__scene-view"
          nodes={activeSlide.topology.nodes}
          edges={activeSlide.topology.relationships ?? []}
          cells={initialCells}
          {...activeScenePreset}
          radius={deckRadius}
          ambientSignals={false}
          connectorRouting={activeSlide.topology.connectorRouting ?? activeScenePreset.connectorRouting}
          topologyLayout={activeSlide.topologyLayout}
          signalTransitionSpeed={0.95}
        />
      </div>

      <div class="incident-deck__scene-map surface surface-pad" data-incident-deck-map>
        <div class="incident-deck__scene-map-head">
          <div>
            <p class="incident-deck__inspector-label mono">World map</p>
            <strong data-topology-mini-map-readout>Ready</strong>
            <span class="incident-deck__scene-map-caption" data-incident-deck-mini-caption>{activeSlide.label}</span>
          </div>
          <span class="incident-deck__scene-map-hint mono">Camera</span>
        </div>
        <div class="incident-deck__scene-map-frame" set:html={miniMapMarkup}></div>
        <div class="incident-deck__scene-map-actions" aria-label="Camera controls">
          <button type="button" class="incident-deck__scene-map-action" data-topology-mini-map-action="zoom-out" aria-label="Zoom out">−</button>
          <button type="button" class="incident-deck__scene-map-action" data-topology-mini-map-action="fit" aria-label="Fit camera">Fit</button>
          <button type="button" class="incident-deck__scene-map-action" data-topology-mini-map-action="center" aria-label="Center on selection">Center</button>
          <button type="button" class="incident-deck__scene-map-action" data-topology-mini-map-action="zoom-in" aria-label="Zoom in">+</button>
        </div>
      </div>

    </section>

    <aside class="incident-deck__inspector surface surface-pad" data-incident-deck-inspector data-inspector-collapsed="false">
      <div class="incident-deck__inspector-toolbar">
        <div>
          <p class="incident-deck__inspector-label mono">Incident inspector</p>
        </div>
        <button type="button" class="incident-deck__inspector-toggle" data-incident-deck-inspector-toggle aria-expanded="true">Collapse</button>
      </div>
      <div class="incident-deck__inspector-collapsed-mark" aria-hidden="true"><span>◇</span><small>Inspector</small></div>
      <div class="incident-deck__inspector-panel" data-incident-deck-inspector-panel>
        <div class="incident-deck__inspector-grid">
        <section class="incident-deck__identity">
          <p class="incident-deck__inspector-label mono">Incident identity</p>
          <h1>{incident.incidentId}</h1>
          <p class="incident-deck__identity-title">{incident.title}</p>
          <div class="incident-deck__identity-meta">
            <div>
              <span>{locale === "es" ? "Estado" : "Status"}</span>
              <strong class:list={["incident-status-pill", `is-${getIncidentStatusTone(incident.status)}`]}>{incident.status}</strong>
            </div>
            <div>
              <span>{locale === "es" ? "Severidad" : "Severity"}</span>
              <strong>{incident.severity}</strong>
            </div>
            <div>
              <span>{locale === "es" ? "Inicio" : "Started"}</span>
              <strong>{formatIncidentDateTime(incident.opened ?? incident.created)}</strong>
            </div>
            <div>
              <span>{locale === "es" ? "Restaurado" : "Restored"}</span>
              <strong>{incident.restored ? formatIncidentDateTime(incident.restored) : (incident.closed ? formatIncidentDateTime(incident.closed) : (locale === "es" ? "Abierto" : "Open"))}</strong>
            </div>
            <div>
              <span>{locale === "es" ? "Organización" : "Organization"}</span>
              <strong>{incident.organization}</strong>
            </div>
            <div>
              <span>{locale === "es" ? "Solicitante" : "Requester"}</span>
              <strong>{incident.requester}</strong>
            </div>
            <div>
              <span>{locale === "es" ? "Servicio afectado" : "Affected service"}</span>
              <strong>{incident.service}</strong>
            </div>
            <div>
              <span>{locale === "es" ? "Categoría" : "Category"}</span>
              <strong>{incident.category}</strong>
            </div>
          </div>
        </section>

        <section class="incident-deck__scene-note">
          <div class="incident-deck__inspector-head">
            <div>
              <p class="incident-deck__inspector-label mono" data-incident-deck-current-label>{activeSlide.label}</p>
              <h2 data-incident-inspector-title>{activeSlide.nodeDetails.root.title}</h2>
            </div>

          </div>

          <p class="incident-deck__inspector-body" data-incident-inspector-body>{activeSlide.nodeDetails.root.body}</p>

          <div class="incident-deck__facts" data-incident-inspector-facts>
            {activeSlide.nodeDetails.root.facts.map((fact) => <p>{fact}</p>)}
          </div>

          <ol class="incident-deck__timeline" data-incident-inspector-timeline hidden>
            {activeSlide.timeline.map((entry) => <li><time>{entry.time}</time><span>{entry.event}</span></li>)}
          </ol>

          <ul class="incident-deck__highlights" data-incident-inspector-highlights hidden={!activeSlide.highlights.length}>
            {activeSlide.highlights.map((highlight) => <li>{highlight}</li>)}
          </ul>

          <div class="incident-deck__actions" data-incident-inspector-actions>
            {activeSlide.actions.map((action) => (
              <a href={`#${action.target}`}>{action.label} →</a>
            ))}
          </div>
        </section>
      </div>
      </div>
    </aside>

      <div class="incident-deck__scene-controls" aria-label="Incident scene navigation">
        <button
          type="button"
          class="incident-deck__scene-step"
          data-incident-deck-step="previous"
          aria-label="Previous scene"
        >
          <span aria-hidden="true">←</span>
          <span>Previous</span>
        </button>

        <label class="incident-deck__scene-select-wrap">
          <span class="mono">Scene</span>
          <select class="incident-deck__scene-select" data-incident-deck-select aria-label="Select incident scene">
            {slides.map((slide) => (
              <option value={slide.id} selected={slide.id === activeSlide.id}>
                {slide.label}
              </option>
            ))}
          </select>
        </label>

        <button
          type="button"
          class="incident-deck__scene-step"
          data-incident-deck-step="next"
          aria-label="Next scene"
        >
          <span>Next</span>
          <span aria-hidden="true">→</span>
        </button>
      </div>
    <script type="application/json" data-incident-deck-slides set:html={serializedSlides}></script>
    <script>
      import { createHexGrid } from "operational-topology";
      import { createTopologyDatasetTransition } from "operational-topology/browser";
      import { fitCameraToEntities } from "../../node_modules/operational-topology/src/topology/cameraMath.ts";
      import { getGridBounds } from "../../node_modules/operational-topology/src/topology/hex.ts";
      import { prepareTopologyRenderFrame } from "../../node_modules/operational-topology/src/topology/renderPipeline.ts";
      import { renderTopologyGridMarkup } from "../../node_modules/operational-topology/src/topology/TopologyGridRenderer.ts";
      import { createTopologyContentPageController } from "operational-topology/browser";

      const deck = document.querySelector(".incident-deck");
      const mobileTabs = document.querySelector("[data-incident-deck-mobile-tabs]");
      const mobileTabButtons = [...document.querySelectorAll("[data-incident-deck-mobile-tab]")];
      const shell = document.querySelector("[data-incident-deck-shell]");
      const sceneHost = document.querySelector("[data-incident-deck-scene]");
      const topologyScene = sceneHost?.querySelector(".topology-scene");
      const slidesPayload = document.querySelector("[data-incident-deck-slides]");
      const currentLabel = document.querySelector("[data-incident-deck-current-label]");
      const inspectorTitle = document.querySelector("[data-incident-inspector-title]");
      const inspectorBody = document.querySelector("[data-incident-inspector-body]");
      const inspectorFacts = document.querySelector("[data-incident-inspector-facts]");
      const inspectorHighlights = document.querySelector("[data-incident-inspector-highlights]");
      const inspectorTimeline = document.querySelector("[data-incident-inspector-timeline]");
      const inspectorActions = document.querySelector("[data-incident-inspector-actions]");
      const miniCaption = document.querySelector("[data-incident-deck-mini-caption]");
      const select = document.querySelector("[data-incident-deck-select]");
      const prevButton = document.querySelector('[data-incident-deck-step="previous"]');
      const nextButton = document.querySelector('[data-incident-deck-step="next"]');
      const sceneSvg = sceneHost?.querySelector(".topology-grid");
      const miniMapRoot = shell?.querySelector("[data-topology-mini-map]");
      const miniMapConnectors = shell?.querySelector(".topology-mini-map__connectors");
      const inspector = document.querySelector("[data-incident-deck-inspector]");
      const inspectorToggle = document.querySelector("[data-incident-deck-inspector-toggle]");
      const inspectorPanel = document.querySelector("[data-incident-deck-inspector-panel]");
      const deckRadius = Number(sceneHost?.getAttribute("data-deck-radius") ?? 36);
      const sceneColumns = Number(sceneHost?.getAttribute("data-scene-columns") ?? 38);
      const sceneRows = Number(sceneHost?.getAttribute("data-scene-rows") ?? 18);
      const initialSceneBounds = JSON.parse(sceneHost?.getAttribute("data-scene-bounds") ?? "{}");
      const slides = slidesPayload ? JSON.parse(slidesPayload.textContent || "[]") : [];
      const liveSceneCells = createHexGrid({
        radius: deckRadius,
        columns: sceneColumns,
        rows: sceneRows,
        originQ: Math.floor(-(sceneColumns / 2)),
        originR: Math.floor(-(sceneRows / 2)),
      });
      let liveSceneBounds = initialSceneBounds;
      let initialFitScheduled = false;
      let inspectorCollapsed = false;
      let updateInspector = () => {};

      const setMobileMode = (mode) => {
        if (!deck || !mobileTabs) return;
        deck.dataset.mobileMode = mode;
        mobileTabButtons.forEach((button) => {
          const active = button.dataset.incidentDeckMobileTab === mode;
          button.classList.toggle("is-active", active);
          button.setAttribute("aria-selected", String(active));
        });
      };

      setMobileMode("visual");

      if (shell && sceneHost && topologyScene && sceneSvg && slides.length) {
        let activeSlide = slides[0];
        let transition = null;
        const activeNodeId = activeSlide.rootNodeId ?? activeSlide.topology.nodes[0]?.id ?? "";
        const contentController = createTopologyContentPageController({
          scene: topologyScene,
          initialId: activeNodeId,
          relationships: activeSlide.topology.relationships ?? [],
          navigation: {
            shell,
            nodes: activeSlide.topology.nodes,
            worldRadius: deckRadius,
            worldBounds: liveSceneBounds,
            zoomStep: 0.08,
            transitionDuration: 260,
            fitOnInit: false,
            interactiveMiniMap: true,
            enableSceneGestures: true,
            enableSceneWheel: true,
            resizeTargets: [shell, sceneHost],
          },
          onSelection: (selection) => {
            updateInspector(activeSlide, selection.entityId);
          },
        });
        const navigation = contentController.navigation;

        updateInspector = (slide, selectedNodeId = slide.rootNodeId) => {
          const detail = slide.nodeDetails?.[selectedNodeId] ?? slide.nodeDetails?.root;
          if (!detail) return;
          const isRoot = selectedNodeId === slide.rootNodeId || !slide.nodeDetails?.[selectedNodeId];
          if (currentLabel) currentLabel.textContent = isRoot ? slide.label : (slide.topology.nodes.find((node) => node.id === selectedNodeId)?.label ?? slide.label);
          if (inspectorTitle) inspectorTitle.textContent = detail.title;
          if (inspectorBody) inspectorBody.textContent = detail.body;

          if (inspectorFacts) {
            inspectorFacts.replaceChildren(
              ...(detail.facts ?? []).map((fact) => {
                const p = document.createElement("p");
                p.textContent = fact;
                return p;
              }),
            );
          }

          if (inspectorTimeline) {
            const timeline = isRoot ? (slide.timeline ?? []) : (detail.timeline ?? []);
            inspectorTimeline.hidden = !timeline.length;
            inspectorTimeline.replaceChildren(
              ...timeline.map((entry) => {
                const li = document.createElement("li");
                const time = document.createElement("time");
                const event = document.createElement("span");
                time.textContent = entry.time;
                event.textContent = entry.event;
                li.append(time, event);
                return li;
              }),
            );
          }

          if (inspectorHighlights) {
            const highlights = detail.highlights ?? [];
            inspectorHighlights.hidden = !highlights.length;
            inspectorHighlights.replaceChildren(
              ...highlights.map((highlight) => {
                const li = document.createElement("li");
                li.textContent = highlight;
                return li;
              }),
            );
          }

          if (inspectorActions) {
            const actions = detail.actions ?? slide.actions;
            inspectorActions.replaceChildren(
              ...actions.map((action) => {
                const link = document.createElement("a");
                link.href = `#${action.target}`;
                link.textContent = `${action.label} →`;
                return link;
              }),
            );
          }

          if (miniCaption) miniCaption.textContent = slide.label;
          updateMiniMap(slide);
          if (select) select.value = slide.id;
        };
        const updateMiniMap = (slide) => {
          if (!miniMapConnectors) return;

          const miniMarkup = renderTopologyGridMarkup({
            frame: prepareTopologyRenderFrame({
              cells: liveSceneCells,
              occupants: [],
              relationships: slide.topology.relationships ?? [],
            }),
            radius: deckRadius,
            showNodes: false,
            className: "incident-deck__mini-map-grid",
            connectorRouting: slide.topology.connectorRouting ?? activeScenePreset.connectorRouting,
          });

          const parsed = new DOMParser().parseFromString(miniMarkup, "image/svg+xml");
          const connectorGroup = parsed.querySelector(".grid-connectors");
          if (connectorGroup) {
            miniMapConnectors.innerHTML = connectorGroup.innerHTML;
          }
        };

        const setInspectorCollapsed = (nextCollapsed) => {
          inspectorCollapsed = nextCollapsed;
          deck?.classList.toggle("is-inspector-collapsed", inspectorCollapsed);
          inspector?.classList.toggle("is-collapsed", inspectorCollapsed);
          inspector?.setAttribute("data-inspector-collapsed", String(inspectorCollapsed));
          if (inspectorToggle) {
            inspectorToggle.setAttribute("aria-expanded", String(!inspectorCollapsed));
            inspectorToggle.textContent = inspectorCollapsed ? "›" : "Collapse";
          }
          requestAnimationFrame(() => navigation.viewport.updateViewport());
        };

        mobileTabButtons.forEach((button) => {
          button.addEventListener("click", () => setMobileMode(button.dataset.incidentDeckMobileTab ?? "visual"));
        });

        const fitDeckCamera = (nodes) => {
          const camera = navigation.viewport.getCamera();
          return fitCameraToEntities({
            entities: nodes,
            viewportWidth: camera.viewportWidth,
            viewportHeight: camera.viewportHeight,
            radius: deckRadius,
            padding: deckRadius * 1.15,
          });
        };

        const updateButtons = () => {
          const index = slides.findIndex((slide) => slide.id === activeSlide.id);
          if (prevButton) prevButton.dataset.target = slides[(index - 1 + slides.length) % slides.length].id;
          if (nextButton) nextButton.dataset.target = slides[(index + 1) % slides.length].id;
        };

        const rebuildTransition = () => {
          transition?.destroy?.();
          transition = createTopologyDatasetTransition({
            sceneGrid: sceneSvg,
            cells: liveSceneCells,
            radius: deckRadius,
            connectorRouting: activeSlide.topology.connectorRouting ?? "obstacle-aware",
          });
        };

        const syncSceneGeometry = () => {
          updateMiniMap(activeSlide);
          navigation.viewport.updateViewport();
          rebuildTransition();
          Promise.resolve(transition.transition(activeSlide.topology));
          if (!initialFitScheduled) {
            initialFitScheduled = true;
            requestAnimationFrame(() =>
              requestAnimationFrame(() => navigation.viewport.applyCamera(fitDeckCamera(activeSlide.topology.nodes))),
            );
          }
        };

        const moveToSlide = async (slideId) => {
          const nextSlide = slides.find((slide) => slide.id === slideId);
          if (!nextSlide || nextSlide.id === activeSlide.id) return;

          activeSlide = nextSlide;
          const nextFocusId = nextSlide.rootNodeId ?? nextSlide.topology.nodes[0]?.id ?? "";
          updateMiniMap(nextSlide);
          if (miniCaption) {
            miniCaption.textContent = nextSlide.label;
          }
          rebuildTransition();
          updateButtons();
          await Promise.resolve(transition.transition(nextSlide.topology));
          topologyScene.dispatchEvent(new CustomEvent("topology-dataset-updated", {
            detail: {
              nodes: nextSlide.topology.nodes,
              relationships: nextSlide.topology.relationships ?? [],
              selectedId: nextFocusId,
            },
          }));
          contentController.syncTopology(nextSlide.topology.nodes, nextSlide.topology.relationships ?? [], liveSceneBounds, nextFocusId);
          updateInspector(nextSlide, nextFocusId);
        };

        prevButton?.addEventListener("click", () => {
          const index = slides.findIndex((slide) => slide.id === activeSlide.id);
          moveToSlide(slides[(index - 1 + slides.length) % slides.length].id);
        });

        nextButton?.addEventListener("click", () => {
          const index = slides.findIndex((slide) => slide.id === activeSlide.id);
          moveToSlide(slides[(index + 1) % slides.length].id);
        });

        const handleSelect = (event) => {
          const target = event.currentTarget?.value;
          if (target) moveToSlide(target);
        };

        select?.addEventListener("input", handleSelect);
        select?.addEventListener("change", handleSelect);

        // Dataset transitions replace the occupant nodes, so delegate selection
        // from the stable SVG root for every incoming slide node. Initial OTF-bound
        // nodes are skipped to avoid duplicate selection events.
        const handleDelegatedNodeClick = (event) => {
          const target = event.target instanceof Element
            ? event.target.closest(".grid-occupant[data-node-id]")
            : null;
          if (!target || target.getAttribute("data-bound") === "true" || target.getAttribute("data-incident-deck-bound") === "true") return;
          const nodeId = target.getAttribute("data-node-id");
          if (!nodeId) return;
          contentController.select(nodeId);
        };
        const handleDelegatedNodeKeydown = (event) => {
          if (!(event instanceof KeyboardEvent) || (event.key !== "Enter" && event.key !== " ")) return;
          const target = event.target instanceof Element
            ? event.target.closest(".grid-occupant[data-node-id]")
            : null;
          if (!target || target.getAttribute("data-bound") === "true" || target.getAttribute("data-incident-deck-bound") === "true") return;
          event.preventDefault();
          const nodeId = target.getAttribute("data-node-id");
          if (!nodeId) return;
          contentController.select(nodeId);
        };
        sceneHost.addEventListener("pointerup", handleDelegatedNodeClick);
        sceneHost.addEventListener("click", handleDelegatedNodeClick);
        sceneHost.addEventListener("keydown", handleDelegatedNodeKeydown);

        // Dataset transitions inject new occupant groups after TopologyScene
        // performs its initial interaction binding. Bind those incoming nodes
        // directly so they remain selectable throughout the scene handoff.
        const bindTransitionNodes = () => {
          sceneHost.querySelectorAll(".grid-occupant[data-node-id]").forEach((node) => {
            if (node.getAttribute("data-bound") === "true" || node.getAttribute("data-incident-deck-bound") === "true") return;
            if (node.getAttribute("aria-disabled") === "true") return;
            node.setAttribute("data-incident-deck-bound", "true");
            node.addEventListener("click", () => {
              const nodeId = node.getAttribute("data-node-id");
              if (!nodeId) return;
              contentController.select(nodeId);
            });
            node.addEventListener("keydown", (event) => {
              if (!(event instanceof KeyboardEvent) || (event.key !== "Enter" && event.key !== " ")) return;
              event.preventDefault();
              const nodeId = node.getAttribute("data-node-id");
              if (!nodeId) return;
              contentController.select(nodeId);
            });
          });
        };
        const transitionNodeObserver = new MutationObserver(bindTransitionNodes);
        transitionNodeObserver.observe(sceneHost, { childList: true, subtree: true });
        bindTransitionNodes();

        rebuildTransition();
        updateInspector(activeSlide, activeSlide.rootNodeId);
        updateMiniMap(activeSlide);
        updateButtons();
        setInspectorCollapsed(false);
        Promise.resolve(transition.transition(activeSlide.topology));
        // The OTF navigation controller owns responsive viewport updates.
        // Avoid rebuilding the dataset transition during mobile pinch/resize gestures.
        syncSceneGeometry();

        inspectorToggle?.addEventListener("click", () => setInspectorCollapsed(!inspectorCollapsed));

        window.addEventListener(
          "pagehide",
          () => {
            sceneHost.removeEventListener("pointerup", handleDelegatedNodeClick);
