---

import { getCollection } from "astro:content";
import { createPresentationTopology } from "operational-topology";
import TopologyScene from "operational-topology/astro/TopologyScene";
import BaseLayout from "../layouts/BaseLayout.astro";
import { organizations } from "../data/organizations";
import { createJournalEntryRecords, getJournalEntriesForLanguage } from "../lib/journal";
import { createIncidentPreviewTopology, formatIncidentDate, getLocalizedIncidentById, getPublishedIncidents } from "../lib/incidents";
import { getLocaleFromPath, localePath, ui, type Locale } from "../lib/i18n";

interface Props { locale?: Locale; }
const { locale: requestedLocale } = Astro.props as Props;
const locale = requestedLocale ?? getLocaleFromPath(Astro.url.pathname) ?? "en";
const strings = ui[locale];
const t = (en: string, es: string) => locale === "es" ? es : en;

const entries = getJournalEntriesForLanguage(await getCollection("entries"), locale);
const journalRecords = createJournalEntryRecords(entries);
const latestEntry = journalRecords[0] ?? null;
const incidents = getPublishedIncidents();
const latestIncident = incidents[0] ? getLocalizedIncidentById(incidents[0].id, locale) : null;
const latestOrganization = latestIncident
  ? organizations.find((organization) => organization.id === latestIncident.organizationId) ?? null
  : null;

const heroNodeContent = [
  { id: "evidence", label: "Evidence", subtitle: "ORIGIN", status: "healthy", variant: "root" as const, size: "lg" as const, selected: true },
  { id: "systems", label: "Systems", subtitle: "STRUCTURE", status: "healthy", variant: "anchor" as const },
  { id: "signals", label: "Signals", subtitle: "VISIBILITY", status: "healthy" },
  { id: "dependencies", label: "Dependencies", subtitle: "CONTEXT", status: "degraded", variant: "anchor" as const },
  { id: "incidents", label: "Incidents", subtitle: "INVESTIGATE", status: "degraded" },
  { id: "patterns", label: "Patterns", subtitle: "INTERPRET", status: "healthy", variant: "anchor" as const },
  { id: "decisions", label: "Decisions", subtitle: "IMPROVE", status: "healthy" },
];

const heroRing = createPresentationTopology({
  id: "home-knowledge",
  title: "Evidence",
  subtitle: "Origin",
  sceneLayout: "viewport-fit",
  topologyLayout: "ring",
  anchors: heroNodeContent.slice(1).map((node) => ({
    id: node.id,
    label: node.label,
    subtitle: node.subtitle,
    children: [],
  })),
});
const heroGeneratedRootId = "presentation-home-knowledge-root";
const heroGeneratedAnchorPrefix = "presentation-home-knowledge-anchor-";
const heroRingDisplayScale = 3;
const heroContentById = new Map(heroNodeContent.map((node) => [node.id, node]));
const heroPublicNodeId = (generatedId: string) =>
  generatedId === heroGeneratedRootId ? "evidence" : generatedId.replace(heroGeneratedAnchorPrefix, "");

const heroNodes = heroRing.nodes.map((node) => {
  const id = heroPublicNodeId(node.id);
  return {
    ...node,
    ...heroContentById.get(id),
    id,
    q: node.q * heroRingDisplayScale,
    r: node.r * heroRingDisplayScale,
  };
});

const heroEdges = [
  { from: "systems", to: "evidence", label: "produces", active: false },
  { from: "signals", to: "evidence", label: "reveals", active: false },
  { from: "dependencies", to: "evidence", label: "shapes", active: false },
  { from: "evidence", to: "incidents", label: "documents", active: false },
  { from: "evidence", to: "patterns", label: "exposes", active: false },
  { from: "patterns", to: "decisions", label: "informs", active: false },
  { from: "decisions", to: "systems", label: "improves", active: false },
];

const incidentPreviewTopology = latestIncident ? createIncidentPreviewTopology(latestIncident) : null;

const perspectives = [
  { title: "Infrastructure", copy: "Architecture, continuity, and the operating structure beneath services.", path: "M4 18h16M6 18V8h5v10m2 0V4h5v14M8 11h1m6-3h1m-1 4h1" },
  { title: "Observability", copy: "Signals, telemetry, and the practice of seeing systems clearly.", path: "M3.5 12s3.2-5 8.5-5 8.5 5 8.5 5-3.2 5-8.5 5-8.5-5-8.5-5zm8.5 2.5a2.5 2.5 0 1 0 0-5 2.5 2.5 0 0 0 0 5z" },
  { title: "Dependencies", copy: "The hidden relationships that turn component health into service outcomes.", path: "M7 7h4v4H7zM13 13h4v4h-4zM11 9h4v4m-6-2v4h4" },
  { title: "Reliability", copy: "Resilience earned through design, review, recovery, and follow-through.", path: "M12 3.5 19 7v5c0 4.4-2.8 7.1-7 8.5C7.8 19.1 5 16.4 5 12V7l7-3.5zm-3 8.7 2 2 4-4" },
  { title: "Incident Analysis", copy: "Evidence-led investigation of impact, causes, and operational lessons.", path: "M10.5 5.5a5 5 0 1 0 0 10 5 5 0 0 0 0-10zm3.8 8.8L19 19m-8.5-10v3m0 1.8h.01" },
  { title: "Automation", copy: "Repeatable work that reduces drift and keeps operations understandable.", path: "M7 5h10v4H7zM5 15h5v4H5zm9 0h5v4h-5zM12 9v3m-4.5 3v-3h9v3" },
];

const localizedPerspectives = locale === "es" ? [
  { title: "Infraestructura", copy: "Arquitectura, continuidad y estructura operativa bajo los servicios.", path: perspectives[0].path },
  { title: "Observabilidad", copy: "Señales útiles para distinguir el síntoma de la condición real.", path: perspectives[1].path },
  { title: "Dependencias", copy: "Relaciones que explican cómo un cambio se propaga por el sistema.", path: perspectives[2].path },
  { title: "Confiabilidad", copy: "Diseño y práctica para mantener servicios previsibles bajo presión.", path: perspectives[3].path },
  { title: "Análisis de incidentes", copy: "Evidencia, contexto y razonamiento para entender qué ocurrió.", path: perspectives[4].path },
  { title: "Automatización", copy: "Reducir trabajo repetitivo para dejar más espacio al juicio técnico.", path: perspectives[5].path },
] : perspectives;

const severityCode = ["high", "alto"].includes(latestIncident?.severity.toLowerCase() ?? "") ? "SEV-2" : latestIncident?.severity.toUpperCase();
---

<BaseLayout locale={locale}
  title={`Genaro Hernández | ${locale === "es" ? "Infraestructura, observabilidad y confiabilidad" : "Infrastructure, Observability & Reliability"}`}
  description={locale === "es" ? strings.pages.homeStatement : "Engineering ideas, incident investigations, and the connected world of systems and dependencies behind them."}
>
  <main class="home-v2">
    <section class="home-hero" aria-labelledby="home-title">
      <div class="home-hero__copy">
        <p class="home-eyebrow">{strings.pages.homeEyebrow}</p>
        <h1 id="home-title">Genaro Hernández</h1>
        <p class="home-domains" aria-label="Engineering domains">
          <span>Infrastructure</span><i></i><span>Observability</span><i></i><span>Reliability</span><i></i><span>Engineering</span>
        </p>
        <p class="home-hero__statement">
          {strings.pages.homeStatement}
        </p>
        <div class="home-hero__actions" aria-label="Explore the knowledge system">
          <a class="home-button home-button--primary" href={localePath(locale, "/journal")}>{strings.actions.exploreJournal} <span>→</span></a>
          <a class="home-button" href={localePath(locale, "/incident-library")}>{strings.actions.exploreIncidents} <span>→</span></a>
          <a class="home-button" href={localePath(locale, "/world")}>{strings.actions.exploreWorld} <span>→</span></a>
        </div>
      </div>

      <figure class="home-hero__topology" aria-label="Connected operational knowledge topology">
        <TopologyScene
          class="home-hero__scene"
          nodes={heroNodes}
          edges={heroEdges}
          layout="viewport-fit"
          viewportFit={true}
          topologyLayout="ring"
          radius={22}
          showGridNodes={false}
          gridActivity={false}
          ambientSignals={true}
          connectorRouting="obstacle-aware"
          signalTransitionSpeed={0.95}
        />
        <figcaption><span>{t("SYSTEMS", "SISTEMAS")}</span><span>{t("RELATIONSHIPS", "RELACIONES")}</span><span>{t("EVIDENCE", "EVIDENCIA")}</span></figcaption>
      </figure>
    </section>

    <section class="home-section home-knowledge" id="knowledge-system" aria-labelledby="knowledge-title">
      <header class="home-section__header home-section__header--split">
        <div>
          <p class="home-eyebrow">{t("THE KNOWLEDGE SYSTEM", "EL SISTEMA DE CONOCIMIENTO")}</p>
          <h2 id="knowledge-title">{t("Thinking and evidence, kept connected.", "Pensamiento y evidencia, conectados.")}</h2>
        </div>
        <p>{t("Read ideas, study incidents, then explore the organizations and dependencies that give both their context.", "Lee ideas, estudia incidentes y explora las organizaciones y dependencias que dan contexto a ambos.")}</p>
      </header>

      <nav class="home-path" aria-label="Knowledge system progression">
        <a href={localePath(locale, "/journal")}><b>01</b><span>{t("Read ideas", "Leer ideas")}</span></a>
        <i>→</i>
        <a href={localePath(locale, "/incident-library")}><b>02</b><span>{t("Study incidents", "Estudiar incidentes")}</span></a>
        <i>→</i>
        <a href={localePath(locale, "/world")}><b>03</b><span>{t("Explore the world behind them", "Explorar el mundo detrás de ellos")}</span></a>
      </nav>

      <div class="home-knowledge__grid">
        <article class="knowledge-panel knowledge-panel--journal">
          <header class="knowledge-panel__header">
            <p><span>01</span> THE JOURNAL</p>
            <h3>{t("Ideas, reasoning, and patterns from the work.", "Ideas, razonamiento y patrones del trabajo.")}</h3>
          </header>
          {latestEntry?.entry.data.image ? (
            <div class="journal-preview journal-preview--image" aria-hidden="true">
              <img
                class="journal-preview__image"
                src={latestEntry.entry.data.image}
                alt=""
                loading="lazy"
                decoding="async"
              />
            </div>
          ) : (
            <div class="journal-preview" aria-hidden="true">
              <span class="journal-preview__index">FIELD NOTE / {String(journalRecords.length).padStart(2, "0")}</span>
              <div class="journal-preview__lines"><i></i><i></i><i></i><i></i></div>
              <div class="journal-preview__signal"><span></span><span></span><span></span></div>
            </div>
          )}
          {latestEntry ? (
            <div class="knowledge-panel__content">
              <p class="home-meta">{t("LATEST ENTRY", "ÚLTIMA ENTRADA")} · {latestEntry.publishedLabel.toUpperCase()}{latestEntry.readTime ? ` · ${latestEntry.readTime} ${t("MIN READ", "MIN DE LECTURA")}` : ""}</p>
              <h4>{latestEntry.title}</h4>
              <p>{latestEntry.excerpt}</p>
              <div class="home-tags">{latestEntry.topicLabels.map((topic) => <span>{topic}</span>)}</div>
              <a class="home-text-link" href={latestEntry.href}>{t("READ ENTRY →", "LEER ENTRADA →")}</a>
            </div>
          ) : <p class="home-empty">{t("The first Journal entry is being prepared.", "La primera entrada de La Bitácora está en preparación.")}</p>}
        </article>

        <article class="knowledge-panel knowledge-panel--incident">
          <header class="knowledge-panel__header">
            <p><span>02</span> THE INCIDENT LIBRARY</p>
            <h3>{t("Investigations built from evidence, dependencies, and lessons.", "Investigaciones construidas con evidencia, dependencias y aprendizajes.")}</h3>
          </header>
          <div class="incident-preview">
            <TopologyScene
              class="incident-preview__scene"
              nodes={incidentPreviewTopology?.nodes ?? []}
              edges={incidentPreviewTopology?.relationships ?? []}
              layout="viewport-fit"
              viewportFit={true}
              topologyLayout={incidentPreviewTopology?.topologyLayout ?? "fan"}
              radius={18}
              originQ={-4}
              originR={-6}
              showGridNodes={false}
              gridActivity={false}
              ambientSignals={false}
              connectorRouting={incidentPreviewTopology?.connectorRouting ?? "obstacle-aware"}
              signalTransitionSpeed={0.95}
            />
          </div>
          {latestIncident ? (
            <div class="knowledge-panel__content">
              <p class="home-meta">{t("FEATURED INCIDENT", "INCIDENTE DESTACADO")} · {formatIncidentDate(latestIncident.created).toUpperCase()} · {latestOrganization?.acronym}</p>
              <h4>{latestIncident.title}</h4>
              <p>{latestIncident.summary}</p>
              <div class="home-tags">
                <span>{latestIncident.status}</span><span>{severityCode}</span><span>{latestIncident.duration.toUpperCase()}</span>
              </div>
              <a class="home-text-link" href={localePath(locale, `/incident-library/${latestIncident.id}`)}>{t("OPEN INCIDENT →", "VER INCIDENTE →")}</a>
            </div>
          ) : <p class="home-empty">{t("The first incident record is being prepared.", "El primer registro de incidente está en preparación.")}</p>}
        </article>
      </div>
    </section>

    <section class="home-section home-featured" aria-labelledby="featured-title">
      <header class="home-section__header">
        <p class="home-eyebrow">{t("FEATURED EVIDENCE", "EVIDENCIA DESTACADA")}</p>
        <h2 id="featured-title">{t("Three ways into the work.", "Tres formas de entrar al trabajo.")}</h2>
      </header>
      <div class="home-featured__grid">
        <article class="evidence-card">
          <p class="evidence-card__label">{t("LATEST JOURNAL", "LA BITÁCORA MÁS RECIENTE")}</p>
          <h3>{latestEntry?.title ?? t("Journal entry forthcoming", "Próxima entrada de La Bitácora")}</h3>
          <p class="home-meta">{latestEntry?.publishedLabel.toUpperCase()}{latestEntry?.readTime ? ` · ${latestEntry.readTime} ${t("MIN READ", "MIN DE LECTURA")}` : ""}</p>
          <p>{latestEntry?.excerpt ?? t("Field notes on systems, incidents, and the decisions that shape how we operate them.", "Notas de campo sobre sistemas, incidentes y las decisiones que dan forma a su operación.")}</p>
          <a href={latestEntry?.href ?? "/journal"}>{t("READ ENTRY →", "LEER ENTRADA →")}</a>
        </article>

        <article class="evidence-card evidence-card--incident">
          <p class="evidence-card__label">{t("LATEST INCIDENT", "INCIDENTE MÁS RECIENTE")}</p>
          <h3>{latestIncident?.title ?? t("Incident record forthcoming", "Próximo registro de incidente")}</h3>
          <p class="home-meta">{latestIncident ? formatIncidentDate(latestIncident.created).toUpperCase() : ""}{latestOrganization ? ` · ${latestOrganization.acronym}` : ""}</p>
          <p>{latestIncident?.symptom ?? t("Structured investigations preserve the evidence and operational context behind failures.", "Las investigaciones estructuradas preservan la evidencia y el contexto operativo detrás de los fallos.")}</p>
          <a href={latestIncident ? localePath(locale, `/incident-library/${latestIncident.id}`) : localePath(locale, "/incident-library")}>{t("OPEN INCIDENT →", "VER INCIDENTE →")}</a>
        </article>

        <article class="evidence-card evidence-card--world" id="world">
          <div class="world-mark" aria-hidden="true">
            <svg viewBox="0 0 220 100" fill="none">
              <path d="M24 50 62 18l48 24 48-24 38 32-38 32-48-24-48 24z" />
              <circle cx="24" cy="50" r="5" /><circle cx="62" cy="18" r="5" /><circle cx="110" cy="42" r="7" /><circle cx="158" cy="18" r="5" /><circle cx="196" cy="50" r="5" /><circle cx="158" cy="82" r="5" /><circle cx="62" cy="82" r="5" />
            </svg>
          </div>
          <p class="evidence-card__label">{t("EXPLORE THE WORLD", "EXPLORAR EL MUNDO")}</p>
          <h3>{strings.nav.world}</h3>
          <p>{strings.pages.worldDescription}</p>
          <a href={localePath(locale, "/world")}>{t("EXPLORE WORLD →", "EXPLORAR EL MUNDO →")}</a>
        </article>
      </div>
    </section>

    <section class="home-section home-perspective" aria-labelledby="perspective-title">
      <header class="home-section__header home-section__header--split">
        <div>
          <p class="home-eyebrow">{t("OPERATIONAL PERSPECTIVE", "PERSPECTIVA OPERATIVA")}</p>
          <h2 id="perspective-title">{t("Core lenses for reading the system.", "Lentes para leer el sistema.")}</h2>
        </div>
        <p>{t("Not a skills inventory—a set of practical ways to understand what systems are doing and why.", "No es un inventario de habilidades: son formas prácticas de entender qué hacen los sistemas y por qué.")}</p>
      </header>
      <div class="perspective-grid">
        {localizedPerspectives.map((item) => (
          <article class="perspective-card">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" aria-hidden="true"><path d={item.path} /></svg>
            <h3>{item.title}</h3>
            <p>{item.copy}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="home-section home-about" aria-labelledby="about-title">
      <div class="home-about__copy">
        <p class="home-eyebrow">{t("ABOUT THE ENGINEER", "SOBRE EL INGENIERO")}</p>
        <h2 id="about-title">{t("Building, operating, investigating, and writing through complexity.", "Construir, operar, investigar y escribir en medio de la complejidad.")}</h2>
        <p>{t("Genaro Hernández is an infrastructure engineer and systems thinker focused on resilient platforms, useful visibility, dependable operations, and the evidence that helps teams understand failure.", "Genaro Hernández es un ingeniero de infraestructura y pensador de sistemas enfocado en plataformas resilientes, visibilidad útil, operaciones confiables y la evidencia que ayuda a los equipos a entender los fallos.")}</p>
        <p>{t("This knowledge system shares the patterns behind the work so other engineers can examine the reasoning, not only the outcome.", "Este sistema de conocimiento comparte los patrones detrás del trabajo para que otros ingenieros puedan examinar el razonamiento, no solo el resultado.")}</p>
        <div class="home-about__links"><a href={localePath(locale, "/about")}>{t("ABOUT GENARO →", "SOBRE GENARO →")}</a><a href={localePath(locale, "/contact")}>{t("GET IN TOUCH →", "PONERSE EN CONTACTO →")}</a></div>
      </div>
      <dl class="home-metrics" aria-label="Knowledge system proof points">
        <div><dt>{journalRecords.length}</dt><dd>{locale === "es" ? "Entradas publicadas en La Bitácora" : `Published Journal ${journalRecords.length === 1 ? "entry" : "entries"}`}</dd></div>
        <div><dt>{incidents.length}</dt><dd>{locale === "es" ? "Incidentes documentados" : `Documented ${incidents.length === 1 ? "incident" : "incidents"}`}</dd></div>
        <div><dt>{organizations.length}</dt><dd>{t("World dossiers", "Dossiers del Mundo")}</dd></div>
        <div><dt>{t("ACTIVE", "ACTIVO")}</dt><dd>{t("Ongoing practice and learning", "Práctica y aprendizaje continuos")}</dd></div>
      </dl>
    </section>

    <footer class="home-footer" id="contact">
      <div><p class="home-eyebrow">{t("KEEP EXPLORING", "SIGUE EXPLORANDO")}</p><p>{t("Read ideas. Study incidents. Explore the world behind them.", "Lee ideas. Estudia incidentes. Explora el mundo detrás de ellos.")}</p></div>
      <nav aria-label="Homepage footer navigation"><a href={localePath(locale, "/journal")}>{strings.nav.journal}</a><a href={localePath(locale, "/incident-library")}>{strings.nav.incidents}</a><a href={localePath(locale, "/world")}>{strings.nav.world}</a><a href={localePath(locale, "/contact")}>{strings.nav.contact}</a></nav>
    </footer>
  </main>
</BaseLayout>

<style>
  .home-v2 { width: min(100%, 96rem); margin: 0 auto; padding: clamp(1.25rem, 3.5vw, 3.25rem); }
  .home-v2 :where(h1, h2, h3, h4, p) { margin: 0; }
  .home-eyebrow, .home-meta { font-family: var(--font-mono); letter-spacing: 0.14em; text-transform: uppercase; }
  .home-eyebrow { color: var(--accent); font-size: 0.68rem; font-weight: 800; }
  .home-meta { color: var(--muted-dim); font-size: 0.6rem; }
  .home-hero { display: grid; grid-template-columns: minmax(0, 1.03fr) minmax(28rem, 0.97fr); gap: clamp(2rem, 5vw, 5.5rem); align-items: center; min-height: min(52rem, calc(100svh - 2rem)); padding-block: clamp(2rem, 6vw, 5rem); border-bottom: 1px solid var(--line); }
  .home-hero__copy { position: relative; z-index: 2; display: grid; gap: 1.35rem; }
  .home-hero h1 { max-width: 10ch; font-size: clamp(4rem, 8vw, 7.8rem); line-height: 0.86; letter-spacing: -0.075em; }
  .home-domains { display: flex; flex-wrap: wrap; align-items: center; gap: 0.55rem; color: var(--muted); font-family: var(--font-mono); font-size: 0.66rem; letter-spacing: 0.11em; text-transform: uppercase; }
  .home-domains i { width: 3px; height: 3px; border-radius: 50%; background: var(--accent); }
  .home-hero__statement { max-width: 46rem; color: var(--text); font-size: clamp(1.2rem, 2.1vw, 1.65rem); line-height: 1.5; }
  .home-hero__actions { display: flex; flex-wrap: wrap; gap: 0.65rem; padding-top: 0.45rem; }
  .home-button { display: inline-flex; align-items: center; justify-content: space-between; gap: 1rem; min-height: 3rem; padding: 0.72rem 0.9rem; border: 1px solid var(--line-strong); color: var(--text); background: color-mix(in srgb, var(--surface) 78%, transparent); font-family: var(--font-mono); font-size: 0.64rem; font-weight: 800; letter-spacing: 0.08em; text-decoration: none; text-transform: uppercase; transition: border-color 180ms ease, background 180ms ease, transform 180ms ease; }
  .home-button span { color: var(--accent); }
  .home-button:hover, .home-button:focus-visible { transform: translateY(-2px); border-color: color-mix(in srgb, var(--accent) 55%, var(--line)); background: var(--accent-soft); }
  .home-button--primary { border-color: color-mix(in srgb, var(--accent) 58%, var(--line)); background: color-mix(in srgb, var(--accent) 13%, var(--surface)); }
  .home-hero__topology { position: relative; min-width: 0; height: clamp(30rem, 48vw, 43rem); min-height: clamp(30rem, 48vw, 43rem); margin: 0; overflow: hidden; border-block: 1px solid var(--line); background: radial-gradient(circle at 50% 48%, color-mix(in srgb, var(--signal-blue) 7%, transparent), transparent 38%); }
  .home-hero__topology::before { content: "OTF / KNOWLEDGE WORLD"; position: absolute; inset: 0.8rem auto auto 0.8rem; z-index: 2; color: var(--muted-dim); font: 0.56rem/1 var(--font-mono); letter-spacing: 0.14em; }
  .home-hero__scene { width: 100%; min-height: clamp(30rem, 48vw, 43rem); }
  .home-hero__topology figcaption { position: absolute; inset: auto 0.8rem 0.8rem; z-index: 2; display: flex; justify-content: flex-end; gap: 0.8rem; color: var(--muted-dim); font: 0.55rem/1 var(--font-mono); letter-spacing: 0.1em; pointer-events: none; }
  .home-hero__topology :global(.topology-grid) { color: color-mix(in srgb, var(--accent) 8%, transparent); }
  .home-hero__topology :global(.grid-connector) { color: color-mix(in srgb, var(--signal-blue) 48%, var(--text)); stroke-width: 1.25; stroke-opacity: 0.46; opacity: 0.72; }
  .home-hero__topology :global(.grid-occupant-fill) { fill: color-mix(in srgb, var(--surface) 92%, transparent); }
  .home-hero__topology :global(.grid-occupant[data-node-operational-state="degraded"] .grid-occupant-fill) { stroke: var(--accent); fill: color-mix(in srgb, var(--accent) 7%, var(--surface)); }

  .home-section { padding-block: clamp(4rem, 8vw, 7.5rem); border-bottom: 1px solid var(--line); }
  .home-section__header { display: grid; gap: 0.65rem; margin-bottom: clamp(1.8rem, 4vw, 3rem); }
  .home-section__header h2, .home-about h2 { max-width: 18ch; font-size: clamp(2.35rem, 4.7vw, 4.6rem); line-height: 0.96; letter-spacing: -0.055em; }
  .home-section__header--split { grid-template-columns: minmax(0, 1.2fr) minmax(18rem, 0.8fr); align-items: end; gap: 2rem; }
  .home-section__header--split > p { max-width: 38rem; color: var(--muted); line-height: 1.7; }
  .home-path { display: grid; grid-template-columns: 1fr auto 1fr auto 1.3fr; align-items: center; margin-bottom: 1rem; border-block: 1px solid var(--line); }
  .home-path a { display: flex; gap: 0.8rem; align-items: center; min-height: 4rem; padding: 0.75rem; color: var(--text); text-decoration: none; }
