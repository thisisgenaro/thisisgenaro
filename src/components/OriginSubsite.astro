---
import TopologyScene from "operational-topology/astro/TopologyScene";
import SceneOnlyLayout from "../layouts/SceneOnlyLayout.astro";
import type { Locale } from "../lib/i18n";

interface Props {
  locale: Locale;
  canonicalUrl?: string;
}

const { locale, canonicalUrl } = Astro.props as Props;
const copy = locale === "es"
  ? {
      title: "Origen",
      description: "Una escena Viewport-Fit con la identidad GH anclada en la celda axial 0,0.",
      sceneLabel: "Logotipo de Genaro Hernández centrado en la celda axial cero, cero",
      status: "EN CONSTRUCCIÓN",
    }
  : {
      title: "Origin",
      description: "A Viewport-Fit scene with the GH identity anchored at axial cell 0,0.",
      sceneLabel: "Genaro Hernández logo centered on axial cell zero, zero",
      status: "UNDER CONSTRUCTION",
    };

const originNode = [{
  id: "gh-origin",
  label: "",
  image: "/gh-logo.png",
  imageScale: 1.15,
  imageOffsetY: 0.08,
  imageAlign: "center" as const,
  q: 0,
  r: 0,
  variant: "root" as const,
  size: "root" as const,
  status: "healthy",
  active: false,
  selected: false,
}];
const languageNodes = [
  { id: "origin-language-en", label: "EN", q: -2, r: 0, variant: "anchor" as const, size: "sm" as const, status: "healthy", active: false, selected: false },
  { id: "origin-language-es", label: "ES", q: 2, r: 0, variant: "anchor" as const, size: "sm" as const, status: "healthy", active: false, selected: false },
];
const originEdges = [
  { from: "gh-origin", to: "origin-language-en", label: "language", active: false },
  { from: "gh-origin", to: "origin-language-es", label: "language", active: false },
];
---

<SceneOnlyLayout
  locale={locale}
  canonicalPath="/origin"
  canonicalUrl={canonicalUrl}
  title={`${copy.title} | thisisgenaro.com`}
  description={copy.description}
>
  <main class="origin-subsite is-settled" aria-label={copy.sceneLabel} data-origin-bloom data-origin-experience data-origin-root={(canonicalUrl === "https://thisisgenaro.com/").toString()}>
    <TopologyScene
      class="origin-subsite__scene"
      nodes={originNode}
      edges={originEdges}
      layout="viewport-fit"
      viewportFit={true}
      topologyLayout="custom"
      originQ={0}
      originR={0}
      radius={42}
      showGridNodes={false}
      gridActivity={false}
      ambientSignals={false}
      connectorRouting="straight"
    />
  </main>
</SceneOnlyLayout>
<script>
  import type { HexCell } from "operational-topology";
  import { getCenterBloomFrame, toGridCellStateMap } from "operational-topology/animations";

  const bloomHosts = document.querySelectorAll("[data-origin-bloom]");

  for (const host of bloomHosts) {
    if (!(host instanceof HTMLElement) || host.dataset.bloomReady === "true") continue;

    const gridHost = host.querySelector(".scene-grid");
    if (!(gridHost instanceof HTMLElement)) continue;

    host.dataset.bloomReady = "true";
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    let intervalId = 0;
    let bloomFrame = 0;

    const readCells = (): HexCell[] => Array.from(gridHost.querySelectorAll<SVGPathElement>(".grid-hex"))
      .map((element) => ({
        id: element.dataset.cellId ?? "",
        q: Number(element.dataset.q),
        r: Number(element.dataset.r),
        center: {
          x: Number(element.dataset.cx),
          y: Number(element.dataset.cy),
        },
        path: element.getAttribute("d") ?? "",
      }))
      .filter((cell) => cell.id && Number.isFinite(cell.q) && Number.isFinite(cell.r));

    const clearBloom = () => {
      gridHost.querySelectorAll<SVGPathElement>(".grid-hex").forEach((element) => {
        element.dataset.cellState = "idle";
        element.classList.remove("is-active", "is-trail", "is-converted");
        element.style.setProperty("--cell-intensity", "0.24");
      });
    };

    const renderBloom = () => {
      if (!host.classList.contains("is-settled")) return;
      const cells = readCells();
      if (!cells.length) return;

      const maxRadius = Math.max(...cells.map(({ q, r }) => (
        Math.abs(q) + Math.abs(r) + Math.abs(q + r)
      ) / 2));
      const states = toGridCellStateMap(getCenterBloomFrame({
        cells,
        origin: { q: 0, r: 0 },
        frame: bloomFrame,
        maxRadius,
        trail: 5.5,
        wrap: true,
      }));

      gridHost.querySelectorAll<SVGPathElement>(".grid-hex").forEach((element) => {
        const state = states[element.dataset.cellId ?? ""];
        if (!state) return;

        element.dataset.cellState = state.state;
        element.classList.toggle("is-active", state.state === "active");
        element.classList.toggle("is-trail", state.state === "trail");
        element.classList.toggle("is-converted", state.state === "converted");
        element.style.setProperty("--cell-intensity", String(Math.max(0.72, state.intensity)));
      });
    };

    const gridObserver = new MutationObserver(() => renderBloom());
    gridObserver.observe(gridHost, { childList: true, subtree: true });

    const stop = () => {
      if (!intervalId) return;
      window.clearInterval(intervalId);
      intervalId = 0;
    };

    const start = () => {
      stop();
      if (reducedMotion.matches || document.hidden) {
        clearBloom();
        return;
      }

      renderBloom();
      intervalId = window.setInterval(() => {
        bloomFrame += 0.36;
        renderBloom();
      }, 100);
    };

    const handleVisibilityChange = () => start();
    reducedMotion.addEventListener("change", start);
    document.addEventListener("visibilitychange", handleVisibilityChange);
    start();

    window.addEventListener("pagehide", () => {
      stop();
      gridObserver.disconnect();
      reducedMotion.removeEventListener("change", start);
      document.removeEventListener("visibilitychange", handleVisibilityChange);
    }, { once: true });
  }
</script>
<script>
  import { createTopologyDatasetTransition } from "operational-topology/browser";

  for (const host of document.querySelectorAll("[data-origin-experience]")) {
    if (!(host instanceof HTMLElement)) continue;
    const scene = host.querySelector(".topology-scene");
    if (!(scene instanceof HTMLElement)) continue;
    let expanded = false;
    scene.addEventListener("click", (event) => {
      if (expanded) return;
      const target = event.target instanceof Element ? event.target.closest("[data-node-id=gh-origin]") : null;
      if (!target) return;
      const gridHost = scene.querySelector(".scene-grid");
      const sceneGrid = scene.querySelector(".topology-grid");
      if (!(gridHost instanceof HTMLElement) || !(sceneGrid instanceof SVGSVGElement)) return;
      const cells = Array.from(gridHost.querySelectorAll(".grid-hex")).map((element) => ({
        id: element.getAttribute("data-cell-id") ?? "",
        q: Number(element.getAttribute("data-q")),
        r: Number(element.getAttribute("data-r")),
        center: { x: Number(element.getAttribute("data-cx")), y: Number(element.getAttribute("data-cy")) },
        path: element.getAttribute("d") ?? "",
      })).filter((cell) => cell.id && Number.isFinite(cell.q) && Number.isFinite(cell.r));
      if (!cells.length) return;
      expanded = true;
      const transition = createTopologyDatasetTransition({
        sceneGrid,
        cells,
        radius: Number(sceneGrid.getAttribute("data-radius") ?? 42),
        duration: 1200,
        transitionMode: "hex-iris",
      });
      void transition.transition({
        nodes: [
          { id: "gh-origin", label: "", image: "/gh-logo.png", imageScale: 1.15, imageOffsetY: 0.08, imageAlign: "center", q: 0, r: 0, variant: "root", size: "root", status: "healthy", active: false, selected: false },
          { id: "origin-language-en", label: "EN", q: -2, r: 0, variant: "anchor", size: "sm", status: "healthy", active: false, selected: false },
          { id: "origin-language-es", label: "ES", q: 2, r: 0, variant: "anchor", size: "sm", status: "healthy", active: false, selected: false },
        ],
        relationships: [
          { from: "gh-origin", to: "origin-language-en", label: "language", active: false },
          { from: "gh-origin", to: "origin-language-es", label: "language", active: false },
        ],
      }).then(() => host.classList.add("is-language-ready"));
    });
  }
</script>
<style>
  .origin-subsite {
    position: relative;
    width: 100vw;
    height: 100svh;
    overflow: hidden;
    background:
      radial-gradient(circle at 50% 50%, color-mix(in srgb, var(--accent) 7%, transparent), transparent 26%),
      var(--ink);
  }


  .origin-subsite__scene {
    width: 100%;
    height: 100%;
    min-height: 100svh;
  }

  .origin-subsite__scene :global(.scene-grid) {
    opacity: 1;
  }
  .origin-subsite__scene :global(.grid-hex.is-active),
  .origin-subsite__scene :global(.grid-hex.is-trail),
  .origin-subsite__scene :global(.grid-hex.is-converted) {
    stroke: color-mix(in srgb, var(--accent) 94%, white 6%);
    stroke-width: 2.2;
    opacity: calc((0.44 + var(--cell-intensity, 0.5) * 0.56) * var(--cell-edge-factor, 1));
    filter: drop-shadow(0 0 10px color-mix(in srgb, var(--accent) 68%, transparent));
  }
  .origin-subsite:not(.is-settled) .origin-subsite__scene :global(.grid-hex.is-active),
  .origin-subsite:not(.is-settled) .origin-subsite__scene :global(.grid-hex.is-trail),
  .origin-subsite:not(.is-settled) .origin-subsite__scene :global(.grid-hex.is-converted),
  .origin-subsite__scene :global(.grid-hex-signal.is-active),
  .origin-subsite__scene :global(.grid-hex-signal.is-trail),
  .origin-subsite__scene :global(.grid-hex-signal.is-converted) {
    stroke: color-mix(in srgb, var(--accent) 96%, white 4%);
    fill: color-mix(in srgb, var(--accent) 18%, transparent) !important;
    stroke-width: 3.2;
    opacity: 1 !important;
    filter: drop-shadow(0 0 18px color-mix(in srgb, var(--accent) 92%, transparent)) drop-shadow(0 0 34px color-mix(in srgb, var(--accent) 58%, transparent));
  }

  .origin-subsite__status {
    position: absolute;
    z-index: 2;
    top: calc(50% + clamp(4.75rem, 9svh, 6.25rem));
    left: 50%;
    display: inline-flex;
    align-items: center;
    gap: 0.65rem;
    padding: 0.7rem 0.9rem;
    transform: translateX(-50%);
    border: 1px solid color-mix(in srgb, var(--accent) 38%, var(--line));
    background: color-mix(in srgb, var(--surface-raised) 88%, transparent);
    box-shadow: 0 0 24px color-mix(in srgb, var(--accent) 9%, transparent);
    color: var(--text);
    font-family: var(--font-mono);
    font-size: 0.64rem;
    font-weight: 700;
    letter-spacing: 0.16em;
    line-height: 1;
    text-transform: uppercase;
    white-space: nowrap;
    pointer-events: none;
    backdrop-filter: blur(12px);
  }

  .origin-subsite__status span {
    width: 0.42rem;
    height: 0.42rem;
    background: var(--accent);
    box-shadow: 0 0 10px color-mix(in srgb, var(--accent) 64%, transparent);
    transform: rotate(45deg);
  }

  .origin-subsite__scene :global([data-node-id="gh-origin"] .grid-occupant-fill) {
    fill: color-mix(in srgb, var(--surface-raised) 78%, transparent);
    stroke: color-mix(in srgb, var(--accent) 76%, transparent);
    filter: drop-shadow(0 0 18px color-mix(in srgb, var(--accent) 22%, transparent));
  }

  .origin-subsite__scene :global(.grid-occupants),
  .origin-subsite__scene :global(.grid-connectors) {
    opacity: 0;
    transition: opacity 900ms ease;
  }

  .origin-subsite.is-settled .origin-subsite__scene :global(.grid-occupants),
  .origin-subsite.is-settled .origin-subsite__scene :global(.grid-connectors) {
    opacity: 1;
  }

  .origin-subsite__scene :global(.grid-occupant),
  .origin-subsite__scene :global(.grid-connector) {
    opacity: 0;
    transition: opacity 600ms ease;
  }

  .origin-subsite:not(.is-settled) .origin-subsite__scene :global(.grid-occupant),
  .origin-subsite:not(.is-settled) .origin-subsite__scene :global(.grid-connector) {
    opacity: 0 !important;
    visibility: hidden;
  }

  .origin-subsite.is-settled .origin-subsite__scene :global(.grid-occupant),
  .origin-subsite.is-settled .origin-subsite__scene :global(.grid-connector) {
    opacity: 1;
    visibility: visible;
  }

  .origin-subsite:not(.is-settled) .origin-subsite__scene :global([data-node-id="gh-origin"] .grid-occupant-image) {
    opacity: 0;
  }

  .origin-subsite.is-settled .origin-subsite__scene :global([data-node-id="gh-origin"] .grid-occupant-image) {
    opacity: 1;
    transition: opacity 900ms ease, filter 900ms ease;
  }

  .origin-subsite.is-language-selected .origin-subsite__scene :global([data-node-id^="origin-language-"]) {
    filter: drop-shadow(0 0 14px color-mix(in srgb, var(--accent) 72%, transparent));
  }

  .origin-subsite:not(.is-language-ready) .origin-subsite__scene :global([data-node-id^="origin-language-"]),
  .origin-subsite:not(.is-language-ready) .origin-subsite__scene :global(.grid-connector) {
    opacity: 0 !important;
    visibility: hidden;
  }

  .origin-subsite.is-language-ready .origin-subsite__scene :global([data-node-id^="origin-language-"]),
  .origin-subsite.is-language-ready .origin-subsite__scene :global(.grid-connector) {
    opacity: 1;
    visibility: visible;
    transition: opacity 700ms ease;
  }

  .origin-subsite__scene :global([data-node-id="origin-language-en"]) {
    transition-delay: 0ms;
  }

  .origin-subsite__scene :global([data-node-id="origin-language-es"]) {
    transition-delay: 320ms;
  }

  .origin-subsite__scene :global(.grid-connector:nth-child(2)) {
    transition-delay: 520ms;
  }

  .origin-subsite__scene :global(.grid-connector:nth-child(3)) {
    transition-delay: 760ms;
  }

  .origin-subsite.is-exiting .origin-subsite__scene :global(.grid-occupants),
  .origin-subsite.is-exiting .origin-subsite__scene :global(.grid-connectors) {
    opacity: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .origin-subsite__scene :global(*) {
      animation: none !important;
      transition-duration: 0.01ms !important;
    }
  }
</style>
