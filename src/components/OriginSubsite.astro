---
import TopologyScene from "operational-topology/astro/TopologyScene";
import SceneOnlyLayout from "../layouts/SceneOnlyLayout.astro";
import type { Locale } from "../lib/i18n";

interface Props {
  locale: Locale;
  canonicalUrl?: string;
}

const { locale, canonicalUrl } = Astro.props as Props;
const copy = locale === "es"
  ? {
      title: "Origen",
      description: "Una escena Viewport-Fit con la identidad GH anclada en la celda axial 0,0.",
      sceneLabel: "Logotipo de Genaro Hernández centrado en la celda axial cero, cero",
      status: "EN CONSTRUCCIÓN",
    }
  : {
      title: "Origin",
      description: "A Viewport-Fit scene with the GH identity anchored at axial cell 0,0.",
      sceneLabel: "Genaro Hernández logo centered on axial cell zero, zero",
      status: "UNDER CONSTRUCTION",
    };

const originNode = [{
  id: "gh-origin",
  label: "",
  image: "/gh-logo.png",
  imageScale: 1.25,
  imageOffsetY: 0.08,
  imageAlign: "center" as const,
  q: 0,
  r: 0,
  variant: "root" as const,
  size: "root" as const,
  status: "healthy",
  active: false,
  selected: false,
}];
const languageNodes = [
  { id: "origin-language-en", label: "EN", q: -2, r: 0, variant: "anchor" as const, size: "sm" as const, status: "healthy", active: false, selected: false },
  { id: "origin-language-es", label: "ES", q: 2, r: 0, variant: "anchor" as const, size: "sm" as const, status: "healthy", active: false, selected: false },
];
const RADIAL_SIGNAL = { innerRadius: 4, outerRadius: 8, endpointCount: 12, seed: "origin-language" } as const;
const originEdges = [
  { from: "gh-origin", to: "origin-language-en", label: "language", active: false },
  { from: "gh-origin", to: "origin-language-es", label: "language", active: false },
];
---

<SceneOnlyLayout
  locale={locale}
  canonicalPath="/origin"
  canonicalUrl={canonicalUrl}
  title={`${copy.title} | thisisgenaro.com`}
  description={copy.description}
>
  <main class="origin-subsite is-settled" aria-label={copy.sceneLabel} data-origin-bloom data-origin-experience data-origin-root={(canonicalUrl === "https://thisisgenaro.com/").toString()} data-radial-inner-radius={RADIAL_SIGNAL.innerRadius} data-radial-outer-radius={RADIAL_SIGNAL.outerRadius} data-radial-endpoint-count={RADIAL_SIGNAL.endpointCount} data-radial-seed={RADIAL_SIGNAL.seed} data-language-en-q={languageNodes[0].q} data-language-en-r={languageNodes[0].r} data-language-es-q={languageNodes[1].q} data-language-es-r={languageNodes[1].r}>
    <TopologyScene
      class="origin-subsite__scene"
      nodes={originNode}
      edges={originEdges}
      layout="viewport-fit"
      viewportFit={true}
      topologyLayout="ring"
      originQ={0}
      originR={0}
      radius={42}
      showGridNodes={false}
      gridActivity={false}
      ambientSignals={false}
      connectorRouting="obstacle-aware"
    />
  </main>
</SceneOnlyLayout>
<script>
  import type { HexCell } from "operational-topology";
  import { getCenterBloomFrame, toGridCellStateMap } from "operational-topology/animations";

  const bloomHosts = document.querySelectorAll("[data-origin-bloom]");

  for (const host of bloomHosts) {
    if (!(host instanceof HTMLElement) || host.dataset.bloomReady === "true") continue;

    const gridHost = host.querySelector(".scene-grid");
    if (!(gridHost instanceof HTMLElement)) continue;

    host.dataset.bloomReady = "true";
    const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
    let intervalId = 0;
    let bloomFrame = 0;

    const readCells = (): HexCell[] => Array.from(gridHost.querySelectorAll<SVGPathElement>(".grid-hex"))
      .map((element) => ({
        id: element.dataset.cellId ?? "",
        q: Number(element.dataset.q),
        r: Number(element.dataset.r),
        center: {
          x: Number(element.dataset.cx),
          y: Number(element.dataset.cy),
        },
        path: element.getAttribute("d") ?? "",
      }))
      .filter((cell) => cell.id && Number.isFinite(cell.q) && Number.isFinite(cell.r));

    const clearBloom = () => {
      gridHost.querySelectorAll<SVGPathElement>(".grid-hex").forEach((element) => {
        element.dataset.cellState = "idle";
        element.classList.remove("is-active", "is-trail", "is-converted");
        element.style.setProperty("--cell-intensity", "0.24");
      });
    };

    const renderBloom = () => {
      if (!host.classList.contains("is-settled") || host.classList.contains("is-radial-signal")) return;
      const cells = readCells();
      if (!cells.length) return;

      const maxRadius = Math.max(...cells.map(({ q, r }) => (
        Math.abs(q) + Math.abs(r) + Math.abs(q + r)
      ) / 2));
      const states = toGridCellStateMap(getCenterBloomFrame({
        cells,
        origin: { q: 0, r: 0 },
        frame: bloomFrame,
        maxRadius,
        trail: 5.5,
        wrap: true,
      }));

      gridHost.querySelectorAll<SVGPathElement>(".grid-hex").forEach((element) => {
        const state = states[element.dataset.cellId ?? ""];
        if (!state) return;

        element.dataset.cellState = state.state;
        element.classList.toggle("is-active", state.state === "active");
        element.classList.toggle("is-trail", state.state === "trail");
        element.classList.toggle("is-converted", state.state === "converted");
        element.style.setProperty("--cell-intensity", String(Math.max(0.72, state.intensity)));
      });
    };

    const gridObserver = new MutationObserver(() => renderBloom());
    gridObserver.observe(gridHost, { childList: true, subtree: true });

    const stop = () => {
      if (!intervalId) return;
      window.clearInterval(intervalId);
      intervalId = 0;
    };

    const start = () => {
      stop();
      if (reducedMotion.matches || document.hidden) {
        clearBloom();
        return;
      }

      renderBloom();
      intervalId = window.setInterval(() => {
        bloomFrame += 0.36;
        renderBloom();
      }, 100);
    };

    const handleVisibilityChange = () => start();
    reducedMotion.addEventListener("change", start);
    document.addEventListener("visibilitychange", handleVisibilityChange);
    start();

    window.addEventListener("pagehide", () => {
      stop();
      gridObserver.disconnect();
      reducedMotion.removeEventListener("change", start);
      document.removeEventListener("visibilitychange", handleVisibilityChange);
    }, { once: true });
  }
</script>
<script>
  import { createTopologyDatasetTransition } from "operational-topology/browser";
  import { getRadialSignalEndpoints, getRadialSignalFrame, toGridCellStateMap } from "operational-topology/animations";
  import { pageHandoff } from "../lib/pageHandoff";

  const rootHost = document.querySelector("[data-origin-root=\"true\"]");
  if (rootHost) {
    try {
      const storedLocale = window.localStorage.getItem("thisisgenaro.locale");
      const savedRoute = storedLocale === "en" ? "/en/" : storedLocale === "es" ? "/es/" : "";
      if (savedRoute) window.location.replace(savedRoute);
    } catch {}
  }

  for (const host of document.querySelectorAll("[data-origin-experience]")) {
    if (!(host instanceof HTMLElement)) continue;
    const scene = host.querySelector(".topology-scene");
    if (!(scene instanceof HTMLElement)) continue;
    let expanded = false;
    let originPhase = "root";
    const setOriginPhase = (phase) => { originPhase = phase; host.dataset.originPhase = phase; };
    scene.addEventListener("click", (event) => {
      if (expanded) return;
      const target = event.target instanceof Element ? event.target.closest("[data-node-id=gh-origin]") : null;
      if (!target) return;
      const gridHost = scene.querySelector(".scene-grid");
      const sceneGrid = scene.querySelector(".topology-grid");
      if (!(gridHost instanceof HTMLElement) || !(sceneGrid instanceof SVGSVGElement)) return;
      const cells = Array.from(gridHost.querySelectorAll(".grid-hex")).map((element) => ({
        id: element.getAttribute("data-cell-id") ?? "",
        q: Number(element.getAttribute("data-q")),
        r: Number(element.getAttribute("data-r")),
        center: { x: Number(element.getAttribute("data-cx")), y: Number(element.getAttribute("data-cy")) },
        path: element.getAttribute("d") ?? "",
      })).filter((cell) => cell.id && Number.isFinite(cell.q) && Number.isFinite(cell.r));
      if (!cells.length) return;
      expanded = true;
      setOriginPhase("language-transition");
      const transition = createTopologyDatasetTransition({
        sceneGrid,
        cells,
        radius: Number(sceneGrid.getAttribute("data-radius") ?? 42),
        duration: 1200,
        transitionMode: "cascade",
      });
      void transition.transition({
        nodes: [
          { id: "gh-origin", label: "", image: "/gh-logo.png", imageScale: 1.25, imageOffsetY: 0.08, imageAlign: "center", q: 0, r: 0, variant: "root", size: "root", status: "healthy", active: false, selected: false },
          { id: "origin-language-en", label: "EN", q: Number(host.dataset.languageEnQ ?? 4), r: Number(host.dataset.languageEnR ?? -4), variant: "anchor", size: "sm", status: "healthy", active: false, selected: false },
          { id: "origin-language-es", label: "ES", q: Number(host.dataset.languageEsQ ?? 0), r: Number(host.dataset.languageEsR ?? 4), variant: "anchor", size: "sm", status: "healthy", active: false, selected: false },
        ],
        relationships: [
          { from: "gh-origin", to: "origin-language-en", label: "language", active: false },
          { from: "gh-origin", to: "origin-language-es", label: "language", active: false },
        ],
      }).then(() => { setOriginPhase("language-ready"); host.classList.add("is-language-ready"); });
    });
    const playRadialSignal = (route) => {
      const gridHost = scene.querySelector(".scene-grid");
      if (!(gridHost instanceof HTMLElement)) return;
      const sceneGrid = scene.querySelector(".topology-grid");
      if (!(sceneGrid instanceof SVGSVGElement)) return;
      const cells = Array.from(gridHost.querySelectorAll(".grid-hex")).map((element) => ({
        id: element.getAttribute("data-cell-id") ?? "",
        q: Number(element.getAttribute("data-q")),
        r: Number(element.getAttribute("data-r")),
        center: { x: Number(element.getAttribute("data-cx")), y: Number(element.getAttribute("data-cy")) },
        path: element.getAttribute("d") ?? "",
      })).filter((cell) => cell.id && Number.isFinite(cell.q) && Number.isFinite(cell.r));
      if (!cells.length) { void pageHandoff({ destination: route, animation: "originArrival", context: { origin: true } }); return; }
      host.classList.add("is-radial-signal");
      setOriginPhase("radial-signal");
      const radialGroup = document.createElementNS("http://www.w3.org/2000/svg", "g");
      radialGroup.setAttribute("class", "radial-signal-connectors");
      const endpoints = getRadialSignalEndpoints(cells, { q: 0, r: 0 }, Number(host.dataset.radialInnerRadius ?? 4), Number(host.dataset.radialOuterRadius ?? 8), Number(host.dataset.radialEndpointCount ?? 12));
      const connectorLines = [];
      const originCell = cells.find((cell) => cell.q === 0 && cell.r === 0);
      if (originCell) {
        for (const endpoint of endpoints) {
          const line = document.createElementNS("http://www.w3.org/2000/svg", "line");
          line.setAttribute("class", "radial-signal-connector");
          line.setAttribute("x1", String(originCell.center.x));
          line.setAttribute("y1", String(originCell.center.y));
          line.setAttribute("x2", String(endpoint.cell.center.x));
          line.setAttribute("y2", String(endpoint.cell.center.y));
          const lineLength = Math.hypot(endpoint.cell.center.x - originCell.center.x, endpoint.cell.center.y - originCell.center.y);
          line.style.strokeDasharray = `${lineLength} ${lineLength}`;
          line.style.strokeDashoffset = String(lineLength);
          line.dataset.endpointIndex = String(endpoint.index);
          connectorLines.push({ line, length: lineLength });
          radialGroup.appendChild(line);
        }
        const occupantsLayer = Array.from(sceneGrid.children).find((child) => child instanceof SVGGElement && child.classList.contains("grid-occupants"));
        sceneGrid.insertBefore(radialGroup, occupantsLayer ?? sceneGrid.firstChild);
      }
      const duration = 5260;
      const signalSpeed = 2;
      const playbackDuration = 2500;
      let navigated = false;
      const finish = () => {
        if (navigated) return;
        navigated = true;
        setOriginPhase("navigating");
        void pageHandoff({ destination: route, animation: "originArrival", context: { origin: true } });
      };
      if (window.matchMedia("(prefers-reduced-motion: reduce)").matches) { finish(); return; }
      window.setTimeout(finish, playbackDuration + 250);
      const startedAt = performance.now();
      const render = (now) => {
        const frame = Math.min(duration, (now - startedAt) * signalSpeed);
        const states = toGridCellStateMap(getRadialSignalFrame({ cells, origin: { q: 0, r: 0 }, frame, innerRadius: Number(host.dataset.radialInnerRadius ?? 4), outerRadius: Number(host.dataset.radialOuterRadius ?? 8), seed: host.dataset.radialSeed ?? "origin-language", sequence: "random", synchronizedPulse: true, returnToCenter: true, settle: true }));
        for (const { line, length } of connectorLines) {
          const constructionProgress = frame >= 380 ? Math.min(1, (frame - 380) / 680) : 0;
          const sequenceProgress = frame >= 1060 ? 1 : 0;
          const progress = frame < 1060 ? constructionProgress : sequenceProgress;
          line.style.strokeDashoffset = String(length * (1 - progress));
          if (frame >= 3780) {
            line.classList.add("is-confirmation");
            line.style.removeProperty("stroke-dasharray");
            line.style.removeProperty("stroke-dashoffset");
          } else {
            line.classList.remove("is-confirmation");
            line.style.strokeDasharray = `${length} ${length}`;
            line.style.strokeDashoffset = String(length * (1 - progress));
          }
        }
        gridHost.querySelectorAll(".grid-hex").forEach((element) => {
          const state = states[element.getAttribute("data-cell-id") ?? ""];
          element.style.removeProperty("stroke");
          element.style.removeProperty("stroke-width");
          element.style.removeProperty("fill");
          element.style.removeProperty("opacity");
          element.style.removeProperty("filter");
          if (!state) return;
          element.dataset.cellState = state.state;
          element.classList.toggle("is-active", state.state === "active");
          element.classList.toggle("is-trail", state.state === "trail");
          element.classList.toggle("is-converted", state.state === "converted");
          element.style.setProperty("--cell-intensity", String(state.intensity));
          if (state.state === "active") {
            element.style.setProperty("stroke", "var(--accent)", "important");
            element.style.setProperty("stroke-width", "3.2", "important");
            element.style.setProperty("fill", "color-mix(in srgb, var(--accent) 34%, transparent)", "important");
            element.style.setProperty("opacity", "1", "important");
            element.style.setProperty("filter", "drop-shadow(0 0 18px var(--accent))", "important");
          } else if (state.state === "trail") {
            element.style.setProperty("stroke", "var(--accent)", "important");
            element.style.setProperty("stroke-width", "2.4", "important");
            element.style.setProperty("fill", "color-mix(in srgb, var(--accent) 16%, transparent)", "important");
            element.style.setProperty("opacity", "0.82", "important");
          }
        });
        if (now - startedAt < playbackDuration) window.requestAnimationFrame(render);
        else finish();
      };
      window.requestAnimationFrame(render);
    };
    const navigateLanguage = (event) => {
      if (!host.classList.contains("is-language-ready")) return;
      const target = event.target instanceof Element ? event.target.closest("[data-node-id]") : null;
      const nodeId = target?.getAttribute("data-node-id") ?? "";
      const route = nodeId === "origin-language-en" ? "/en/" : nodeId === "origin-language-es" ? "/es/" : "";
      if (!route) return;
      event.preventDefault();
      event.stopImmediatePropagation();
      window.localStorage.setItem("thisisgenaro.locale", nodeId.endsWith("-es") ? "es" : "en");
      playRadialSignal(route);
    };
    scene.addEventListener("click", navigateLanguage, true);
    scene.addEventListener("keydown", (event) => {
      if (event.key === "Enter" || event.key === " ") navigateLanguage(event);
    }, true);
  }
</script>
<style>
  .origin-subsite {
    position: relative;
    width: 100vw;
    height: 100svh;
    overflow: hidden;
    background:
      radial-gradient(circle at 50% 50%, color-mix(in srgb, var(--accent) 7%, transparent), transparent 26%),
      var(--ink);
  }


  .origin-subsite__scene {
    width: 100%;
    height: 100%;
    min-height: 100svh;
  }

  .origin-subsite__scene :global(.scene-grid) {
    opacity: 1;
  }
  .origin-subsite__scene :global(.radial-signal-connectors) {
    opacity: 0;
    transition: opacity 180ms ease;
    pointer-events: none;
  }

  .origin-subsite.is-radial-signal .origin-subsite__scene :global(.radial-signal-connectors) {
    opacity: 1;
  }

  .origin-subsite__scene :global(.radial-signal-connector) {
    stroke: var(--accent);
    stroke-width: 2.8;
    stroke-linecap: round;
    opacity: 0.78;
    filter: drop-shadow(0 0 9px var(--accent));
    vector-effect: non-scaling-stroke;
    transition: stroke 180ms ease, opacity 180ms ease, filter 180ms ease;
  }

  .origin-subsite__scene :global(.radial-signal-connector.is-confirmation) {
    stroke-width: 3.6;
    opacity: 1;
    stroke-dasharray: 10 7;
    animation: radial-signal-dash 900ms linear infinite;
  }

   radial-signal-dash {
    to { stroke-dashoffset: -34; }
  }

  .origin-subsite__scene :global(.grid-hex.is-active),
  .origin-subsite__scene :global(.grid-hex.is-trail),
  .origin-subsite__scene :global(.grid-hex.is-converted) {
    stroke: color-mix(in srgb, var(--accent) 94%, white 6%);
    stroke-width: 2.2;
    opacity: calc((0.44 + var(--cell-intensity, 0.5) * 0.56) * var(--cell-edge-factor, 1));
    filter: drop-shadow(0 0 10px color-mix(in srgb, var(--accent) 68%, transparent));
  }
  .origin-subsite:not(.is-settled) .origin-subsite__scene :global(.grid-hex.is-active),
  .origin-subsite:not(.is-settled) .origin-subsite__scene :global(.grid-hex.is-trail),
  .origin-subsite:not(.is-settled) .origin-subsite__scene :global(.grid-hex.is-converted),
  .origin-subsite__scene :global(.grid-hex-signal.is-active),
  .origin-subsite__scene :global(.grid-hex-signal.is-trail),
  .origin-subsite__scene :global(.grid-hex-signal.is-converted) {
    stroke: color-mix(in srgb, var(--accent) 96%, white 4%);
    fill: color-mix(in srgb, var(--accent) 18%, transparent) !important;
    stroke-width: 3.2;
    opacity: 1 !important;
    filter: drop-shadow(0 0 18px color-mix(in srgb, var(--accent) 92%, transparent)) drop-shadow(0 0 34px color-mix(in srgb, var(--accent) 58%, transparent));
  }

  .origin-subsite__scene :global([data-node-id="gh-origin"] .grid-occupant-fill) {
    fill: color-mix(in srgb, var(--surface-raised) 78%, transparent);
    stroke: transparent !important;
    stroke-width: 0;
    filter: drop-shadow(0 0 18px color-mix(in srgb, var(--accent) 22%, transparent));
  }

  .origin-subsite__scene :global(.grid-occupants),
  .origin-subsite__scene :global(.grid-connectors) {
    opacity: 0;
    transition: opacity 900ms ease;
  }

  .origin-subsite.is-settled .origin-subsite__scene :global(.grid-occupants),
  .origin-subsite.is-settled .origin-subsite__scene :global(.grid-connectors) {
    opacity: 1;
  }

  .origin-subsite__scene :global(.grid-occupant),
  .origin-subsite__scene :global(.grid-connector) {
    opacity: 0;
    transition: opacity 600ms ease;
  }

  .origin-subsite:not(.is-settled) .origin-subsite__scene :global(.grid-occupant),
  .origin-subsite:not(.is-settled) .origin-subsite__scene :global(.grid-connector) {
    opacity: 0 !important;
    visibility: hidden;
  }

  .origin-subsite.is-settled .origin-subsite__scene :global(.grid-occupant),
  .origin-subsite.is-settled .origin-subsite__scene :global(.grid-connector) {
    opacity: 1;
    visibility: visible;
  }

  .origin-subsite:not(.is-settled) .origin-subsite__scene :global([data-node-id="gh-origin"] .grid-occupant-image) {
    opacity: 0;
  }

  .origin-subsite.is-settled .origin-subsite__scene :global([data-node-id="gh-origin"] .grid-occupant-image) {
    opacity: 1;
    transition: opacity 900ms ease, filter 900ms ease;
  }

  .origin-subsite.is-language-selected .origin-subsite__scene :global([data-node-id^="origin-language-"]) {
    filter: drop-shadow(0 0 14px color-mix(in srgb, var(--accent) 72%, transparent));
  }

  .origin-subsite:not(.is-language-ready) .origin-subsite__scene :global([data-node-id^="origin-language-"]),
  .origin-subsite:not(.is-language-ready) .origin-subsite__scene :global(.grid-connector) {
    opacity: 0 !important;
    visibility: hidden;
  }

  .origin-subsite.is-language-ready .origin-subsite__scene :global([data-node-id^="origin-language-"]),
  .origin-subsite.is-language-ready .origin-subsite__scene :global(.grid-connector) {
    opacity: 1;
    visibility: visible;
    transition: opacity 700ms ease;
  }

  .origin-subsite__scene :global([data-node-id="origin-language-en"]) {
    transition-delay: 0ms;
  }

  .origin-subsite__scene :global([data-node-id="origin-language-es"]) {
    transition-delay: 320ms;
  }

  .origin-subsite__scene :global(.grid-connector:nth-child(2)) {
    transition-delay: 520ms;
  }

  .origin-subsite__scene :global(.grid-connector:nth-child(3)) {
    transition-delay: 760ms;
  }

  .origin-subsite.is-exiting .origin-subsite__scene :global(.grid-occupants),
  .origin-subsite.is-exiting .origin-subsite__scene :global(.grid-connectors) {
    opacity: 0;
  }

  @media (prefers-reduced-motion: reduce) {
    .origin-subsite__scene :global(*) {
      animation: none !important;
      transition-duration: 0.01ms !important;
    }
  }
</style>
