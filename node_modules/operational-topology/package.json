{
  "name": "operational-topology",
  "type": "module",
  "version": "0.0.9",
  "exports": {
    ".": "./dist/package/framework/index.js",
    "./browser": "./dist/package/framework/browser.js",
    "./astro/TopologyBackground": "./src/components/topology/TopologyBackground.astro",
    "./astro/TopologyGrid": "./src/components/topology/TopologyGrid.astro",
    "./astro/TopologyScene": "./src/components/topology/TopologyScene.astro",
    "./astro/ThemeSwitcher": "./src/components/theme/ThemeSwitcher.astro",
    "./labs": "./dist/package/framework/labs.js",
    "./presets": "./dist/package/framework/presets.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/package",
    "src/components/topology/TopologyBackground.astro",
    "src/components/topology/TopologyGrid.astro",
    "src/components/topology/TopologyScene.astro",
    "src/components/theme/ThemeSwitcher.astro",
    "src/framework",
    "src/topology",
    "src/theme",
    "src/styles/global.css",
    "src/styles/themes.css",
    "src/styles/tokens.css",
    "docs/FRAMEWORK_API.md",
    "docs/PACKAGE_DISTRIBUTION.md",
    "README.md",
    "package.json"
  ],
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "test:camera": "node --test tests/cameraMath.test.mjs",
    "test:animation": "node --test tests/gridAnimations.test.mjs tests/animationClock.test.mjs tests/motion.test.mjs tests/ghLogoAnimation.test.mjs",
    "test:connector": "node --test tests/connectorRouting.test.mjs",
    "test:developer": "node --test tests/developerApi.test.mjs",
    "test:framework": "node --test tests/frameworkExtraction.test.mjs",
    "test:render": "node --test tests/renderPipeline.test.mjs",
    "test:contrast": "node --test tests/themeContrast.test.mjs",
    "test:signal": "node --test tests/signal*.test.mjs",
    "test:theme": "node --test tests/themeTokens.test.mjs",
    "preview": "astro preview",
    "astro": "astro",
    "build:types": "tsc -p tsconfig.package.json",
    "build:package": "tsc -p tsconfig.package.build.json",
    "prepack": "npm run build:package"
  },
  "dependencies": {
    "astro": "^7.0.6"
  },
  "devDependencies": {
    "typescript": "^7.0.2"
  }
}
