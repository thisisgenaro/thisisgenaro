---
import { themeLabels, themeNames } from "../../theme/theme";
---

<div class="theme-switcher" data-theme-switcher-root>
  <button class="theme-switcher__mobile-toggle" type="button" data-theme-switcher-toggle aria-expanded="false" aria-controls="otf-theme-panel" aria-label="Open settings">
    <svg class="theme-switcher__icon" viewBox="0 0 16 16" aria-hidden="true" focusable="false">
      <path d="M8 2.25a5.75 5.75 0 1 0 0 11.5h.75a1.35 1.35 0 0 0 0-2.7h-.42a.82.82 0 0 1 0-1.64h1.92A3.5 3.5 0 0 0 13.75 5.9C13.75 3.88 11.18 2.25 8 2.25Z" />
      <circle cx="5.15" cy="5.8" r="0.65" />
      <circle cx="7.55" cy="4.65" r="0.65" />
      <circle cx="10.25" cy="5.35" r="0.65" />
    </svg>
    <span class="theme-switcher__mobile-label">Settings</span>
  </button>
  <div class="theme-switcher__panel" id="otf-theme-panel" data-theme-switcher-panel>
    <label class="theme-switcher__label" for="otf-theme-selector">Appearance</label>
    <select id="otf-theme-selector" data-theme-switcher aria-label="Visual theme">
      {themeNames.map((theme) => (
        <option value={theme}>{themeLabels[theme]}</option>
      ))}
    </select>
    <div class="theme-switcher__modes" role="group" aria-label="Appearance modes">
      <button type="button" data-appearance-toggle="glow" aria-pressed="false" aria-label="Reduce glow" title="Reduce glow">
        <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
          <circle cx="8" cy="8" r="2.25" />
          <path d="M8 1.75v1.5M8 12.75v1.5M1.75 8h1.5M12.75 8h1.5M3.58 3.58l1.06 1.06M11.36 11.36l1.06 1.06M12.42 3.58l-1.06 1.06M4.64 11.36l-1.06 1.06" />
          <path class="theme-switcher__mode-slash" d="M2.5 13.5l11-11" />
        </svg>
      </button>
      <button type="button" data-appearance-toggle="contrast" aria-pressed="false" aria-label="Use high contrast" title="High contrast">
        <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
          <circle cx="8" cy="8" r="5.25" />
          <path d="M8 2.75v10.5A5.25 5.25 0 0 0 8 2.75Z" class="theme-switcher__contrast-fill" />
        </svg>
      </button>
      <button type="button" data-appearance-toggle="color-safe" aria-pressed="false" aria-label="Use color-safe distinctions" title="Color-safe distinctions">
        <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
          <path d="M1.75 8s2.2-3.75 6.25-3.75S14.25 8 14.25 8 12.05 11.75 8 11.75 1.75 8 1.75 8Z" />
          <circle cx="8" cy="8" r="1.8" />
          <path d="M11.5 3.1l1.4-1.35M3.1 14.25l1.4-1.35" />
        </svg>
      </button>
      <a class="theme-switcher__gallery" href="/theme-gallery" aria-label="Open theme gallery" title="Theme gallery">
        <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
          <rect x="2.5" y="2.5" width="4.25" height="4.25" rx="0.6" />
          <rect x="9.25" y="2.5" width="4.25" height="4.25" rx="0.6" />
          <rect x="2.5" y="9.25" width="4.25" height="4.25" rx="0.6" />
          <rect x="9.25" y="9.25" width="4.25" height="4.25" rx="0.6" />
        </svg>
      </a>
    </div>
  </div>
</div>

<script>
  import {
    getActiveTheme,
    getHighContrast,
    getColorSafe,
    getReducedGlow,
    setActiveTheme,
    setHighContrast,
    setColorSafe,
    setReducedGlow,
    appearanceChangeEvent,
    themeChangeEvent,
    type ThemeChangeDetail,
  } from "../../theme/ThemeController";
  import { isThemeName } from "../../theme/theme";

  const selectors = document.querySelectorAll<HTMLSelectElement>("[data-theme-switcher]");
  const switcher = document.querySelector<HTMLElement>("[data-theme-switcher-root]");
  const mount = document.querySelector<HTMLElement>("[data-theme-switcher-mount]");
  const toggleButton = document.querySelector<HTMLButtonElement>("[data-theme-switcher-toggle]");
  const panel = document.querySelector<HTMLElement>("[data-theme-switcher-panel]");
  const glowButton = document.querySelector<HTMLButtonElement>("[data-appearance-toggle='glow']");
  const contrastButton = document.querySelector<HTMLButtonElement>("[data-appearance-toggle='contrast']");
  const colorSafeButton = document.querySelector<HTMLButtonElement>("[data-appearance-toggle='color-safe']");

  if (switcher && mount) {
    mount.append(switcher);
    switcher.classList.add("is-embedded", "is-mounted");
  }

  const syncSelectors = (theme: string) => {
    for (const selector of selectors) selector.value = theme;
  };

  syncSelectors(getActiveTheme());

  const syncAppearanceModes = () => {
    glowButton?.setAttribute("aria-pressed", String(getReducedGlow()));
    contrastButton?.setAttribute("aria-pressed", String(getHighContrast()));
    colorSafeButton?.setAttribute("aria-pressed", String(getColorSafe()));
  };

  syncAppearanceModes();

  const setPanelOpen = (open: boolean) => {
    if (!panel || !toggleButton) return;
    switcher?.classList.toggle("is-open", open);
    toggleButton.setAttribute("aria-expanded", String(open));
    panel.setAttribute("aria-hidden", String(!open));
  };

  setPanelOpen(false);

  toggleButton?.addEventListener("click", () => {
    setPanelOpen(!switcher?.classList.contains("is-open"));
  });

  document.addEventListener("click", (event) => {
    if (!switcher || !panel || !toggleButton) return;
    const target = event.target instanceof Node ? event.target : null;
    if (!target || switcher.contains(target)) return;
    setPanelOpen(false);
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape") setPanelOpen(false);
  });

  for (const selector of selectors) {
    selector.addEventListener("change", () => {
      if (isThemeName(selector.value)) setActiveTheme(selector.value);
    });
  }

  window.addEventListener(themeChangeEvent, (event) => {
    syncSelectors((event as CustomEvent<ThemeChangeDetail>).detail.theme);
  });

  glowButton?.addEventListener("click", () => setReducedGlow(!getReducedGlow()));
  contrastButton?.addEventListener("click", () => setHighContrast(!getHighContrast()));
  colorSafeButton?.addEventListener("click", () => setColorSafe(!getColorSafe()));
  window.addEventListener(appearanceChangeEvent, syncAppearanceModes);
</script>

<style>
  .theme-switcher {
    position: fixed;
    inset: max(0.75rem, env(safe-area-inset-top)) max(0.75rem, env(safe-area-inset-right)) auto auto;
    z-index: 100;
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    padding: 0.34rem 0.42rem;
    border: 1px solid var(--theme-glass-border-strong);
    border-radius: 0.65rem;
    background: color-mix(in srgb, var(--theme-inspector-background) 88%, transparent);
    box-shadow: 0 10px 28px rgba(0, 0, 0, 0.2);
    backdrop-filter: blur(12px) saturate(125%);
    color: var(--theme-text-muted);
    font-family: var(--font-mono, monospace);
    font-size: 0.58rem;
    font-weight: 700;
    letter-spacing: 0.11em;
    text-transform: uppercase;
  }

  .theme-switcher:not(.is-mounted) {
    visibility: hidden;
    opacity: 0;
    pointer-events: none;
  }

  .theme-switcher.is-embedded {
    position: relative;
    inset: auto;
    z-index: auto;
    border-color: var(--theme-line);
    background: color-mix(in srgb, var(--theme-surface-elevated) 74%, transparent);
    box-shadow: none;
  }

  .theme-switcher__mobile-toggle {
    display: none;
    align-items: center;
    gap: 0.35rem;
    min-height: 2rem;
    padding: 0.28rem 0.55rem 0.28rem 0.42rem;
    border: 1px solid var(--theme-line);
    border-radius: 999px;
    background: var(--theme-surface-elevated);
    color: var(--theme-text-primary);
    cursor: pointer;
    font: inherit;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .theme-switcher__mobile-label {
    font-size: 0.62rem;
    font-weight: 700;
  }

  .theme-switcher__panel {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
  }

  .theme-switcher__icon {
    width: 0.95rem;
    height: 0.95rem;
    fill: none;
    stroke: var(--theme-selection);
    stroke-width: 1.15;
    stroke-linecap: round;
    stroke-linejoin: round;
    flex: 0 0 auto;
  }

  .theme-switcher__label {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
  }

  .theme-switcher select {
    max-width: 10.5rem;
    padding: 0.28rem 1.45rem 0.28rem 0.45rem;
    border: 1px solid var(--theme-line);
    border-radius: 0.42rem;
    background: var(--theme-surface-elevated);
    color: var(--theme-text-primary);
    font: inherit;
    letter-spacing: 0.04em;
    cursor: pointer;
  }

  .theme-switcher select:focus-visible {
    outline: 2px solid var(--theme-focus);
    outline-offset: 2px;
  }

  .theme-switcher__modes {
    display: inline-flex;
    align-items: center;
    gap: 0.2rem;
    padding-inline-start: 0.15rem;
    border-inline-start: 1px solid var(--theme-line);
  }

  .theme-switcher__modes button,
  .theme-switcher__gallery {
    appearance: none;
    display: grid;
    place-items: center;
    width: 1.75rem;
    height: 1.75rem;
    padding: 0;
    border: 1px solid transparent;
    border-radius: 0.42rem;
    background: transparent;
    color: var(--theme-text-muted);
    cursor: pointer;
    text-decoration: none;
  }

  .theme-switcher__modes button:hover,
  .theme-switcher__modes button:focus-visible,
  .theme-switcher__gallery:hover,
  .theme-switcher__gallery:focus-visible {
    border-color: var(--theme-line-strong);
    color: var(--theme-text-primary);
    outline: none;
  }

  .theme-switcher__modes button[aria-pressed="true"] {
    border-color: color-mix(in srgb, var(--theme-selection) 48%, transparent);
    background: color-mix(in srgb, var(--theme-selection) 14%, transparent);
    color: var(--theme-focus);
  }

  .theme-switcher__modes svg,
  .theme-switcher__gallery svg {
    width: 0.95rem;
    height: 0.95rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .theme-switcher__contrast-fill {
    fill: currentColor;
    stroke: none;
    opacity: 0.76;
  }

  @media (max-width: 720px) {
    .theme-switcher {
      inset-block-start: max(0.5rem, env(safe-area-inset-top));
      inset-inline-end: max(0.5rem, env(safe-area-inset-right));
      gap: 0;
      padding: 0;
      border: 0;
      background: transparent;
      box-shadow: none;
      backdrop-filter: none;
      -webkit-backdrop-filter: none;
    }

    .theme-switcher.is-embedded {
      position: fixed;
      inset: max(0.5rem, env(safe-area-inset-top)) max(0.5rem, env(safe-area-inset-right)) auto auto;
      z-index: 120;
    }

    .theme-switcher__mobile-toggle {
      display: inline-flex;
    }

    .theme-switcher__panel {
      position: absolute;
      top: calc(100% + 0.5rem);
      right: 0;
      display: grid;
      gap: 0.45rem;
      min-width: min(15rem, calc(100vw - 1.2rem));
      padding: 0.65rem;
      border: 1px solid var(--theme-glass-border-strong);
      border-radius: 0.85rem;
      background: color-mix(in srgb, var(--theme-inspector-background) 92%, transparent);
      box-shadow: 0 16px 36px rgba(0, 0, 0, 0.28);
      backdrop-filter: blur(12px) saturate(125%);
      opacity: 0;
      pointer-events: none;
      transform: translateY(-0.25rem) scale(0.98);
      transform-origin: top right;
      transition: opacity 160ms ease, transform 160ms ease;
    }

    .theme-switcher.is-open .theme-switcher__panel {
      opacity: 1;
      pointer-events: auto;
      transform: translateY(0) scale(1);
    }

    .theme-switcher select {
      width: 100%;
      max-width: none;
    }

    .theme-switcher__modes {
      justify-content: space-between;
      padding-inline-start: 0;
      border-inline-start: 0;
    }

    .theme-switcher__modes button,
    .theme-switcher__gallery {
      width: 2.05rem;
      height: 2.05rem;
    }

  }
</style>
