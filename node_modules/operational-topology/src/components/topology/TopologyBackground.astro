---
import "../../styles/global.css";
interface Props {
  class?: string;
}

const { class: className = "" } = Astro.props;
---

<section class:list={["topology-background", className]}>
  <div class="cursor-glow" aria-hidden="true"></div>

  <div class="topology-content">
    <slot />
  </div>
</section>

<script>
  const root = document.querySelector(".topology-background");

  root?.addEventListener("pointermove", (event) => {
    if (!(event instanceof PointerEvent)) return;

    root.style.setProperty("--cursor-x", `${event.clientX}px`);
    root.style.setProperty("--cursor-y", `${event.clientY}px`);
  });
</script>

<style>
  .topology-background {
    --cursor-x: 50vw;
    --cursor-y: 50vh;

    position: relative;
    min-height: 100svh;
    overflow: hidden;
    background:
      radial-gradient(circle at 76% 38%, var(--theme-atmosphere-selection), transparent 34%),
      radial-gradient(circle at 22% 24%, var(--theme-atmosphere-activity), transparent 30%),
      linear-gradient(135deg, var(--theme-scene-canvas), var(--theme-scene-surface) 55%, var(--theme-scene-depth));
    color: var(--theme-text-primary);
  }

  .cursor-glow {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    background:
      radial-gradient(
        circle at var(--cursor-x) var(--cursor-y),
        var(--theme-pointer-glow),
        transparent 290px
      );
    opacity: 0.82;
  }

  .topology-background::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: 2;
    pointer-events: none;
    background:
      radial-gradient(circle at center, transparent 0%, var(--theme-vignette) 82%);
  }

  .topology-content {
    position: relative;
    z-index: 3;
    min-height: 100svh;
  }

  @media (prefers-reduced-motion: reduce) {
    .cursor-glow {
      display: none;
    }
  }
</style>
