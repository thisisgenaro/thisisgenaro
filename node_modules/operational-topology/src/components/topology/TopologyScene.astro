---
import TopologyGrid from "./TopologyGrid.astro";
import { TopologyModel } from "../../framework/index.ts";
import { TOPOLOGY_SCENE_BASE, TOPOLOGY_SIGNAL_BASE, type TopologyLayoutMode, type TopologySceneLayout } from "../../topology/sceneConfig";
import type { ConnectorRoutingMode } from "../../topology/connectorRouting.ts";
import type { HexCell } from "../../framework/index.ts";
import type {
  TopologyRenderOccupant,
  TopologyRenderRelationship,
} from "../../topology/renderPipeline";

interface Props {
  nodes: TopologyRenderOccupant[];
  edges?: TopologyRenderRelationship[];
  radius?: number;
  columns?: number;
  rows?: number;
  originQ?: number;
  originR?: number;
  layout?: TopologySceneLayout;
  viewportFit?: boolean;
  showGridNodes?: boolean;
  gridActivity?: boolean;
  ambientSignals?: boolean;
  connectorRouting?: ConnectorRoutingMode;
  signalTransitionSpeed?: number;
  topologyLayout?: TopologyLayoutMode;
  cells?: HexCell[];
  class?: string;
}

const {
  nodes,
  edges = [],
  radius = TOPOLOGY_SCENE_BASE.radius,
  columns = TOPOLOGY_SCENE_BASE.columns,
  rows = TOPOLOGY_SCENE_BASE.rows,
  originQ = TOPOLOGY_SCENE_BASE.originQ,
  originR = TOPOLOGY_SCENE_BASE.originR,
  layout = TOPOLOGY_SCENE_BASE.layout,
  viewportFit = TOPOLOGY_SCENE_BASE.viewportFit,
  showGridNodes = TOPOLOGY_SCENE_BASE.showGridNodes,
  gridActivity = TOPOLOGY_SCENE_BASE.gridActivity,
  ambientSignals = TOPOLOGY_SCENE_BASE.ambientSignals,
  connectorRouting = TOPOLOGY_SCENE_BASE.connectorRouting,
  signalTransitionSpeed = TOPOLOGY_SIGNAL_BASE.transitionSpeed,
  topologyLayout = TOPOLOGY_SCENE_BASE.topologyLayout,
  cells: providedCells = null,
  class: className = "",
} = Astro.props;

const model = new TopologyModel({
  radius,
  columns,
  rows,
  originQ,
  originR,
  entities: nodes,
  relationships: edges,
});

const sceneCells = providedCells ?? model.cells;
const gridActivityCells = [];

const serializedNodes = JSON.stringify(model.entities);
const serializedRelationships = JSON.stringify(model.relationships);
const serializedCells = JSON.stringify(sceneCells);
---

<div
  class:list={["topology-scene", className]}
  data-grid-activity-origin-q={originQ}
  data-grid-activity-origin-r={originR}
  data-grid-activity-radius={5}
  data-grid-activity={gridActivity ? "true" : "false"}
  data-ambient-signals={ambientSignals ? "true" : "false"}
  data-scene-layout={layout}
  data-topology-layout={topologyLayout}
  data-viewport-fit={viewportFit ? "true" : "false"}
  data-show-grid-nodes={showGridNodes ? "true" : "false"}
  data-grid-ready="true"
  data-signal-transition-speed={signalTransitionSpeed}
  data-connector-routing={connectorRouting}
>
  <script type="application/json" class="topology-scene__nodes" set:html={serializedNodes}></script>
  <script type="application/json" class="topology-scene__relationships" set:html={serializedRelationships}></script>
  <script type="application/json" class="topology-scene__cells" set:html={serializedCells}></script>
  <div class="scene-grid">
    <TopologyGrid
      occupiedNodes={model.entities}
      relationships={model.relationships}
      cells={sceneCells}
      gridActivityCells={gridActivityCells}
      radius={model.radius}
      showNodes={showGridNodes}
      connectorRouting={connectorRouting}
    />
  </div>

</div>

<style>
  .topology-scene {
    position: relative;
    width: 100%;
    height: 100%;
    min-height: 0;
    display: grid;
    place-items: center;
    overflow: hidden;
  }

  .topology-scene:focus {
    outline: none;
  }

  .topology-scene:focus-visible {
    box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--theme-focus) 34%, transparent);
  }

  .scene-grid {
    position: absolute;
    inset: 0;
    z-index: 0;
    opacity: 0.68;
    color: color-mix(in srgb, var(--theme-grid-active) 10%, transparent);
    pointer-events: none;
    transition: opacity 180ms ease;
    mask-image: none;
    clip-path: none;
  }

  .topology-scene[data-grid-ready="false"] .scene-grid {
    opacity: 0;
    pointer-events: none;
  }

  .topology-scene[data-grid-ready="true"] .scene-grid {
    opacity: 0.64;
    pointer-events: auto;
  }

  .topology-scene.lab-topology-scene[data-grid-ready="true"] .scene-grid {
    opacity: 0.78;
  }

</style>

<script>
  import { hexLine } from "../../topology/hex";
  import { createViewportFitHexGrid } from "../../topology/viewportGrid";
  import { selectGridActivityCell } from "../../topology/gridAnimations";
  import { getCrossfadeWeights } from "../../topology/motion";
  import { buildSignalCellStates, createBroadcastSignal, createPathSignal, createReceivingSignal } from "../../topology/signal";
  import { collectSignalEvents, createDefaultSignalPolicy } from "../../topology/SignalPolicy";
  import { SignalCoordinator } from "../../topology/SignalCoordinator";
  import { createSignalRoute } from "../../topology/SignalRouting";
  import {
    ensureDeveloperSceneId,
    registerDeveloperScene,
  } from "../../topology/DeveloperRegistry";
  import { prepareTopologyRenderFrame } from "../../topology/renderPipeline";
  import { renderTopologyGridMarkup } from "../../topology/TopologyGridRenderer";

  const scenes = document.querySelectorAll(".topology-scene");

  for (const scene of scenes) {
    const originQ = Number(scene.getAttribute("data-grid-activity-origin-q") ?? 0);
    const originR = Number(scene.getAttribute("data-grid-activity-origin-r") ?? 0);
    const maxRadius = Number(scene.getAttribute("data-grid-activity-radius") ?? 6);
    const sceneLayout = scene.getAttribute("data-scene-layout") ?? "viewport-fit";
    const viewportFit = sceneLayout !== "world-grid" && scene.getAttribute("data-viewport-fit") !== "false";
    const gridHost = scene.querySelector(".scene-grid");
    const nodesPayload = scene.querySelector(".topology-scene__nodes");
    const cellsPayload = scene.querySelector(".topology-scene__cells");
    const gridActivity = scene.getAttribute("data-grid-activity") !== "false";
    const ambientSignals = scene.getAttribute("data-ambient-signals") !== "false";
    const connectorRouting = scene.getAttribute("data-connector-routing") ?? "straight";
    const signalTransitionSpeedValue = Number(scene.getAttribute("data-signal-transition-speed") ?? TOPOLOGY_SIGNAL_BASE.transitionSpeed);

    let gridActivityCurrentId = "";
    let gridActivityPreviousId = "";
    let gridActivityChangedAt = 0;
    let gridActivityNextAt = 0;
    let gridActivityInterval;
    let resizeObserver;
    let resizeRaf = 0;
    let lastWidth = 0;
    let lastHeight = 0;
    const radius = Number(scene.querySelector(".topology-grid")?.getAttribute("data-radius") ?? 40);
    let occupiedNodes = nodesPayload ? JSON.parse(nodesPayload.textContent || "[]") : [];
    const serializedCells = cellsPayload ? JSON.parse(cellsPayload.textContent || "[]") : [];
    const relationshipsPayload = scene.querySelector(".topology-scene__relationships");
    let relationships = relationshipsPayload ? JSON.parse(relationshipsPayload.textContent || "[]") : [];
    let nodeMap = new Map(occupiedNodes.map((node) => [node.id, node]));
    let activeNodeId = occupiedNodes.find((node) => node.selected || node.active)?.id ?? null;
    const hasLabSelector = Boolean(document.querySelector("[data-lab-selector]"));

    let currentCells = serializedCells;
    let cellElements = new Map();
    let currentSignals = [];
    let currentSignalStates = {};
    let signalMode = ambientSignals ? "ambient" : "idle";
    let signalEndAt = 0;
    let signalRaf = 0;
    const signalPolicy = createDefaultSignalPolicy({ transitionSpeed: signalTransitionSpeedValue });
    const defaultEnabledSignalTypes = ambientSignals ? ["ambient", "origin", "path", "broadcast"] : ["origin", "path", "broadcast"];
    const enabledSignalTypes = new Set(defaultEnabledSignalTypes);
    let selectedOriginId = null;
    let suppressNextFocusIntent = false;
    let currentRelationshipContext = null;

    function indexCellElements() {
      const nextElements = new Map();
      const grid = gridHost?.querySelector(".topology-grid");

      if (!grid) {
        return nextElements;
      }

      grid.querySelectorAll("[data-cell-id]").forEach((element) => {
        const id = element.getAttribute("data-cell-id");
        if (!id) return;

        const group = nextElements.get(id) ?? [];
        group.push(element);
        nextElements.set(id, group);
      });

      return nextElements;
    }

    function applySignalStateMap(stateMap) {
      currentSignalStates = stateMap;
      for (const [id, elements] of cellElements.entries()) {
        const state = stateMap[id] ?? { state: "idle", intensity: 0.12 };

        for (const element of elements) {
          element.classList.toggle("is-origin", state.state === "origin");
          element.classList.toggle("is-propagating", state.state === "propagating");
          element.classList.toggle("is-receiving", state.state === "receiving");
          element.classList.toggle("is-resolved", state.state === "resolved");
          element.dataset.cellSignalState = state.state;
          element.dataset.cellSignalType = state.type ?? "";
          element.style.setProperty("--cell-intensity", String(state.intensity));
        }
      }
    }

    function renderSignalFrame(now = performance.now()) {
      if (!currentSignals.length || !currentCells.length) return;

      const stateMap = buildSignalCellStates({
        cells: currentCells,
        signals: currentSignals,
        now,
      });

      applySignalStateMap(stateMap);

      if (now < signalEndAt && !media.matches) {
        signalRaf = window.requestAnimationFrame(renderSignalFrame);
        return;
      }

      signalRaf = 0;

      if (signalMode === "ambient") {
        setAmbientSignals();
      }
    }

    function startSignalLoop() {
      window.cancelAnimationFrame(signalRaf);
      signalRaf = window.requestAnimationFrame(renderSignalFrame);
    }

    function filterEnabledSignals(nextSignals) {
      return nextSignals.filter((signal) => enabledSignalTypes.has(signal.type));
    }

    function clearSignalStates() {
      currentSignals = [];
      signalMode = ambientSignals ? "ambient" : "idle";
      signalEndAt = 0;
      window.cancelAnimationFrame(signalRaf);
      signalRaf = 0;
      applySignalStateMap({});
    }

    function applySignalPreferences(nextEnabledTypes = defaultEnabledSignalTypes) {
      enabledSignalTypes.clear();
      for (const type of nextEnabledTypes) {
        if (defaultEnabledSignalTypes.includes(type)) {
          enabledSignalTypes.add(type);
        }
      }

      const filteredSignals = filterEnabledSignals(currentSignals);

      if (!filteredSignals.length) {
        setAmbientSignals();
        return;
      }

      setSignals(filteredSignals, signalMode, false);
    }

    function setSignals(nextSignals, mode, fallbackAmbient = true) {
      currentSignals = filterEnabledSignals(nextSignals.filter(Boolean));
      signalMode = mode;
      signalEndAt = Math.max(...currentSignals.map((signal) => signal.startedAt + signal.duration), 0);

      if (!currentSignals.length) {
        clearSignalStates();
        return;
      }

      startSignalLoop();

      if (ambientSignals && fallbackAmbient && signalMode !== "ambient") {
        window.setTimeout(() => {
          if (signalMode !== mode) return;
          setAmbientSignals();
        }, Math.max(400, signalEndAt - performance.now()));
      }
    }

    function setAmbientSignals() {
      if (!ambientSignals || !enabledSignalTypes.has("ambient")) {
        clearSignalStates();
        return;
      }

      const now = performance.now();
      const ambientEvents = signalPolicy.onSceneLoad({
        now,
        origin: { q: originQ, r: originR },
        radius: Math.max(5, maxRadius),
        maxRadius: Math.max(5, maxRadius),
      });
      const ambientSignalsNext = collectSignalEvents(ambientEvents).filter((signal) => enabledSignalTypes.has(signal.type));

      if (!ambientSignalsNext.length) {
        clearSignalStates();
        return;
      }

      currentSignals = ambientSignalsNext;
      signalMode = "ambient";
      signalEndAt = Math.max(...ambientSignalsNext.map((signal) => signal.startedAt + signal.duration), 0);
      startSignalLoop();
    }

    function emitNodeSelection(nextActiveId, cause = "selection") {
      scene.dispatchEvent(new CustomEvent("topology-node-selected", {
        detail: {
          nodeId: nextActiveId,
          cause,
          previousId: activeNodeId,
          sourceId: selectedOriginId,
        },
      }));
    }

    function syncNodeFocusState(nextActiveId, cause = "selection") {
      const previousActiveId = activeNodeId;
      activeNodeId = nextActiveId;
      selectedOriginId = nextActiveId;

      scene.querySelectorAll(".grid-occupant").forEach((node) => {
        const isSelected = node.dataset.nodeId === nextActiveId;
        node.classList.toggle("is-selected", isSelected);
        node.dataset.nodeState = isSelected ? "selected" : "idle";
        node.setAttribute("aria-current", isSelected ? "true" : "false");
      });

      if (previousActiveId !== nextActiveId) {
        emitNodeSelection(nextActiveId, cause);
      }
    }

    function applyRelationshipContext(context = currentRelationshipContext) {
      if (!context) return;
      currentRelationshipContext = context;
      const relatedIds = new Set(context.relatedIds ?? []);
      const ancestorIds = new Set(context.ancestorIds ?? []);
      const descendantIds = new Set(context.descendantIds ?? []);

      scene.querySelectorAll(".grid-occupant").forEach((node) => {
        const entityId = node.dataset.nodeId ?? "";
        const state = ancestorIds.has(entityId)
          ? "ancestor"
          : descendantIds.has(entityId)
            ? "descendant"
            : relatedIds.has(entityId)
              ? "related"
              : "idle";
        const isSelected = entityId === context.focusedId;

        node.classList.toggle("is-ancestor", state === "ancestor");
        node.classList.toggle("is-descendant", state === "descendant");
        node.classList.toggle("is-related", state === "related");
        node.dataset.relationshipState = state;
        if (!isSelected) node.dataset.nodeState = state;

        const baseLabel = node.dataset.baseAriaLabel ?? node.getAttribute("aria-label") ?? entityId;
        node.dataset.baseAriaLabel = baseLabel;
        const relationshipLabel = state === "ancestor"
          ? "Ancestor of the selected entity."
          : state === "descendant"
            ? "Descendant of the selected entity."
            : state === "related"
              ? "Related to the selected entity."
              : "";
        node.setAttribute("aria-label", relationshipLabel ? baseLabel + ". " + relationshipLabel : baseLabel);
      });

      scene.querySelectorAll(".grid-connector").forEach((connector) => {
        const from = connector.getAttribute("data-edge-from") ?? "";
        const to = connector.getAttribute("data-edge-to") ?? "";
        const edge = (context.edges ?? []).find((candidate) => candidate.from === from && candidate.to === to);
        const state = edge?.state ?? "idle";

        connector.classList.toggle("relationship-context-ancestor", state === "ancestor");
        connector.classList.toggle("relationship-context-descendant", state === "descendant");
        connector.classList.toggle("relationship-context-related", state === "related");
        connector.dataset.relationshipState = state;
      });

      scene.dataset.relationshipFocusId = context.focusedId ?? "";
    }

    function buildNavigationPhasePayload(context) {
      const source = context.source ?? null;
      const destination = context.destination;
      const scale = Math.max(0.25, context.transitionSpeed ?? 1.35);
      const now = performance.now();
      const sourceId = context.transaction.sourceId;
      const destinationId = context.transaction.destinationId;
      const sameSource = Boolean(sourceId && sourceId === destinationId);
      const route = context.route.length > 1 ? context.route : (source ? hexLine(source, destination) : []);
      const hold = (ms) => (context.reducedMotion ? 0 : Math.max(0, ms));

      if (context.phase === "path") {
        if (!source || !sourceId || sameSource || route.length < 2) {
          return { signals: [], holdMs: hold(Math.round(120 / scale)) };
        }

        const pathSignal = createPathSignal(route, {
          startedAt: now,
          duration: Math.round(1120 / scale),
          intensity: 0.96,
        });

        return pathSignal
          ? { signals: [pathSignal], holdMs: hold(pathSignal.duration) }
          : { signals: [], holdMs: hold(Math.round(120 / scale)) };
      }

      if (context.phase === "receiving") {
        const receivingSignal = createReceivingSignal(destination, {
          startedAt: now,
          duration: Math.round(260 / scale),
          intensity: 1,
        });

        return { signals: [receivingSignal], holdMs: hold(receivingSignal.duration) };
      }

      if (context.phase === "broadcast") {
        const broadcastSignal = createBroadcastSignal(destination, {
          startedAt: now,
          duration: Math.round(760 / scale),
          intensity: 0.9,
          radius: Math.max(6, maxRadius + 2),
        });

        return { signals: [broadcastSignal], holdMs: hold(broadcastSignal.duration) };
      }

      return { signals: [], holdMs: 0 };
    }

    function applyNavigationPhase(detail) {
      const nextSignals = detail.signals.filter(Boolean);
      setSignals(nextSignals, detail.phase, false);
    }

    function startNavigationTransaction(sourceId, nextId) {
      const destinationNode = nodeMap.get(nextId);
      if (!destinationNode) return;

      const sourceNode = sourceId ? nodeMap.get(sourceId) : null;
      const source = sourceNode ? { q: sourceNode.q, r: sourceNode.r } : null;
      const destination = { q: destinationNode.q, r: destinationNode.r };
      const route = source ? resolveSceneSignalRoute(source, destination) : [];

      navigationCoordinator.navigate(
        sourceId,
        nextId,
        source,
        destination,
        buildNavigationPhasePayload,
        route,
      );
    }

    function handleNodeIntent(nextId, cause = "select") {
      if (!nextId) return;
      if (!nodeMap.has(nextId)) return;

      const previousActiveId = activeNodeId;
      const currentSourceId = selectedOriginId && nodeMap.has(selectedOriginId) ? selectedOriginId : null;

      if (cause === "focus") {
        if (navigationCoordinator.isForegroundActive()) return;
        emitNodeSignalById(nextId, "focus", previousActiveId);
        return;
      }

      const selectionCause = cause === "keyboard" ? "keyboard" : "selection";

      if (!currentSourceId) {
        syncNodeFocusState(nextId, selectionCause);
        emitNodeSignalById(nextId, "select", previousActiveId);
        return;
      }

      if (currentSourceId !== nextId) {
        startNavigationTransaction(currentSourceId, nextId);
        return;
      }

      syncNodeFocusState(nextId, selectionCause);
      emitNodeSignalById(nextId, "select", previousActiveId);
    }

    function relatedTargetsFor(nodeId) {
      return relationships
        .filter((relationship) => relationship.from === nodeId || relationship.to === nodeId)
        .map((relationship) => {
          const targetId = relationship.from === nodeId ? relationship.to : relationship.from;
          return nodeMap.get(targetId);
        })
        .filter(Boolean);
    }

    function resolveSceneSignalRoute(from, to) {
      return createSignalRoute({
        mode: connectorRouting,
        cells: currentCells,
        occupants: occupiedNodes,
        from,
        to,
        radius,
      });
    }

    function emitNodeSignalById(nodeId, kind = "hover", fromId = activeNodeId) {
      const node = nodeMap.get(nodeId);
      if (!node) return;

      const now = performance.now();
      const origin = { q: node.q, r: node.r };
      const previousNode = fromId ? nodeMap.get(fromId) : null;
      const relatedNodes = relatedTargetsFor(nodeId);
      const context = {
        now,
        origin,
        current: origin,
        previous: previousNode ? { q: previousNode.q, r: previousNode.r } : null,
        related: relatedNodes,
        radius: Math.max(5, maxRadius),
        maxRadius: Math.max(5, maxRadius),
        resolveRoute: resolveSceneSignalRoute,
      };

      const interactionKind = kind === "broadcast" ? "focus" : kind;
      let signalEvents = [];

      if (interactionKind === "focus") {
        signalEvents = signalPolicy.onFocus(context);
      } else if (interactionKind === "select") {
        signalEvents = signalPolicy.onSelect(context);
      } else if (interactionKind === "navigate") {
        signalEvents = signalPolicy.onNavigate(context);
      } else if (interactionKind === "reveal-relationships") {
        signalEvents = signalPolicy.onRevealRelationships(context);
      } else {
        signalEvents = signalPolicy.onHover(context);
      }

      const cleanedSignals = collectSignalEvents(signalEvents).filter((signal) => enabledSignalTypes.has(signal.type));
      if (!cleanedSignals.length) return;

      const mode = signalEvents[0]?.kind ?? "ambient";
      setSignals(cleanedSignals, mode);
      scene.dispatchEvent(new CustomEvent("topology-signal", {
        detail: {
          kind,
          interactionKind,
          nodeId,
          fromId,
          signals: cleanedSignals,
          signalKinds: cleanedSignals.map((signal) => signal.type),
          events: signalEvents,
        },
      }));
    }

    function renderGridActivity(now = performance.now()) {
      const grid = scene.querySelector(".topology-grid");
      if (!grid || !currentCells.length) return;

      const currentCell = currentCells.find((cell) => cell.id === gridActivityCurrentId) ?? null;
      if (!currentCell || now >= gridActivityNextAt) {
        const nextCell = selectGridActivityCell({
          cells: currentCells,
          occupied: occupiedNodes,
          previous: currentCell,
          fallback: currentCells[0] ?? null,
          minDistance: Math.max(5, Math.round(maxRadius * 0.65)),
        });

        gridActivityPreviousId = currentCell?.id ?? "";
        gridActivityCurrentId = nextCell?.id ?? "";
        gridActivityChangedAt = now;
        gridActivityNextAt = now + 2200;
      }

      const fadeProgress = Math.min(1, Math.max(0, (now - gridActivityChangedAt) / 900));
      const weights = getCrossfadeWeights(fadeProgress);
      grid.querySelectorAll(".grid-hex").forEach((hex) => {
        const id = hex.getAttribute("data-cell-id") ?? "";
        const isCurrent = id === gridActivityCurrentId;
        const isPrevious = weights.outgoing > 0.015
          && id === gridActivityPreviousId
          && id !== gridActivityCurrentId;

        hex.classList.remove("is-active");
        hex.classList.toggle("is-grid-activity", isCurrent);
        hex.classList.toggle("is-grid-activity-trail", isPrevious);

        if (isCurrent) {
          hex.style.setProperty("--grid-activity-intensity", String(weights.incoming));
        } else if (isPrevious) {
          hex.style.setProperty("--grid-activity-intensity", String(weights.outgoing));
        } else {
          hex.style.removeProperty("--grid-activity-intensity");
        }
      });
    }

    function attachOccupantInteractions() {
      scene.querySelectorAll(".grid-occupant").forEach((node) => {
        if (node.getAttribute("data-bound") === "true") return;
        if (node.classList.contains("is-disabled") || node.getAttribute("aria-disabled") === "true") return;

        node.setAttribute("data-bound", "true");

        node.addEventListener("pointerdown", () => {
          suppressNextFocusIntent = true;
        });

        node.addEventListener("pointerenter", () => {
          emitNodeSignalById(node.dataset.nodeId ?? "", "hover");
        });

        node.addEventListener("focusin", () => {
          if (suppressNextFocusIntent) {
            suppressNextFocusIntent = false;
            return;
          }

          if (navigationCoordinator.isForegroundActive()) return;

          handleNodeIntent(node.dataset.nodeId ?? "", "focus");
        });

        node.addEventListener("click", () => {
          suppressNextFocusIntent = false;
          handleNodeIntent(node.dataset.nodeId ?? "", "select");
        });

        node.addEventListener("keydown", (event) => {
          if (event.key !== "Enter" && event.key !== " ") return;
          event.preventDefault();
          suppressNextFocusIntent = false;
          handleNodeIntent(node.dataset.nodeId ?? "", "keyboard");
        });
      });
    }

    function rebuildViewportGrid() {
      if (!viewportFit || !gridHost) {
        cellElements = indexCellElements();
        attachOccupantInteractions();
        applyRelationshipContext();
        if (gridActivity) {
          renderGridActivity();
        }
        if (!currentSignals.length) {
          setAmbientSignals();
        } else {
          renderSignalFrame();
        }
        return;
      }

      const rect = gridHost.getBoundingClientRect();
      const width = Math.max(1, Math.round(rect.width));
      const height = Math.max(1, Math.round(rect.height));

      if (width === lastWidth && height === lastHeight) {
        return;
      }

      lastWidth = width;
      lastHeight = height;

      const cells = createViewportFitHexGrid({
        radius,
        width,
        height,
      });

      const relationshipsPayload = scene.querySelector(".topology-scene__relationships");
      const relationships = relationshipsPayload ? JSON.parse(relationshipsPayload.textContent || "[]") : [];

      currentCells = cells;
      const renderFrame = prepareTopologyRenderFrame({
        cells,
        occupants: occupiedNodes,
        relationships,
        relationshipContext: currentRelationshipContext,
        selectedId: activeNodeId,
      });
      gridHost.innerHTML = renderTopologyGridMarkup({
        frame: renderFrame,
        radius,
        activeCellIds: [],
        showNodes: scene.getAttribute("data-show-grid-nodes") !== "false",
        connectorRouting,
      });
      cellElements = indexCellElements();
      attachOccupantInteractions();
      applyRelationshipContext();
      if (gridActivity) {
        renderGridActivity();
      }
      if (!currentSignals.length) {
        setAmbientSignals();
      } else {
        renderSignalFrame();
      }
    }

    function scheduleRebuild() {
      window.cancelAnimationFrame(resizeRaf);
      resizeRaf = window.requestAnimationFrame(rebuildViewportGrid);
    }

    const media = window.matchMedia("(prefers-reduced-motion: reduce)");

    const navigationCoordinator = new SignalCoordinator({
      transitionSpeed: signalTransitionSpeedValue,
      reducedMotion: media.matches,
      onPhase(detail) {
        applyNavigationPhase(detail);
        scene.dispatchEvent(new CustomEvent("topology-navigation-state", {
          detail: {
            phase: detail.phase,
            transaction: detail.transaction,
            sourceId: detail.transaction.sourceId,
            destinationId: detail.transaction.destinationId,
          },
        }));
      },
      onComplete(transaction) {
        syncNodeFocusState(transaction.destinationId, "navigation");
        scene.dispatchEvent(new CustomEvent("topology-navigation-complete", {
          detail: {
            transaction,
            sourceId: transaction.sourceId,
            destinationId: transaction.destinationId,
          },
        }));
        setAmbientSignals();
      },
      onCancel(transaction) {
        scene.dispatchEvent(new CustomEvent("topology-navigation-cancel", {
          detail: {
            transaction,
            sourceId: transaction.sourceId,
            destinationId: transaction.destinationId,
          },
        }));
        setAmbientSignals();
      },
    });

    scene.addEventListener("topology-dataset-updated", (event) => {
      const detail = event.detail ?? {};
      if (!Array.isArray(detail.nodes)) return;
      occupiedNodes = detail.nodes;
      relationships = Array.isArray(detail.relationships) ? detail.relationships : [];
      nodeMap = new Map(occupiedNodes.map((node) => [node.id, node]));
      activeNodeId = detail.selectedId ?? occupiedNodes.find((node) => node.selected || node.active)?.id ?? null;
      selectedOriginId = null;
      currentRelationshipContext = null;
      attachOccupantInteractions();
      applyRelationshipContext();
    });

    scene.addEventListener("topology-relationship-context", (event) => {
      applyRelationshipContext(event.detail);
    });

    scene.addEventListener("topology-signal-settings", (event) => {
      const detail = event.detail ?? {};
      const enabledTypes = Array.isArray(detail.enabledTypes) ? detail.enabledTypes : defaultEnabledSignalTypes;
      applySignalPreferences(enabledTypes);
    });

    scene.addEventListener("topology-navigate", (event) => {
      const detail = event.detail ?? {};
      const nextId = detail.toId ?? detail.nodeId;
      if (!nextId) return;
      handleNodeIntent(nextId, detail.kind === "focus" ? "focus" : "select");
    });

    if (import.meta.env.DEV) {
      const sceneId = ensureDeveloperSceneId(scene);
      const unregisterDeveloperScene = registerDeveloperScene({
        id: sceneId,
        entities: () => occupiedNodes.map((node) => ({ ...node })),
        relationships: () => relationships.map((relationship) => ({ ...relationship })),
        cells: () => currentCells.map((cell) => ({ ...cell, center: { ...cell.center } })),
        frame: () => prepareTopologyRenderFrame({
          cells: currentCells,
          occupants: occupiedNodes,
          relationships,
          signals: currentSignals,
          signalStates: currentSignalStates,
          relationshipContext: currentRelationshipContext,
          selectedId: activeNodeId,
          generatedAt: performance.now(),
        }),
        selected: () => activeNodeId,
        inspect(entityId) {
          scene.dispatchEvent(new CustomEvent("topology-navigate", {
            detail: { fromId: activeNodeId, toId: entityId, kind: "select" },
          }));
        },
        highlight(q, r) {
          const cellId = `hex-${q}-${r}`;
          const elements = scene.querySelectorAll(`[data-cell-id="${cellId}"]`);
          elements.forEach((element) => element.classList.add("is-debug-highlight"));
          return elements.length > 0;
        },
        clearHighlights() {
          scene.querySelectorAll(".is-debug-highlight").forEach((element) => {
            element.classList.remove("is-debug-highlight");
          });
        },
        broadcast(entityId) {
          if (!nodeMap.has(entityId)) return false;
          emitNodeSignalById(entityId, "broadcast");
          return true;
        },
        path(fromId, toId) {
          const from = nodeMap.get(fromId);
          const to = nodeMap.get(toId);
          if (!from || !to) return false;
          const signal = createPathSignal(resolveSceneSignalRoute(from, to), {
            startedAt: performance.now(),
            duration: Math.round(1120 / Math.max(0.25, signalTransitionSpeedValue)),
            intensity: 0.96,
          });
          if (!signal) return false;
          setSignals([signal], "path", false);
          return true;
        },
        stopSignals: clearSignalStates,
      });
      window.addEventListener("beforeunload", unregisterDeveloperScene, { once: true });
    }

    rebuildViewportGrid();
    scene.setAttribute("data-grid-ready", "true");

    if ("ResizeObserver" in window) {
      resizeObserver = new ResizeObserver(() => {
        scheduleRebuild();
      });
      resizeObserver.observe(scene);
    } else {
      window.addEventListener("resize", scheduleRebuild);
    }

    if (gridActivity && !media.matches) {
      renderGridActivity();
      gridActivityInterval = window.setInterval(renderGridActivity, 160);
    }

    attachOccupantInteractions();

    scene.addEventListener("pointerleave", () => {
      if (!navigationCoordinator.isForegroundActive() && ambientSignals) {
        setAmbientSignals();
      }
    });

    scene.addEventListener("focusout", () => {
      if (!navigationCoordinator.isForegroundActive() && ambientSignals) {
        setAmbientSignals();
      }
    });

    window.addEventListener("pagehide", () => {
      window.clearInterval(gridActivityInterval);
      window.cancelAnimationFrame(signalRaf);
      window.cancelAnimationFrame(resizeRaf);
      resizeObserver?.disconnect();
      window.removeEventListener("resize", scheduleRebuild);
    }, { once: true });
  }
</script>
