---
import { createHexGrid } from "../../topology/hex";
import type { HexCell } from "../../framework/index.ts";
import type { ConnectorRoutingMode } from "../../topology/connectorRouting.ts";
import type { GridCellAnimationState } from "../../topology/gridAnimations";
import {
  prepareTopologyRenderFrame,
  type TopologyRenderOccupant,
  type TopologyRenderRelationship,
} from "../../topology/renderPipeline";
import { renderTopologyGridMarkup } from "../../topology/TopologyGridRenderer";

interface Props {
  cells?: HexCell[];
  occupiedNodes?: TopologyRenderOccupant[];
  gridActivityCells?: string[];
  activeCells?: string[];
  cellStates?: Record<string, GridCellAnimationState>;
  relationships?: TopologyRenderRelationship[];
  radius?: number;
  columns?: number;
  rows?: number;
  originQ?: number;
  originR?: number;
  showNodes?: boolean;
  class?: string;
  connectorRouting?: ConnectorRoutingMode;
}

const {
  radius = 22,
  columns = 40,
  rows = 30,
  originQ = -20,
  originR = -15,
  showNodes = true,
  class: className = "",
  gridActivityCells = [],
  activeCells = [],
  cellStates = {},
  relationships = [],
  occupiedNodes = [],
  connectorRouting = "straight",
} = Astro.props;

const generatedCells = createHexGrid({
  radius,
  columns,
  rows,
  originQ,
  originR,
});

const inputCells = Astro.props.cells ?? generatedCells;
const renderFrame = prepareTopologyRenderFrame({
  cells: inputCells,
  occupants: occupiedNodes,
  relationships,
});
const gridMarkup = renderTopologyGridMarkup({
  frame: renderFrame,
  radius,
  activeCellIds: gridActivityCells.length ? gridActivityCells : activeCells,
  cellStates,
  showNodes,
  className,
  connectorRouting,
});
---

<Fragment set:html={gridMarkup} />

<style>
  :global(.topology-grid) {
    width: 100%;
    height: 100%;
    display: block;
    overflow: visible;
    color: var(--scene-grid, rgba(190, 184, 169, 0.16));
    pointer-events: auto;
  }

  :global(.grid-lines),
  :global(.grid-nodes),
  :global(.grid-connectors) {
    pointer-events: none;
  }

  :global(.topology-scene[data-scene-layout="world-grid"] .grid-hex.is-origin),
  :global(.topology-scene[data-scene-layout="world-grid"] .grid-hex.is-propagating),
  :global(.topology-scene[data-scene-layout="world-grid"] .grid-hex.is-receiving) {
    opacity: calc(1 * var(--cell-edge-factor, 1));
  }

  :global(.grid-hex) {
    fill: none;
    stroke: currentColor;
    stroke-width: 1;
    stroke-linecap: round;
    stroke-linejoin: round;
    vector-effect: non-scaling-stroke;
    opacity: calc(var(--grid-line-opacity, 0.34) * var(--cell-intensity, 1) * var(--cell-edge-factor, 1));
  }

  :global([data-cell-id].is-debug-highlight) {
    stroke: var(--theme-focus);
    stroke-width: 2.2;
    opacity: 1;
    filter: drop-shadow(0 0 7px color-mix(in srgb, var(--theme-focus) 45%, transparent));
  }

  :global(.topology-scene[data-scene-layout="world-grid"] .grid-hex[data-cell-state="idle"]:not(.is-origin):not(.is-propagating):not(.is-receiving):not(.is-resolved)) {
    fill: var(--scene-cell, rgba(255, 250, 238, 0.012));
    stroke: var(--scene-grid, rgba(190, 184, 169, 0.16));
    opacity: calc(0.38 * var(--cell-edge-factor, 1));
  }

  :global(.topology-scene[data-scene-layout="world-grid"] .grid-hex[data-cell-state="idle"].is-tile-alt:not(.is-origin):not(.is-propagating):not(.is-receiving):not(.is-resolved)) {
    fill: var(--scene-cell-alt, rgba(216, 160, 55, 0.026));
    stroke: var(--scene-grid-strong, rgba(224, 193, 132, 0.17));
    opacity: calc(0.42 * var(--cell-edge-factor, 1));
  }

  :global(.topology-scene[data-scene-layout="world-grid"] .grid-hex[data-cell-state="idle"]:not(.is-hover):not(.is-origin):not(.is-propagating):not(.is-receiving):not(.is-resolved)) {
    transition: fill 180ms ease, stroke 180ms ease, opacity 180ms ease;
  }

  :global(.grid-connectors) {
    color: var(--scene-connector, rgba(194, 199, 201, 0.44));
  }

  :global(.lab-topology-scene .grid-connectors) {
    color: rgba(191, 211, 231, 0.34);
  }

  :global(.grid-connector) {
    fill: none;
    stroke: currentColor;
    vector-effect: non-scaling-stroke;
    stroke-linecap: round;
    stroke-linejoin: round;
    transition: stroke 180ms ease, stroke-width 180ms ease, stroke-opacity 180ms ease, opacity 180ms ease, filter 180ms ease;
  }

  :global(.grid-connector.connector-state-idle) {
    color: var(--scene-connector, rgba(194, 199, 201, 0.44));
    stroke-width: 1.15;
    stroke-opacity: 0.34;
    opacity: 0.86;
  }

  :global(.lab-topology-scene .grid-connector.connector-state-idle) {
    color: rgba(203, 213, 225, 0.18);
    stroke-width: 1.25;
    stroke-opacity: 0.2;
    opacity: 0.88;
  }

  :global(.grid-connector.connector-state-related) {
    color: color-mix(in srgb, var(--theme-related) 52%, var(--theme-connector));
    stroke-width: 1.6;
    stroke-opacity: 0.34;
    opacity: 0.95;
  }

  :global(.lab-topology-scene .grid-connector.connector-state-related) {
    color: color-mix(in srgb, var(--theme-related) 68%, var(--theme-connector));
    stroke-width: 2.2;
    stroke-opacity: 0.42;
    opacity: 0.98;
  }

  :global(.grid-connector.connector-state-active),
  :global(.grid-connector.is-active) {
    color: color-mix(in srgb, var(--accent-teal, #14b8a6) 90%, white 10%);
    stroke-width: 2.4;
    stroke-opacity: 0.95;
    opacity: 1;
    filter: drop-shadow(0 0 8px rgba(20, 184, 166, 0.3));
  }

  :global(.lab-topology-scene .grid-connector.connector-state-active),
  :global(.lab-topology-scene .grid-connector.is-active) {
    color: color-mix(in srgb, var(--accent-teal, #14b8a6) 78%, white 22%);
    stroke-width: 2.8;
    stroke-opacity: 1;
    filter: drop-shadow(0 0 10px rgba(20, 184, 166, 0.38));
  }

  :global(.grid-connector.connector-state-disabled),
  :global(.grid-connector.is-disabled) {
    color: rgba(191, 211, 231, 0.08);
    stroke-width: 1;
    stroke-opacity: 0.05;
    opacity: 0.36;
    filter: none;
    stroke-dasharray: 0.08 0.12;
  }

  :global(.grid-connector.connector-state-active) {
    animation: connector-flow 1.6s ease-in-out infinite;
  }

  :global(.grid-connector.relationship-context-related) {
    color: var(--theme-related);
    stroke-width: 1.5;
    stroke-opacity: 0.52;
    opacity: 0.86;
    filter: none;
  }

  :global(.grid-connector.relationship-context-ancestor) {
    color: var(--theme-ancestor);
    stroke-width: 2.2;
    stroke-opacity: 0.72;
    opacity: 0.96;
    filter: drop-shadow(0 0 5px color-mix(in srgb, var(--theme-ancestor) 28%, transparent));
  }

  :global(.grid-connector.relationship-context-descendant) {
    color: var(--theme-descendant);
    stroke-width: 2.15;
    stroke-opacity: 0.68;
    opacity: 0.94;
    filter: drop-shadow(0 0 5px color-mix(in srgb, var(--theme-descendant) 24%, transparent));
  }

  :global(.grid-hex-signal) {
    fill: none;
    stroke: color-mix(in srgb, var(--theme-signal-ambient) 38%, transparent);
    stroke-width: 1.6;
    opacity: 0;
    filter: drop-shadow(0 0 10px color-mix(in srgb, var(--theme-signal-ambient) 22%, transparent));
    vector-effect: non-scaling-stroke;
  }

  :global(.grid-hex-signal.is-active) {
    stroke: var(--theme-signal-ambient);
    opacity: calc(0.95 * var(--cell-edge-factor, 1));
    animation: grid-signal-pulse 1.8s ease-out infinite;
  }

  :global(.grid-hex-signal.is-trail) {
    stroke: color-mix(in srgb, var(--theme-signal-path) 62%, transparent);
    opacity: calc(0.72 * var(--cell-edge-factor, 1));
  }

  :global(.grid-hex-signal.is-converted) {
    stroke: color-mix(in srgb, var(--theme-status-danger) 76%, transparent);
    opacity: calc(0.7 * var(--cell-edge-factor, 1));
    animation: grid-signal-pulse 2.15s ease-out infinite;
  }

  :global(.grid-hex.is-active) {
    stroke: var(--theme-grid-active);
    stroke-width: 1.4;
    filter: drop-shadow(0 0 4px color-mix(in srgb, var(--theme-grid-active) 32%, transparent));
  }

  :global(.topology-scene[data-grid-activity="true"] .grid-hex.is-grid-activity:not(.is-origin):not(.is-propagating):not(.is-receiving):not(.is-resolved)),
  :global(.topology-scene[data-grid-activity="true"] .grid-hex.is-grid-activity-trail:not(.is-origin):not(.is-propagating):not(.is-receiving):not(.is-resolved)) {
    stroke: color-mix(in srgb, var(--theme-grid-active) 72%, white 28%);
    stroke-width: calc(1px + var(--grid-activity-intensity, 0) * 0.35px);
    fill: color-mix(in srgb, var(--theme-grid-active) 10%, transparent);
    opacity: calc((0.12 + var(--grid-activity-intensity, 0) * 0.7) * var(--cell-edge-factor, 1));
    filter: drop-shadow(0 0 6px color-mix(in srgb, var(--theme-grid-active) 28%, transparent));
    transition: fill 180ms linear, stroke 180ms linear, stroke-width 180ms linear, opacity 180ms linear, filter 180ms linear;
  }

  :global(.grid-hex.is-trail) {
    stroke: color-mix(in srgb, var(--theme-signal-path) 72%, var(--theme-signal-resolved));
  }

  :global(.grid-hex.is-converted) {
    stroke: currentColor;
    fill: color-mix(in srgb, var(--theme-status-danger) 42%, transparent);
  }

  :global(.animation-lab .grid-hex[data-cell-signal-type="diagonal-tone-sweep"]) {
    stroke: color-mix(in srgb, var(--scene-grid, rgba(190, 184, 169, 0.16)) 72%, transparent);
    stroke-width: 1;
    stroke-opacity: 0.22;
    fill: color-mix(in srgb, var(--theme-signal-path) 26%, transparent);
    fill-opacity: calc(0.12 + var(--cell-intensity, 0) * 0.58);
    opacity: calc((0.28 + var(--cell-intensity, 0) * 0.56) * var(--cell-edge-factor, 1));
    filter: drop-shadow(0 0 6px color-mix(in srgb, var(--theme-signal-path) 18%, transparent));
    transition: fill 180ms linear, stroke 180ms linear, stroke-width 180ms linear, stroke-opacity 180ms linear, opacity 180ms linear, filter 180ms linear;
  }

  :global(.animation-lab .grid-hex[data-cell-signal-type="diagonal-tone-sweep"].is-converted) {
    stroke: color-mix(in srgb, var(--scene-grid, rgba(190, 184, 169, 0.16)) 64%, transparent);
    stroke-opacity: 0.18;
    fill: color-mix(in srgb, var(--theme-signal-broadcast) 32%, transparent);
    fill-opacity: calc(0.18 + var(--cell-intensity, 0) * 0.68);
    opacity: calc((0.36 + var(--cell-intensity, 0) * 0.6) * var(--cell-edge-factor, 1));
    filter: drop-shadow(0 0 8px color-mix(in srgb, var(--theme-signal-broadcast) 24%, transparent));
  }

  :global(.grid-hex.is-hover),
  :global(.grid-node.is-hover) {
    stroke: var(--theme-hover);
    stroke-width: 1.42;
    fill: color-mix(in srgb, var(--theme-hover) 18%, transparent);
    filter: drop-shadow(0 0 8px color-mix(in srgb, var(--theme-hover) 24%, transparent));
    opacity: calc(0.96 * var(--cell-edge-factor, 1));
  }

  :global(.grid-hex.is-origin),
  :global(.grid-node.is-origin),
  :global(.grid-occupant.is-origin .grid-occupant-fill) {
    stroke: color-mix(in srgb, var(--theme-signal-origin) 72%, white 28%);
    stroke-width: 2.2;
    fill: color-mix(in srgb, var(--theme-signal-origin) 48%, transparent);
    opacity: calc(1 * var(--cell-edge-factor, 1));
    filter: drop-shadow(0 0 12px color-mix(in srgb, var(--theme-signal-origin) 62%, transparent));
  }

  :global(.grid-hex.is-propagating),
  :global(.grid-node.is-propagating),
  :global(.grid-occupant.is-propagating .grid-occupant-fill) {
    stroke: color-mix(in srgb, var(--theme-signal-path) 68%, white 32%);
    stroke-width: 2.15;
    fill: color-mix(in srgb, var(--theme-signal-path) 46%, transparent);
    opacity: calc(1 * var(--cell-edge-factor, 1));
    filter: drop-shadow(0 0 12px color-mix(in srgb, var(--theme-signal-path) 60%, transparent));
  }

  :global(.grid-hex.is-receiving),
  :global(.grid-node.is-receiving),
  :global(.grid-occupant.is-receiving .grid-occupant-fill) {
    stroke: color-mix(in srgb, var(--theme-signal-receiving) 68%, white 32%);
    stroke-width: 2.3;
    fill: color-mix(in srgb, var(--theme-signal-receiving) 52%, transparent);
    opacity: calc(1 * var(--cell-edge-factor, 1));
    filter: drop-shadow(0 0 13px color-mix(in srgb, var(--theme-signal-receiving) 66%, transparent));
  }

  :global(.grid-hex.is-resolved),
  :global(.grid-node.is-resolved),
  :global(.grid-occupant.is-resolved .grid-occupant-fill) {
    stroke: color-mix(in srgb, var(--theme-signal-resolved) 28%, transparent);
    fill: color-mix(in srgb, var(--theme-signal-resolved) 9%, transparent);
    opacity: 0.66;
  }

  :global(.grid-node) {
    fill: currentColor;
    opacity: calc(var(--grid-node-opacity, 0.16) * var(--cell-intensity, 1) * var(--cell-edge-factor, 1));
  }

  :global(.grid-node-signal) {
    fill: none;
    stroke: color-mix(in srgb, var(--theme-signal-ambient) 26%, transparent);
    stroke-width: 1.25;
    opacity: 0;
    filter: drop-shadow(0 0 10px color-mix(in srgb, var(--theme-signal-ambient) 24%, transparent));
    vector-effect: non-scaling-stroke;
  }

  :global(.grid-node-signal.is-active) {
    stroke: var(--theme-signal-ambient);
    opacity: calc(0.95 * var(--cell-edge-factor, 1));
    animation: node-signal-pulse 1.8s ease-out infinite;
  }

  :global(.grid-node-signal.is-trail) {
    stroke: color-mix(in srgb, var(--theme-signal-path) 52%, transparent);
    opacity: calc(0.7 * var(--cell-edge-factor, 1));
  }

  :global(.grid-node-signal.is-converted) {
    stroke: color-mix(in srgb, var(--theme-status-danger) 68%, transparent);
    opacity: calc(0.7 * var(--cell-edge-factor, 1));
    animation: node-signal-pulse 2.2s ease-out infinite;
  }

  :global(.grid-node.is-active) {
    fill: var(--theme-grid-active);
  }

  :global(.grid-node.is-trail) {
    fill: color-mix(in srgb, var(--theme-signal-path) 60%, var(--theme-signal-resolved));
  }

  :global(.grid-node.is-converted) {
    fill: color-mix(in srgb, var(--theme-status-danger) 44%, transparent);
  }

  :global([data-cell-signal-type="ambient"].is-propagating) {
    stroke: var(--theme-signal-ambient);
    stroke-width: 1;
    fill: color-mix(in srgb, var(--theme-signal-ambient) 14%, transparent);
    opacity: calc(0.32 * var(--cell-edge-factor, 1));
    filter: drop-shadow(0 0 5px color-mix(in srgb, var(--theme-signal-ambient) 18%, transparent));
  }

  :global([data-cell-signal-type="path"].is-origin),
  :global([data-cell-signal-type="path"].is-propagating) {
    stroke: color-mix(in srgb, var(--theme-signal-path) 68%, white 32%);
    stroke-width: 2.2;
    fill: color-mix(in srgb, var(--theme-signal-path) 48%, transparent);
    opacity: calc(1 * var(--cell-edge-factor, 1));
    filter: drop-shadow(0 0 12px color-mix(in srgb, var(--theme-signal-path) 62%, transparent));
  }

  :global([data-cell-signal-type="broadcast"].is-propagating) {
    stroke: color-mix(in srgb, var(--theme-signal-broadcast) 70%, white 30%);
    stroke-width: 2.2;
    fill: color-mix(in srgb, var(--theme-signal-broadcast) 46%, transparent);
    opacity: calc(1 * var(--cell-edge-factor, 1));
    filter: drop-shadow(0 0 13px color-mix(in srgb, var(--theme-signal-broadcast) 64%, transparent));
  }

  :global(.grid-occupant) {
    cursor: pointer;
    pointer-events: auto;
    color: var(--theme-occupant);
    opacity: calc(0.5 + var(--cell-edge-factor, 1) * 0.5);
  }

  :global(.grid-occupant:focus) {
    outline: none;
  }

  :global(.grid-occupant:focus-visible .grid-occupant-fill) {
    stroke: var(--theme-focus);
    stroke-width: 1.55;
    filter: drop-shadow(0 0 12px color-mix(in srgb, var(--theme-focus) 34%, transparent));
  }

  :global(.grid-occupant:focus-visible .grid-occupant-label),
  :global(.grid-occupant:focus-visible .grid-occupant-subtitle) {
    color: var(--theme-focus-text);
  }

  :global(.grid-occupant:hover .grid-occupant-fill) {
    stroke: color-mix(in srgb, var(--theme-hover) 72%, white 28%);
    stroke-width: 1.35;
    filter: drop-shadow(0 0 10px color-mix(in srgb, var(--theme-hover) 24%, transparent));
    transform: translateY(-0.5px);
  }

  :global(.grid-occupant:hover .grid-occupant-label),
  :global(.grid-occupant:hover .grid-occupant-subtitle) {
    color: var(--theme-hover-text);
  }

  :global(.grid-occupant-fill) {
    fill: var(--theme-occupant-fill);
    stroke: var(--theme-occupant-stroke);
    stroke-width: 1.35;
    vector-effect: non-scaling-stroke;
    transition: fill 180ms ease, stroke 180ms ease, opacity 180ms ease, filter 180ms ease, transform 180ms ease;
    opacity: calc(0.78 + var(--cell-edge-factor, 1) * 0.22);
  }

  :global(.grid-occupant-image) {
    pointer-events: none;
    opacity: 0.74;
    mix-blend-mode: normal;
    filter: brightness(0) invert(1) saturate(0) contrast(1.15);
    transition: opacity 180ms ease, filter 180ms ease;
  }

  :global(.grid-occupant.variant-root .grid-occupant-image) {
    opacity: 0.9;
  }

  :global(.grid-occupant:hover .grid-occupant-image),
  :global(.grid-occupant.is-selected .grid-occupant-image) {
    opacity: 1;
    filter: brightness(0) invert(1) saturate(0) contrast(1.25);
  }

  :global(.grid-occupant.variant-root .grid-occupant-fill) {
    fill: var(--theme-occupant-root-fill);
    stroke: var(--theme-root-stroke);
    filter: drop-shadow(0 0 10px color-mix(in srgb, var(--theme-selection) 16%, transparent));
  }

  :global(.grid-occupant.is-selected .grid-occupant-fill) {
    fill: var(--theme-state-selected-fill);
    stroke: var(--theme-focus);
    filter: drop-shadow(0 0 12px color-mix(in srgb, var(--theme-selection) 36%, transparent));
  }

  :global(.grid-occupant.is-selected) {
    transform: translateY(-1px);
  }

  :global(.grid-occupant.is-related) {
    color: var(--theme-state-related-text);
  }

  :global(.grid-occupant.is-related .grid-occupant-fill) {
    fill: var(--theme-state-related-fill);
    stroke: var(--theme-state-related-stroke);
    stroke-width: 1.35;
  }

  :global(.grid-occupant.is-ancestor) {
    color: var(--theme-state-ancestor-text);
  }

  :global(.grid-occupant.is-ancestor .grid-occupant-fill) {
    fill: var(--theme-state-ancestor-fill);
    stroke: var(--theme-state-ancestor-stroke);
    stroke-width: 1.7;
    filter: drop-shadow(0 0 10px color-mix(in srgb, var(--theme-ancestor) 26%, transparent));
  }

  :global(.grid-occupant.is-descendant) {
    color: var(--theme-state-descendant-text);
  }

  :global(.grid-occupant.is-descendant .grid-occupant-fill) {
    fill: var(--theme-state-descendant-fill);
    stroke: var(--theme-state-descendant-stroke);
    stroke-width: 1.55;
    filter: drop-shadow(0 0 9px color-mix(in srgb, var(--theme-descendant) 24%, transparent));
  }

  :global(.grid-occupant.is-disabled) {
    opacity: 0.42;
    pointer-events: none;
    cursor: default;
  }

  :global(.grid-occupant-label),
  :global(.grid-occupant-subtitle) {
    fill: currentColor;
    stroke: color-mix(in srgb, var(--theme-background) 76%, transparent);
    paint-order: stroke fill;
    text-anchor: middle;
    dominant-baseline: middle;
    pointer-events: none;
  }

  :global(.grid-occupant-label) {
    font-family: var(--font-title, "Space Grotesk", sans-serif);
    font-size: var(--occupant-title-size, 12px);
    font-weight: 750;
    stroke-width: 0.72px;
    letter-spacing: 0.02em;
  }

  :global(.grid-occupant.variant-root .grid-occupant-label) {
    font-size: calc(var(--occupant-title-size, 12px) * 1.08);
    font-weight: 800;
  }

  :global(.grid-occupant.is-selected .grid-occupant-label) {
    font-size: calc(var(--occupant-title-size, 12px) * 1.06);
    letter-spacing: 0.04em;
  }

  :global(.grid-occupant-subtitle) {
    font-family: var(--font-mono, monospace);
    font-size: var(--occupant-subtitle-size, 8px);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    opacity: calc(0.86 * var(--cell-edge-factor, 1));
    stroke-width: 0.48px;
  }

  :global(.grid-occupant.variant-root) {
    color: var(--theme-focus-text);
  }

  :global(.grid-occupant.variant-anchor) {
    color: var(--theme-selection);
  }

  :global(.grid-occupant.variant-node) {
    color: color-mix(in srgb, var(--theme-occupant) 94%, var(--theme-text-muted));
  }

  :global(.grid-occupant.variant-reference) {
    color: color-mix(in srgb, var(--theme-occupant) 78%, var(--theme-text-muted));
  }

  @keyframes grid-signal-pulse {
    0% {
      transform: scale(0.96);
      opacity: 0.32;
    }
    42% {
      opacity: 0.95;
    }
    100% {
      transform: scale(1.12);
      opacity: 0;
    }
  }

  @keyframes connector-flow {
    0%,
    100% {
      stroke-opacity: 0.42;
    }
    50% {
      stroke-opacity: 1;
    }
  }

  @keyframes node-signal-pulse {
    0% {
      transform: scale(0.88);
      opacity: 0.35;
    }
    35% {
      opacity: 0.95;
    }
    100% {
      transform: scale(1.2);
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    :global(.grid-connector),
    :global(.grid-hex-signal),
    :global(.grid-node-signal),
    :global(.grid-hex),
    :global(.grid-node),
    :global(.grid-occupant-fill),
    :global(.grid-occupant-image) {
      animation: none !important;
      transition-duration: 0.01ms !important;
    }
  }

</style>
